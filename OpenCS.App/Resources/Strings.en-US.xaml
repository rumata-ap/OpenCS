    <system:String x:Key="MosaicResultBarCrackLegendTitle">Bars: {0} (largest along the bar and over section rebars; SP 63 eq. (8.128) from analysis rebar strains)</system:String>
    <system:String x:Key="MosaicResultBarCrackSimplifiedLegendTitle">Bars: {0} (largest along the bar; no bar strains in the record — simplified check SP 63 cl. 8.2.15, 8.2.16 from forces, per bending plane)</system:String>
    <system:String x:Key="MosaicBarStiffnessMin">minimum along the bar</system:String>
