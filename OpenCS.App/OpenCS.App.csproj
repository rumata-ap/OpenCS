<Project Sdk="Microsoft.NET.Sdk">

  <!-- Логика приложения без WPF: проект и БД, задачи и исполнители, сервисы, настройки, строки, справочники.
       Общая для WPF-оболочки и консоли (Этап 0 дорожной карты API). -->
  <PropertyGroup>
    <TargetFramework>$(OpenCSTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OpenCS</RootNamespace>
  </PropertyGroup>

  <!-- Словари строк для Loc; WPF подключает те же файлы как Page (BAML для DynamicResource). -->
  <ItemGroup>
    <!-- WithCulture=false: иначе «ru-RU» в имени уводит ресурс в сателлитную сборку. -->
    <EmbeddedResource Include="Resources\Strings.*.xaml" LogicalName="OpenCS.%(Filename).xaml" WithCulture="false" />
  </ItemGroup>

  <!-- Справочники материалов и сортамент копируются в выход каждого потребителя. -->
  <ItemGroup>
    <Content Include="DataSource\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="netDxf" Version="2023.11.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CScore\CScore.csproj" />
    <ProjectReference Include="..\CScore.Fire\CScore.Fire.csproj" />
    <ProjectReference Include="..\CSfea.Torsion\CSfea.Torsion.csproj" />
    <ProjectReference Include="..\OpenCS.Gmsh\OpenCS.Gmsh.csproj" />
    <ProjectReference Include="..\OpenCS.OpenSees\OpenCS.OpenSees.csproj" />
    <ProjectReference Include="..\OpenCS.OpenSees.CScore\OpenCS.OpenSees.CScore.csproj" />
    <ProjectReference Include="..\OpenCS.Reporting\OpenCS.Reporting.csproj" />
  </ItemGroup>

</Project>
