<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(OpenCSTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Долгие сверки поверхностей (ширина раскрытия, ПС1/трещины против решателей) — ~16 из 19 мин полного
         прогона. По умолчанию dotnet test их пропускает; полный прогон: dotnet test CScore.Tests -p:VSTestTestCaseFilter=,
         только они: filter Category=Slow. Явный filter заменяет этот фильтр. -->
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">Category!=Slow</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CScore\CScore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Triangle.NET нужен в рантайме (CSTriangulation.PointDelaunay для полей из таблиц точек): Reference,
         объявленный только в CSTriangulation.csproj, копируется в bin/, но не попадает в .deps.json потребителя. -->
    <Reference Include="Triangle">
      <HintPath>..\CSTriangulation\libs\Triangle\Triangle.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\OpenCS.App\DataSource\Арматура стальная_*.csv"
          Link="DataSource\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Submodel\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Import\Fixtures\*.RBT" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Import\Fixtures\*.asp" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Import\Fixtures\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
