<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(OpenCSTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CSfea.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Верификация против опыта (McNeice, Vecchio–Shim) — ~13 из 15 мин полного прогона. По умолчанию dotnet test её
         пропускает; полный прогон: dotnet test CSfea.Tests -p:VSTestTestCaseFilter=, только она: filter Category=Verification.
         Явный filter заменяет этот фильтр. -->
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">Category!=Verification</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSfea.Core\CSfea.Core.csproj" />
    <ProjectReference Include="..\CSfea.Sparse\CSfea.Sparse.csproj" />
    <ProjectReference Include="..\CSfea.Sparse.CSparse\CSfea.Sparse.CSparse.csproj" />
    <ProjectReference Include="..\CSfea.CScore\CSfea.CScore.csproj" />
    <ProjectReference Include="..\CSfea.Thermal\CSfea.Thermal.csproj" />
    <ProjectReference Include="..\CSfea.Torsion\CSfea.Torsion.csproj" />
    <ProjectReference Include="..\CScore\CScore.csproj" />
    <ProjectReference Include="..\CScore.Fire\CScore.Fire.csproj" />
    <ProjectReference Include="..\OpenCS.Gmsh\OpenCS.Gmsh.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\tools\fire-parity\fixtures\*.json"
          CopyToOutputDirectory="PreserveNewest"
          Link="fixtures\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Требуется в каждом исполняемом проекте (в т.ч. тестовом) отдельно: raw HintPath-ссылки, объявленные
         только в CSTriangulation.csproj, физически копируются в bin/ транзитивно,
         но не попадают в .deps.json потребителя (нужно для рантайм-резолва в .NET). -->
    <Reference Include="Triangle">
      <HintPath>..\CSTriangulation\libs\Triangle\Triangle.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

</Project>
