{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opencs-model: sections[]",
  "description": "Сечение проекта: произвольное (areas), стадийное (staged) или параметрическое ЖБ/стальное (parametric — определение, области строит служба при apply; It сортамента — мм⁴, уклон полок — %). Ключ — обозначение (tag). Области описываются внутри сечения (ключ области — сечение и её обозначение); область, общая для нескольких сечений, при apply правится как один объект пула. Координаты, Ø, шаг, отступ — мм; площади стержней — мм²; σsp — МПа. Материалы — по обозначению, контуры — по ключу пула («набор / обозначение»); ссылки разрешаются по документу и проекту. Раздел записывается после materials и contours.",
  "type": "object",
  "required": ["tag"],
  "properties": {
    "tag": { "type": "string", "description": "Обозначение сечения — ключ" },
    "description": { "type": "string" },
    "areas": { "type": "array", "items": { "$ref": "#/$defs/area" }, "description": "Состав произвольного сечения" },
    "staged": {
      "type": "object",
      "required": ["parts"],
      "description": "Стадийное сечение: части в порядке включения",
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tag"],
            "properties": {
              "tag": { "type": "string" },
              "section": { "type": "string", "description": "Обозначение произвольного сечения — часть берёт его области" },
              "areas": { "type": "array", "items": { "$ref": "#/$defs/area" }, "description": "Свои области части" }
            },
            "oneOf": [ { "required": ["section"] }, { "required": ["areas"] } ]
          }
        }
      }
    },
    "parametric": {
      "description": "Параметрическое сечение: kind = rc (железобетонное) или steel (стальное)",
      "oneOf": [ { "$ref": "#/$defs/parametricRc" }, { "$ref": "#/$defs/parametricSteel" } ]
    }
  },
  "oneOf": [ { "required": ["areas"] }, { "required": ["staged"] }, { "required": ["parametric"] } ],
  "$defs": {
    "rcLayer": {
      "type": "object",
      "required": ["d", "coord"],
      "description": "Ряд продольной арматуры: физические стержни (count) или расчётный слой (area, axis); coord — координата ряда, мм",
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "area": { "type": "number", "description": "Площадь расчётного слоя, мм²" },
        "axis": { "enum": ["Mx", "My"] },
        "d": { "type": "number", "description": "Ø, мм" },
        "coord": { "type": "number" }
      }
    },
    "parametricRc": {
      "type": "object",
      "required": ["kind", "shape", "concrete", "rebar"],
      "properties": {
        "kind": { "const": "rc" },
        "shape": { "enum": ["rectangle", "tee", "iBeam", "circle", "annulus"] },
        "b": { "type": "number", "description": "Ширина (полки), мм" },
        "h": { "type": "number", "description": "Высота, мм" },
        "bw": { "type": "number", "description": "Толщина стенки тавра/двутавра, мм" },
        "hf": { "type": "number", "description": "Толщина полки тавра/двутавра, мм" },
        "d": { "type": "number", "description": "Диаметр круга/кольца, мм" },
        "dInner": { "type": "number", "description": "Внутренний диаметр кольца, мм" },
        "concrete": { "type": "string", "description": "Обозначение бетона" },
        "rebar": { "type": "string", "description": "Обозначение продольной арматуры" },
        "bottom": { "$ref": "#/$defs/rcLayer" },
        "top": { "$ref": "#/$defs/rcLayer" },
        "polar": {
          "type": "object", "required": ["count", "d", "r"], "description": "Равномерная раскладка по окружности (круг, кольцо)",
          "properties": { "count": { "type": "integer", "minimum": 7 }, "d": { "type": "number" }, "r": { "type": "number", "description": "Радиус окружности центров, мм" } }
        },
        "perimeter": {
          "type": "object", "required": ["cornerD", "intermediateD", "cover"], "description": "Прямоугольник: угловые стержни + промежуточные на гранях (вместо top/bottom)",
          "properties": {
            "cornerD": { "type": "number", "description": "Диаметр угловых, мм" }, "intermediateD": { "type": "number", "description": "Диаметр промежуточных, мм" },
            "cover": { "type": "number", "description": "От грани до центра стержней, мм" },
            "countWidth": { "type": "integer", "minimum": 0, "description": "Промежуточных на верхней и нижней гранях" },
            "countHeight": { "type": "integer", "minimum": 0, "description": "Промежуточных на левой и правой гранях" }
          }
        },
        "stirrups": {
          "type": "array", "description": "Наборы открытых срезов поперечной арматуры",
          "items": {
            "type": "object", "required": ["count", "d", "spacing", "cover"],
            "properties": {
              "zone": { "enum": ["body", "flange", "topFlange", "bottomFlange", "web"] },
              "direction": { "enum": ["vertical", "horizontal"] },
              "count": { "type": "integer", "minimum": 0 },
              "d": { "type": "number" }, "spacing": { "type": "number" }, "cover": { "type": "number" },
              "material": { "type": "string", "description": "Обозначение арматуры срезов (обязательно при count > 0)" }
            }
          }
        },
        "extraBars": {
          "type": "array", "description": "Отдельные стержни [x, y, d] или {x, y, d, area}, мм / мм²",
          "items": { "oneOf": [ { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
                                { "type": "object", "required": ["x", "y", "d"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "d": { "type": "number" }, "area": { "type": "number" } } } ] }
        }
      }
    },
    "parametricSteel": {
      "type": "object",
      "required": ["kind", "profile", "h", "steel"],
      "properties": {
        "kind": { "const": "steel" },
        "profile": { "enum": ["iBeam", "channel", "tee", "box", "pipe", "angle", "rect", "round"] },
        "fabrication": { "enum": ["rolled", "welded", "bent"] },
        "h": { "type": "number", "description": "Высота (диаметр трубы и круга, вертикальная полка уголка), мм" },
        "b": { "type": "number", "description": "Ширина (верхнего) пояса, полки, листа, мм" },
        "tf": { "type": "number" }, "b2": { "type": "number", "description": "Нижний пояс сварного двутавра, мм (нет — как верхний)" },
        "tf2": { "type": "number" }, "tw": { "type": "number" }, "r1": { "type": "number" }, "r2": { "type": "number" },
        "slopePercent": { "type": "number", "description": "Уклон внутренних граней полок, %" },
        "rotated90": { "type": "boolean" }, "flipped": { "type": "boolean" },
        "catalog": {
          "type": "object", "required": ["name"], "description": "Строка сортамента (справочно; контур строится по размерам)",
          "properties": { "group": { "type": "string" }, "standard": { "type": "string" }, "name": { "type": "string" }, "it": { "type": "number", "description": "It, мм⁴" } }
        },
        "steel": { "type": "string", "description": "Обозначение стали" }
      }
    },
    "point": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "ring": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" }, "description": "Вершины [x, y], мм, без замыкающей" },
    "area": {
      "type": "object",
      "required": ["tag", "category", "material"],
      "properties": {
        "tag": { "type": "string", "description": "Обозначение области (уникально в сечении)" },
        "description": { "type": "string" },
        "category": { "enum": ["region", "rebarGroup", "stirrups"], "description": "Бетонная (полигональная) область, группа стержней, хомуты" },
        "material": { "type": "string", "description": "Обозначение материала: бетонная — бетон или сталь, стержни и хомуты — арматура" },
        "diagram": { "enum": ["l2", "l3", "ekb", "sp63", "sp35", "sp16", "custom"], "description": "Тип диаграммы; по умолчанию бетон — sp63, арматура — по материалу" },
        "contour": { "type": "string", "description": "region: ключ контура пула («набор / обозначение»)" },
        "holes": { "type": "array", "items": { "$ref": "#/$defs/ring" }, "description": "region с contour: свои отверстия области" },
        "polygon": {
          "type": "object",
          "required": ["outer"],
          "description": "region: свой многоугольник вместо контура пула",
          "properties": {
            "outer": { "$ref": "#/$defs/ring" },
            "holes": { "type": "array", "items": { "$ref": "#/$defs/ring" } }
          }
        },
        "mesh": {
          "type": "object",
          "description": "region: параметры сетки волокон (сама сетка строится окном «Сетка»)",
          "properties": {
            "method": { "enum": ["grid", "ruppert", "advancingFront"], "default": "grid" },
            "nx": { "type": "integer", "minimum": 1, "default": 21 },
            "ny": { "type": "integer", "minimum": 1, "default": 21 },
            "maxArea": { "type": "number", "exclusiveMinimum": 0, "default": 0.01, "description": "Наибольшая площадь треугольника, доля площади области" },
            "minAngle": { "type": "number", "exclusiveMinimum": 0, "maximum": 35, "default": 30, "description": "Наименьший угол треугольника, °" },
            "maxEdge": { "type": "number", "minimum": 0, "default": 0, "description": "Целевая длина ребра, мм (0 — по maxArea)" },
            "smooth": { "type": "integer", "minimum": 0, "default": 5 }
          }
        },
        "host": { "type": "string", "description": "rebarGroup: обозначение бетонной области-носителя в том же сечении (части)" },
        "bars": {
          "type": "array",
          "description": "rebarGroup: стержни [x, y, d] мм (площадь — из d) или {x, y, d, area} (area — мм²)",
          "items": {
            "oneOf": [
              { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 },
              { "type": "object", "required": ["x", "y", "d"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "d": { "type": "number" }, "area": { "type": "number" } } }
            ]
          }
        },
        "prestress": {
          "type": "object",
          "description": "rebarGroup: преднапряжение после потерь",
          "properties": {
            "sigma": { "type": "number", "minimum": 0, "description": "σsp, МПа" },
            "gamma": { "enum": [1, 0.9, 1.1], "default": 1, "description": "γsp (п. 9.2.6 СП 63)" }
          }
        },
        "representation": { "enum": ["physicalBars", "idealizedLayer"], "default": "physicalBars" },
        "axis": { "enum": ["Mx", "My"], "description": "Ось изгиба расчётного слоя (для idealizedLayer)" },
        "stirrups": {
          "type": "array",
          "description": "Группы хомутов: у stirrups — материал области, у region — свой material",
          "items": {
            "type": "object",
            "required": ["spacing", "elements"],
            "properties": {
              "material": { "type": "string" },
              "spacing": { "type": "number", "exclusiveMinimum": 0, "description": "Шаг вдоль оси, мм" },
              "offset": { "type": "number", "minimum": 0, "description": "Отступ для построения новых элементов, мм" },
              "elements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["d", "points"],
                  "properties": {
                    "d": { "type": "number", "exclusiveMinimum": 0, "description": "Ø, мм" },
                    "area": { "type": "number", "description": "Площадь стержня, мм² (по умолчанию — из d)" },
                    "closed": { "type": "boolean", "default": true, "description": "Замкнутый хомут или открытый срез" },
                    "points": { "type": "array", "items": { "$ref": "#/$defs/point" }, "description": "Центровая линия, мм; у замкнутого — без замыкающей" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
