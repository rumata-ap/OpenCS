{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opencs-model: femSchemas[]",
  "description": "Родная МКЭ-схема (созданная в OpenCS; импортные ЛИРА/SCAD, фрагменты и субмодели не выгружаются и через apply не меняются). Ключ — имя (tag). Схема — составной объект: указанный массив (nodes, members, groups, lineSupports) заменяет состав схемы по этому виду — совпавшие по тегу объекты обновляются на месте, отсутствующие удаляются (с нагрузками и связями на них, с предупреждением); неуказанный массив не трогается. Координаты и длины — м, GJ — кН·м², углы — градусы, жёсткости пружин — кН/м и кН·м/рад (погонные — на метр грани: кН/м² и кН·м/рад/м). Направления — общие оси x y z ux uy uz (rx ry rz документов 6а тоже принимаются). Сетка и результаты не описываются: изменённая схема получает устаревшую сетку — она перестраивается перед расчётом или командой opencs run mesh; изменившаяся сетка сбрасывает результаты постановок.",
  "type": "object",
  "required": ["tag"],
  "additionalProperties": false,
  "$defs": {
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "Точка [x, y, z], м" },
    "loop": { "type": "array", "items": { "$ref": "#/$defs/point" }, "minItems": 3, "description": "Замкнутый контур без повтора первой вершины" },
    "tag": { "type": ["string", "integer"] },
    "dofs": { "type": "array", "items": { "enum": ["x", "y", "z", "ux", "uy", "uz", "rx", "ry", "rz"] }, "uniqueItems": true },
    "springs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Жёсткости по направлениям общих осей (≥ 0; по закреплённому направлению не задаются); нет — 0",
      "properties": { "kx": { "type": "number", "minimum": 0 }, "ky": { "type": "number", "minimum": 0 }, "kz": { "type": "number", "minimum": 0 },
                      "kux": { "type": "number", "minimum": 0 }, "kuy": { "type": "number", "minimum": 0 }, "kuz": { "type": "number", "minimum": 0 } }
    }
  },
  "properties": {
    "tag": { "type": "string", "minLength": 1 },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "barStepM": { "type": "number", "exclusiveMinimum": 0, "description": "Общий шаг сетки стержней, м; нет — по длине КонЭ" },
        "plateStepM": { "type": "number", "exclusiveMinimum": 0, "description": "Общий шаг сетки пластин, м" },
        "autoRigidJunctions": { "type": "boolean", "default": true, "description": "АЖТ примыкания стержень–пластина создаются автоматически" },
        "rigidJunctionAngleDeg": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90, "default": 10, "description": "Порог угла примыкания для АЖТ, °" }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag", "x", "y", "z"],
        "additionalProperties": false,
        "properties": {
          "tag": { "type": ["integer", "string"], "description": "Целый положительный номер узла" },
          "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" },
          "fix": { "$ref": "#/$defs/dofs", "description": "Закреплённые направления в общих осях; нет — узел свободен" },
          "springs": { "$ref": "#/$defs/springs", "description": "Пружины узла: kx ky kz — кН/м, kux kuy kuz — кН·м/рад; нет — пружин нет" }
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag"],
        "properties": {
          "tag": { "$ref": "#/$defs/tag" },
          "type": { "enum": ["beam", "truss", "shell"], "default": "beam" },
          "nodes": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "minItems": 2, "maxItems": 2, "description": "Стержень: начальный и конечный узлы" },
          "section": { "type": "string", "description": "Стержень: сечение (ключ из sections)" },
          "rotationDeg": { "type": "number", "default": 0, "description": "Стержень: поворот сечения вокруг оси, °" },
          "meshStepM": { "type": "number", "exclusiveMinimum": 0, "description": "Свой шаг сетки КонЭ, м; нет — общий шаг схемы" },
          "torsion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "strategy": { "enum": ["manual", "saint_venant"], "default": "manual" },
              "gj": { "type": "number", "minimum": 0, "description": "manual: GJ, кН·м²" },
              "task": { "type": "string", "description": "saint_venant: задача кручения (ключ из tasks)" }
            }
          },
          "rigidJunction": {
            "type": "object",
            "additionalProperties": false,
            "description": "Стержень beam: АЖТ примыкания к пластине; нет — авто, жёсткое тело, все направления",
            "properties": {
              "mode": { "enum": ["auto", "off"], "default": "auto", "description": "auto — по флажку схемы mesh.autoRigidJunctions; off — не создавать у этого стержня" },
              "kind": { "enum": ["rigid", "coupled"], "default": "rigid", "description": "rigid — абсолютно жёсткое тело; coupled — объединение перемещений" },
              "dofs": { "$ref": "#/$defs/dofs", "minItems": 1, "description": "Связанные направления (общие оси)" }
            }
          },
          "kind": { "enum": ["plate", "wall"], "description": "Пластина: вид вручную; нет — по наклону" },
          "plateSection": { "type": "string", "description": "Пластина: сечение (ключ из plateSections)" },
          "region": {
            "type": "object",
            "required": ["outline"],
            "additionalProperties": false,
            "description": "Пластина: область в общих координатах (точки в одной плоскости, допуск 1 мм)",
            "properties": {
              "outline": { "$ref": "#/$defs/loop" },
              "holes": { "type": "array", "items": { "$ref": "#/$defs/loop" } },
              "xAxis": { "$ref": "#/$defs/point", "description": "Местная ось X пластины; нет — горизонтальная плита: общая X, стена: вдоль первой стороны" },
              "normal": { "$ref": "#/$defs/point", "description": "Нормаль пластины (её верх) — направление, по знаку которого выбирается сторона; нет — по умолчанию: у плиты вверх, у стены — X × вверх" }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag", "members"],
        "additionalProperties": false,
        "properties": {
          "tag": { "type": "string", "minLength": 1 },
          "memberType": { "enum": ["beam", "column", "plate", "wall", "shell", "truss", "top_chord", "bottom_chord", "diagonal", "bracing", "other"] },
          "members": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "description": "Теги КонЭ схемы" }
        }
      }
    },
    "lineSupports": {
      "type": "array",
      "description": "Линейные связи на гранях пластин (указан — заменяет все связи схемы). Сторона k — от k-й вершины контура (region.outline или holes[hole-1]) к следующей; одна грань — в одной записи",
      "items": {
        "type": "object",
        "required": ["member", "sides"],
        "additionalProperties": false,
        "properties": {
          "member": { "$ref": "#/$defs/tag", "description": "Пластина (тег КонЭ)" },
          "hole": { "type": "integer", "minimum": 1, "description": "Номер отверстия (с 1); нет — внешний контур" },
          "sides": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "uniqueItems": true, "description": "Номера сторон контура (с 1)" },
          "fix": { "$ref": "#/$defs/dofs", "description": "Закреплённые направления (общие оси)" },
          "fixEdgeRotation": { "type": "boolean", "default": false, "description": "Закрепить поворот кромки (вокруг нормали к грани в плоскости пластины)" },
          "springs": { "$ref": "#/$defs/springs", "description": "Погонные пружины: kx ky kz — кН/м², kux kuy kuz — кН·м/рад/м" }
        }
      }
    },
    "loadCases": {
      "type": "array",
      "description": "Загружения (указан — заменяет набор загружений схемы; загружение, заданное в постановке, удалить нельзя, входящее в комбинации — только вместе с combinations). Нагрузки: силы — кН, моменты — кН·м, погонные — кН/м, площадные — кПа, отступы — м, перемещения — мм, повороты — мрад",
      "items": {
        "type": "object",
        "required": ["tag"],
        "additionalProperties": false,
        "properties": {
          "tag": { "type": "string", "minLength": 1 },
          "type": { "enum": ["permanent", "long_term", "short_term", "accidental", "imperfection"], "default": "short_term", "description": "Вид нагрузки по СП 20; imperfection — загружение-несовершенство (только imperfections)" },
          "group": { "type": "string", "description": "Группа взаимоисключающих загружений" },
          "gammaF": { "type": "number", "exclusiveMinimum": 0, "description": "γf; нет — по умолчанию из настроек расчёта" },
          "gammaFReduced": { "type": "number", "exclusiveMinimum": 0, "description": "Пониженный γf (п. 7.3), только permanent" },
          "longTermShare": { "type": "number", "minimum": 0, "maximum": 1, "description": "Доля длительной части, только short_term" },
          "selfWeight": { "type": "number", "description": "Коэффициент к собственному весу всей схемы" },
          "loads": {
            "type": "array",
            "description": "Нагрузки загружения (указан — заменяет нагрузки на узлы и стержни КонЭ, заданные перемещения и равномерные нагрузки на пластины; нагрузки сеточного уровня не трогаются)",
            "items": {
              "oneOf": [
                { "type": "object", "required": ["node"], "additionalProperties": false, "description": "Сила и момент в узле КонЭ (общие оси)",
                  "properties": { "node": { "$ref": "#/$defs/tag" }, "f": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "Fx Fy Fz, кН" }, "m": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "Mx My Mz, кН·м" } } },
                { "type": "object", "required": ["node", "displacement"], "additionalProperties": false, "description": "Заданные перемещения узла КонЭ",
                  "properties": { "node": { "$ref": "#/$defs/tag" }, "displacement": { "type": "object", "description": "x y z — мм, ux uy uz — мрад", "additionalProperties": false,
                    "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }, "ux": { "type": "number" }, "uy": { "type": "number" }, "uz": { "type": "number" } } } } },
                { "type": "object", "required": ["member"], "additionalProperties": false, "description": "Нагрузка на стержень КонЭ: q (равномерная; с q2 — трапеция на участке) или point (сосредоточенная в точке a)",
                  "properties": { "member": { "$ref": "#/$defs/tag" }, "axes": { "enum": ["local", "global"], "default": "local" },
                    "q": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "qx qy qz в начале участка, кН/м" }, "q2": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "qx qy qz в конце участка, кН/м" },
                    "point": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "Px Py Pz, кН" }, "m": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "Mx My Mz сосредоточенной, кН·м" },
                    "a": { "type": "number", "minimum": 0, "description": "Отступ от начала стержня, м" }, "b": { "type": "number", "minimum": 0, "description": "Отступ от конца стержня, м (не у point)" } } },
                { "type": "object", "required": ["p"], "additionalProperties": false, "description": "Равномерное давление на пластины: plates (теги КонЭ) или group",
                  "properties": { "plates": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "minItems": 1 }, "group": { "$ref": "#/$defs/tag" },
                    "p": { "type": "number", "description": "кПа, знак — вдоль направления" }, "direction": { "enum": ["x", "y", "z", "normal"], "default": "z", "description": "Общая ось или нормаль пластины" } } }
              ]
            }
          },
          "imperfections": {
            "type": "array",
            "description": "Элементы несовершенства (указан — заменяет элементы загружения). params — поля окна в camelCase, единица — в имени поля (heightM, e0Mm…); у modes постановка — analysis (имя)",
            "items": {
              "type": "object",
              "required": ["tag", "kind"],
              "additionalProperties": false,
              "properties": {
                "tag": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["sway", "bow", "wall_bow", "modes"] },
                "comment": { "type": "string" },
                "params": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "combinations": {
      "type": "array",
      "description": "Комбинации (указан — заменяет набор комбинаций схемы). Слагаемое: role без k — «авто» по СП 20; k с role — заданное число с ролью; только k — число",
      "items": {
        "type": "object",
        "required": ["tag"],
        "additionalProperties": false,
        "properties": {
          "tag": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "description": "C, CL, N, NL, A или свой" },
          "comment": { "type": "string" },
          "all": { "type": "boolean", "description": "Все загружения с коэффициентом 1 (без terms)" },
          "terms": { "type": "array", "items": { "type": "object", "required": ["loadCase"], "additionalProperties": false,
            "properties": { "loadCase": { "$ref": "#/$defs/tag" }, "k": { "type": "number" },
              "role": { "enum": ["permanent", "permanent_reduced", "leading", "second", "other", "accidental"] } } } }
        }
      }
    },
    "fields": {
      "type": "array",
      "description": "Поля из таблиц точек (указан — заменяет набор полей схемы; без массива поля не трогаются). Точки — [x, y, (z), значения по столбцам] в единицах столбцов; alignment.scale переводит координаты таблицы в м. Пружины (quantity spring) — цели узлы сетки, способ match. C1 (foundation.c1) — цели пластины. Изменение полей сбрасывает результаты постановок; при готовой сетке поля пересчитываются, без сетки — при перестроении",
      "items": {
        "type": "object",
        "required": ["tag", "quantity", "columns", "points"],
        "additionalProperties": false,
        "properties": {
          "tag": { "type": "string", "minLength": 1, "description": "Имя поля (ключ)" },
          "quantity": { "enum": ["foundation.c1", "spring"] },
          "hasZ": { "type": "boolean", "description": "В точках есть координата z третьей" },
          "columns": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["component", "unit"], "additionalProperties": false,
            "properties": { "header": { "type": "string" }, "component": { "type": "string", "description": "c1; kx ky kz kux kuy kuz" },
              "unit": { "type": "string", "description": "тс/м³, кН/м³, МН/м³, Н/м³; для пружин — тс/м, тс/см, кН/м, МН/м, Н/м, для поворотных — тс·м/рад, кН·м/рад, МН·м/рад, Н·м/рад" } } } },
          "points": { "type": "array", "items": { "type": "array", "items": { "type": "number" } }, "description": "[x, y, (z), значения…]" },
          "method": { "enum": ["interpolate", "nearest", "idw", "match"], "description": "По умолчанию interpolate (пластины) и match (пружины)" },
          "maxDistanceM": { "type": "number", "exclusiveMinimum": 0, "description": "Предельное расстояние до точки, м (по умолчанию 1)" },
          "planeToleranceM": { "type": "number", "exclusiveMinimum": 0, "description": "Допуск до плоскости участка, м (по умолчанию 0,5)" },
          "matchToleranceM": { "type": "number", "exclusiveMinimum": 0, "description": "Допуск поиска узла, м (по умолчанию 0,5)" },
          "alignment": { "type": "object", "additionalProperties": false,
            "properties": { "scale": { "type": "number", "exclusiveMinimum": 0 }, "dxM": { "type": "number" }, "dyM": { "type": "number" },
              "dzM": { "type": "number" }, "angleDeg": { "type": "number" }, "mirrorX": { "type": "boolean" }, "mirrorY": { "type": "boolean" } } },
          "targets": { "type": "object", "additionalProperties": false,
            "properties": { "groups": { "type": "array", "items": { "type": "string" }, "description": "Теги групп схемы" },
              "members": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "description": "Теги КонЭ" },
              "elems": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "description": "Теги КЭ сетки" },
              "nodes": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "description": "Теги узлов сетки (пружины)" },
              "onlyNodesWithSprings": { "type": "boolean", "description": "Пружины: только узлы с пружиной (по умолчанию да)" } } },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
