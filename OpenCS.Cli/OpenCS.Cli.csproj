<Project Sdk="Microsoft.NET.Sdk">

  <!-- Консоль opencs: расчёт проекта без UI, одна сборка для Windows и Linux (Этап 0 дорожной карты API).
       Имя сборки не «opencs»: на Windows opencs.dll и OpenCS.dll WPF — один файл. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(OpenCSTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenCS.Cli</RootNamespace>
    <AssemblyName>OpenCS.Cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenCS.App\OpenCS.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Короткое имя запуска: opencs.cmd (Windows) и opencs (Linux, sh; LF — см. .gitattributes).
         Публикация одна для обеих ОС: dotnet publish OpenCS.Cli -c Release -o <папка>. -->
    <None Include="opencs;opencs.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- JSON-схемы видов документа opencs-model: opencs schema <вид>. -->
    <EmbeddedResource Include="Model\Schemas\*.json" LogicalName="OpenCS.Cli.Model.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Triangle.dll объявлен raw-ссылкой в CSTriangulation: в bin потребителя копируется,
         но не попадает в .deps.json (нужно для рантайм-резолва в .NET). -->
    <Reference Include="Triangle">
      <HintPath>..\CSTriangulation\libs\Triangle\Triangle.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- COM-интероп результатов ЛИРЫ: та же причина (.deps.json); вызовы — только в Windows. -->
    <Reference Include="Interop.LiraSaprRes">
      <HintPath>..\OpenCS\Interop\Interop.LiraSaprRes.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

</Project>
