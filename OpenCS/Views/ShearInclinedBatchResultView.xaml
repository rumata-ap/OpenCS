<UserControl x:Class="OpenCS.Views.ShearInclinedBatchResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding SectionTag}"/>
            <TextBlock Text="{Binding ForceSetTag}" Margin="0,2,0,0" Foreground="Gray"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="12,8" Margin="0,0,0,8" CornerRadius="4"
                BorderBrush="#D5DDE5" BorderThickness="1">
            <TextBlock Text="{Binding VerdictText}" HorizontalAlignment="Center"
                       FontWeight="Bold" FontSize="14" Foreground="{Binding VerdictBrush}"/>
        </Border>

        <Border Grid.Row="2" Padding="8,6" Margin="0,0,0,8" CornerRadius="4"
                Background="#FFF8F0" BorderBrush="#E8D5C0" BorderThickness="1"
                Visibility="{Binding CautionsVisibility}">
            <StackPanel>
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#555"
                           Text="{DynamicResource ShearInclinedCautionsTitle}"/>
                <ItemsControl ItemsSource="{Binding Cautions}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Button Grid.Row="3" Content="{DynamicResource ExportCsvBtn}" Margin="0,0,0,8"
                HorizontalAlignment="Left" Padding="12,4" Click="ExportCsv_Click"/>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Num}"/>
                <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnLabel}"
                                    Binding="{Binding Label}"/>
                <DataGridTextColumn Header="Vy" Binding="{Binding Vy, StringFormat=F1}"/>
                <DataGridTextColumn Header="Vx" Binding="{Binding Vx, StringFormat=F1}"/>
                <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnUtilization}"
                                    Binding="{Binding UtilizationText}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding UtilizationBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnWorst}"
                                    Binding="{Binding WorstFormula}"/>
                <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnStatus}"
                                    Binding="{Binding StatusText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
