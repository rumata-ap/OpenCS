<Window x:Class="OpenCS.Views.FemImperfectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenCS.ViewModels"
        Title="{Binding Title}"
        Width="760" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Элемент несовершенства (по образцу RFEM «Задать или изменить несовершенство»): FemImperfectionDialogVM. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- Имя и вид -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionTag}"/>
                    <TextBox x:Name="tagBox" Grid.Column="1" Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource FemImperfectionTagTip}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionKind}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <RadioButton Content="{DynamicResource FemImperfectionKindSway}" IsChecked="{Binding IsSway}"
                                     ToolTip="{DynamicResource FemImperfectionKindSwayTip}" Margin="0,0,14,0"/>
                        <RadioButton Content="{DynamicResource FemImperfectionKindBow}" IsChecked="{Binding IsBow}"
                                     ToolTip="{DynamicResource FemImperfectionKindBowTip}" Margin="0,0,14,0"/>
                        <RadioButton Content="{DynamicResource FemImperfectionKindModes}" IsChecked="{Binding IsModes}"
                                     ToolTip="{DynamicResource FemImperfectionKindModesTip}" Margin="0,0,14,0"/>
                        <RadioButton Content="{DynamicResource FemImperfectionKindWallBow}" IsChecked="{Binding IsWallBow}"
                                     ToolTip="{DynamicResource FemImperfectionKindWallBowTip}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionNorm}"
                               Visibility="{Binding HasNorm, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                                Visibility="{Binding HasNorm, Converter={StaticResource BoolToVis}}">
                        <ComboBox Width="230" ItemsSource="{Binding Norms}" SelectedValuePath="Key" DisplayMemberPath="Label"
                                  SelectedValue="{Binding Norm}" ToolTip="{DynamicResource FemImperfectionNormTip}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding NormText}"/>
                    </StackPanel>
                </Grid>

                <!-- Относительно: охват крена или элементы погиби -->
                <GroupBox Header="{DynamicResource FemImperfectionTargets}"
                          Visibility="{Binding HasTargets, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2"
                                    Visibility="{Binding IsSway, Converter={StaticResource BoolToVis}}">
                            <RadioButton Content="{DynamicResource FemImperfectionScopeAll}" IsChecked="{Binding ScopeAll}"
                                         Margin="0,0,14,0"/>
                            <RadioButton Content="{DynamicResource FemImperfectionScopeList}" IsChecked="{Binding ScopeList}"/>
                        </StackPanel>
                        <Grid Visibility="{Binding IsListScope, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionMembers}"/>
                            <TextBox Grid.Column="1" Text="{Binding MembersText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource FemImperfectionMembersTip}"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionElements}"
                                       Visibility="{Binding HasElementsList, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ElementsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource FemImperfectionElementsTip}"
                                     Visibility="{Binding HasElementsList, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionChains}"
                                       Visibility="{Binding IsBow, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ChainsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource FemImperfectionChainsTip}"
                                     Visibility="{Binding IsBow, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <Button Content="{DynamicResource FemImperfectionTakeSelection}" Command="{Binding TakeSelectionCommand}"
                                        ToolTip="{DynamicResource FemImperfectionTakeSelectionTip}" Padding="8,2"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding SelectionNote}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Крен: направление и φ -->
                <GroupBox Header="{DynamicResource FemImperfectionSwayGroup}"
                          Visibility="{Binding IsSway, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionAngle}"/>
                        <TextBox Grid.Column="1" Text="{Binding AngleText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource FemImperfectionAngleTip}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,2,0,2">
                            <Button Content="+X" Command="{Binding SetAngleCommand}" CommandParameter="0" Width="34" Margin="0,0,3,0"/>
                            <Button Content="+Y" Command="{Binding SetAngleCommand}" CommandParameter="90" Width="34" Margin="0,0,3,0"/>
                            <Button Content="−X" Command="{Binding SetAngleCommand}" CommandParameter="180" Width="34" Margin="0,0,3,0"/>
                            <Button Content="−Y" Command="{Binding SetAngleCommand}" CommandParameter="270" Width="34"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,2">
                            <RadioButton Content="{Binding PhiNormLabel}" IsChecked="{Binding PhiNorm}"
                                         IsEnabled="{Binding CanPhiNorm}" Margin="0,0,14,0"/>
                            <RadioButton Content="{DynamicResource FemImperfectionPhiManual}" IsChecked="{Binding PhiManual}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionH}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource FemImperfectionHTip}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Hint}" Text="{DynamicResource FemImperfectionHHint}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionM}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource FemImperfectionMTip}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Hint}" Text="{Binding MHintText}"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Text="1/φ"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PhiInvText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding PhiManual}" ToolTip="{DynamicResource FemImperfectionPhiInvTip}"/>
                        <Button Grid.Row="4" Grid.Column="2" HorizontalAlignment="Left" Margin="6,2,0,2" Padding="8,1"
                                Content="{DynamicResource FemImperfectionComputePhi}" Command="{Binding ComputePhiCommand}"
                                ToolTip="{DynamicResource FemImperfectionComputePhiTip}"/>
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Foreground="DimGray" TextWrapping="Wrap" FontSize="11" Margin="0,2"
                                   Text="{Binding PhiDescription}"/>
                    </Grid>
                </GroupBox>

                <!-- Погибь: плоскость, e₀, знак, активность -->
                <GroupBox Header="{DynamicResource FemImperfectionBowGroup}"
                          Visibility="{Binding IsBowLike, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionPlane}"
                                   Visibility="{Binding IsBow, Converter={StaticResource BoolToVis}}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:FemImperfectionDialogVM.Planes}" SelectedValuePath="Key"
                                  DisplayMemberPath="Label" SelectedValue="{Binding Plane}"
                                  Visibility="{Binding IsBow, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionE0Mode}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding E0ModeChoices}" SelectedValuePath="Key"
                                  DisplayMemberPath="Label" SelectedValue="{Binding E0Mode}"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionCurve}"
                                   Visibility="{Binding IsE0Table, Converter={StaticResource BoolToVis}}"/>
                        <!-- Список — на всю ширину, как соседние; подсказка табл. 5.1 — строкой под ним (не обрезает «авто — по сечению (табл. 6.2)») -->
                        <StackPanel Grid.Row="2" Grid.Column="1"
                                    Visibility="{Binding IsE0Table, Converter={StaticResource BoolToVis}}">
                            <ComboBox ItemsSource="{x:Static vm:FemImperfectionDialogVM.Curves}" SelectedValuePath="Key"
                                      DisplayMemberPath="Label" SelectedValue="{Binding Curve}" ToolTip="{DynamicResource FemImperfectionCurveTip}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding TableValueText}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2"
                                    Visibility="{Binding IsE0Table, Converter={StaticResource BoolToVis}}">
                            <RadioButton Content="{DynamicResource FemImperfectionElastic}" IsChecked="{Binding Elastic}"
                                         Margin="0,0,14,0"/>
                            <RadioButton Content="{DynamicResource FemImperfectionPlastic}" IsChecked="{Binding Plastic}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Text="{Binding RelativeLabel}"
                                   Visibility="{Binding IsE0Relative, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                 Text="{Binding LOverE0Text, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsE0Relative, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Row="5" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionE0Mm}"
                                   Visibility="{Binding IsE0Absolute, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                 Text="{Binding E0MmText, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsE0Absolute, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionMu}"
                                   Visibility="{Binding IsE0Mu, Converter={StaticResource BoolToVis}}"/>
                        <!-- Подсказка μ длинная: занимает остаток строки и переносится, а не обрезается -->
                        <DockPanel Grid.Row="6" Grid.Column="1" LastChildFill="True"
                                   Visibility="{Binding IsE0Mu, Converter={StaticResource BoolToVis}}">
                            <TextBox DockPanel.Dock="Left" Width="90" VerticalAlignment="Top" Text="{Binding MuText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource FemImperfectionMuTip}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource FemImperfectionMuHint}"/>
                        </DockPanel>
                        <TextBlock Grid.Row="7" Style="{StaticResource Caption}" Text="{Binding SizeMmLabel}"
                                   Visibility="{Binding IsE0Sp63, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal"
                                    Visibility="{Binding IsE0Sp63, Converter={StaticResource BoolToVis}}">
                            <TextBox Width="90" Text="{Binding SizeMmText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource FemImperfectionSizeMmTip}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource FemImperfectionSp63Hint}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="8" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionSign}"/>
                        <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{x:Static vm:FemImperfectionDialogVM.Signs}" SelectedValuePath="Key"
                                  DisplayMemberPath="Label" SelectedValue="{Binding Sign}" ToolTip="{DynamicResource FemImperfectionSignTip}"/>
                        <TextBlock Grid.Row="9" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionActivity}"
                                   Visibility="{Binding ShowActivity, Converter={StaticResource BoolToVis}}"/>
                        <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{x:Static vm:FemImperfectionDialogVM.Activities}" SelectedValuePath="Key"
                                  DisplayMemberPath="Label" SelectedValue="{Binding Activity}" ToolTip="{DynamicResource FemImperfectionActivityTip}"
                                  Visibility="{Binding ShowActivity, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                   Text="{DynamicResource FemImperfectionConcreteHint}"
                                   Visibility="{Binding IsConcreteNorm, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                    Visibility="{Binding IsWallBow, Converter={StaticResource BoolToVis}}">
                            <Button HorizontalAlignment="Left" Padding="8,1" Content="{DynamicResource FemImperfectionWallPreview}"
                                    Command="{Binding PreviewTiersCommand}" ToolTip="{DynamicResource FemImperfectionWallPreviewTip}"/>
                            <TextBox Text="{Binding TiersText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="11"
                                     MaxHeight="120" VerticalScrollBarVisibility="Auto" Foreground="DimGray" Margin="0,2"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Формы потери устойчивости: постановка, задача, формы и амплитуды (п. 5.3.2(11)) -->
                <GroupBox Header="{DynamicResource FemImperfectionModesGroup}"
                          Visibility="{Binding IsModes, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionModesAnalysis}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding BucklingSources}" SelectedItem="{Binding BucklingSource}"
                                  DisplayMemberPath="Tag" ToolTip="{DynamicResource FemImperfectionModesAnalysisTip}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Crimson" TextWrapping="Wrap" Margin="0,2"
                                   Text="{Binding BucklingStatus}"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="{DynamicResource FemImperfectionModesCase}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding BucklingCases}" SelectedItem="{Binding BucklingCase}"
                                  DisplayMemberPath="Tag" ToolTip="{DynamicResource FemImperfectionModesCaseTip}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Foreground="DimGray" TextWrapping="Wrap" FontSize="11" Margin="0,2"
                                   Text="{Binding LambdaText}"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource Caption}" VerticalAlignment="Top"
                                   Text="{DynamicResource FemImperfectionModesList}"/>
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <DataGrid ItemsSource="{Binding ModeRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" HeadersVisibility="Column" MaxHeight="150" Margin="0,2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource FemImperfectionColMode}" Width="90"
                                                        Binding="{Binding ModeText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTemplateColumn Header="{DynamicResource FemImperfectionColAmplitude}" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding AmplitudeText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                                                         IsEnabled="{Binding IsManual}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{DynamicResource FemImperfectionColModeFormula}" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding ByFormula, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                          ToolTip="{DynamicResource FemImperfectionColModeFormulaTip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{DynamicResource FemImperfectionColModeMinus}" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Minus, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                          IsEnabled="{Binding ByFormula}" ToolTip="{DynamicResource FemImperfectionColModeMinusTip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Padding="6,0" ToolTip="{DynamicResource FemImperfectionModesRemove}"
                                                        Command="{Binding DataContext.RemoveModeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button HorizontalAlignment="Left" Padding="8,1" Content="{DynamicResource FemImperfectionModesAdd}"
                                    Command="{Binding AddModeCommand}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="5" Style="{StaticResource Caption}" VerticalAlignment="Top"
                                   Text="{DynamicResource FemImperfectionModes59}"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,2">
                            <!-- WrapPanel: «Крит. КЭ» переносится на следующую строку, а не обрезается по ширине окна -->
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource FemImperfectionModesGammaM1}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Width="50" Text="{Binding GammaM1Text, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource FemImperfectionModesGammaM1Tip}"/>
                                <TextBlock Text="{DynamicResource FemImperfectionModesCurve}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                <ComboBox Width="170" ItemsSource="{x:Static vm:FemImperfectionDialogVM.Curves}" SelectedValuePath="Key"
                                          DisplayMemberPath="Label" SelectedValue="{Binding ModeCurve}"
                                          ToolTip="{DynamicResource FemImperfectionModesCurveTip}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{DynamicResource FemImperfectionModesCritical}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <TextBox Width="70" Text="{Binding CriticalText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource FemImperfectionModesCriticalTip}"/>
                                </StackPanel>
                            </WrapPanel>
                            <Button HorizontalAlignment="Left" Padding="8,1" Margin="0,4,0,0" Content="{DynamicResource FemImperfectionModesPreview}"
                                    Command="{Binding PreviewModesCommand}" ToolTip="{DynamicResource FemImperfectionModesPreviewTip}"/>
                            <TextBox Text="{Binding ModesPreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="11"
                                     MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,2"/>
                        </StackPanel>
                        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                   Text="{DynamicResource FemImperfectionModesHint}"/>
                        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                   Text="{DynamicResource FemImperfectionModesHint59}"/>
                    </Grid>
                </GroupBox>

                <TextBlock Text="{DynamicResource FemImperfectionComment}" Margin="0,8,0,2"/>
                <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="40"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </StackPanel>

            <!-- Схема стержня i–j: идеальная ось пунктиром; крен φ — наклон хорды, погибь e₀ — парабола (рис. 5.3–5.4) -->
            <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="LightGray" BorderThickness="1" Padding="6" VerticalAlignment="Top">
                <Canvas Width="190" Height="330">
                    <Line X1="70" Y1="260" X2="70" Y2="30" Stroke="Gray" StrokeThickness="1" StrokeDashArray="4 3"/>
                    <Line X1="40" Y1="268" X2="100" Y2="268" Stroke="Gray" StrokeThickness="1.5"/>
                    <Path Stroke="Gray" StrokeThickness="1" Data="M44,276 L52,268 M56,276 L64,268 M68,276 L76,268 M80,276 L88,268 M92,276 L100,268"/>
                    <Ellipse Canvas.Left="66" Canvas.Top="256" Width="8" Height="8" Fill="White" Stroke="Black"/>
                    <TextBlock Canvas.Left="52" Canvas.Top="244" Text="i" FontStyle="Italic"/>

                    <!-- Крен -->
                    <Canvas Visibility="{Binding IsSway, Converter={StaticResource BoolToVis}}">
                        <Line X1="70" Y1="260" X2="120" Y2="30" Stroke="#C03030" StrokeThickness="2.5"/>
                        <Ellipse Canvas.Left="116" Canvas.Top="26" Width="8" Height="8" Fill="White" Stroke="Black"/>
                        <TextBlock Canvas.Left="128" Canvas.Top="20" Text="j" FontStyle="Italic"/>
                        <Path Stroke="#C03030" StrokeThickness="1" Data="M70,200 A60,60 0 0 1 83,201"/>
                        <TextBlock Canvas.Left="84" Canvas.Top="176" Text="φ" FontSize="15" Foreground="#C03030"/>
                        <Line X1="70" Y1="18" X2="120" Y2="18" Stroke="DimGray" StrokeThickness="1"/>
                        <Path Stroke="DimGray" Fill="DimGray" Data="M120,18 L113,15 L113,21 Z"/>
                        <TextBlock Canvas.Left="76" Canvas.Top="0" Text="φ·h" Foreground="DimGray"/>
                        <TextBlock Canvas.Left="2" Canvas.Top="130" Text="h" FontStyle="Italic" Foreground="DimGray"/>
                        <TextBlock Canvas.Left="4" Canvas.Top="282" Width="186" TextWrapping="Wrap" FontSize="10" Foreground="Gray"
                                   Text="{DynamicResource FemImperfectionSketchSway}"/>
                    </Canvas>

                    <!-- Погибь -->
                    <Canvas Visibility="{Binding IsBow, Converter={StaticResource BoolToVis}}">
                        <Path Stroke="#C03030" StrokeThickness="2.5" Data="M70,260 Q140,145 70,30"/>
                        <Ellipse Canvas.Left="66" Canvas.Top="26" Width="8" Height="8" Fill="White" Stroke="Black"/>
                        <TextBlock Canvas.Left="52" Canvas.Top="20" Text="j" FontStyle="Italic"/>
                        <Line X1="70" Y1="145" X2="105" Y2="145" Stroke="DimGray" StrokeThickness="1"/>
                        <Path Stroke="DimGray" Fill="DimGray" Data="M105,145 L98,142 L98,148 Z"/>
                        <TextBlock Canvas.Left="112" Canvas.Top="136" Text="e₀" FontSize="15" Foreground="#C03030"/>
                        <TextBlock Canvas.Left="20" Canvas.Top="138" Text="L" FontStyle="Italic" Foreground="DimGray"/>
                        <TextBlock Canvas.Left="4" Canvas.Top="282" Width="186" TextWrapping="Wrap" FontSize="10" Foreground="Gray"
                                   Text="{DynamicResource FemImperfectionSketchBow}"/>
                    </Canvas>

                    <!-- Погибь стен: полуволна в каждом ярусе между перекрытиями -->
                    <Canvas Visibility="{Binding IsWallBow, Converter={StaticResource BoolToVis}}">
                        <Line X1="40" Y1="145" X2="130" Y2="145" Stroke="Black" StrokeThickness="3"/>
                        <Line X1="40" Y1="30" X2="130" Y2="30" Stroke="Black" StrokeThickness="3"/>
