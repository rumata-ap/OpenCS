<UserControl x:Class="OpenCS.Views.FireSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:OpenCS.Views.Helpers">
   <UserControl.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/OpenCS;component/Resources/CardStyles.xaml"/>
         </ResourceDictionary.MergedDictionaries>
         <Style x:Key="Lbl" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
         </Style>
         <Style x:Key="Fld" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,6"/>
         </Style>
         <Style x:Key="Cmb" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,6"/>
         </Style>
         <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
         </Style>
      </ResourceDictionary>
   </UserControl.Resources>

   <TabControl x:Name="mainTabs" Margin="4" SelectionChanged="MainTab_SelectionChanged">
      <TabItem Header="{DynamicResource FireSection_TabParameters}">
         <Grid>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="440"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Слева: параметры -->
            <DockPanel Grid.Column="0" Margin="8,8,4,8">
               <!-- Имя и команды -->
               <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="Auto"/>
                     <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Tag}" Style="{StaticResource Lbl}"/>
                  <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Fld}"
                           Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource FireSection_CrossSection}" Style="{StaticResource Lbl}"/>
                  <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Cmb}"
                            ItemsSource="{Binding Sections}" DisplayMemberPath="Tag"
                            SelectedItem="{Binding SelectedSection, ValidatesOnNotifyDataErrors=True}"/>
               </Grid>

               <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                  <TextBlock Text="{Binding ErrorText}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,6"
                             Visibility="{Binding HasErrorText, Converter={StaticResource BoolToVisibility}}"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                     <Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}" MinWidth="110" Margin="0,0,8,0"/>
                     <Button Content="{DynamicResource FireSection_RunThermal}" Command="{Binding RunThermalCommand}" MinWidth="170"/>
                  </StackPanel>
                  <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  <TextBlock Text="{Binding ThermalStatusText}" TextWrapping="Wrap" Margin="0,4,0,0">
                     <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                           <Style.Triggers>
                              <DataTrigger Binding="{Binding ThermalStatusIsProblem}" Value="True">
                                 <Setter Property="Foreground" Value="DarkOrange"/>
                              </DataTrigger>
                           </Style.Triggers>
                        </Style>
                     </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{DynamicResource FireSection_Norm48Note}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
               </StackPanel>

               <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                     <!-- Пожар -->
                     <GroupBox Header="{DynamicResource FireSection_CardFire}" Style="{StaticResource CardGroupBox}" Margin="0,0,0,8">
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="190"/>
                              <ColumnDefinition Width="*"/>
                           </Grid.ColumnDefinitions>
                           <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                           </Grid.RowDefinitions>
                           <TextBlock Grid.Row="0" Text="{DynamicResource FireSection_Duration}" Style="{StaticResource Lbl}"/>
                           <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Fld}"
                                    Text="{Binding FireDurationText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                           <TextBlock Grid.Row="1" Text="{DynamicResource FireSection_Curve}" Style="{StaticResource Lbl}"/>
                           <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Cmb}" SelectedValuePath="Tag"
                                     SelectedValue="{Binding FireCurve, ValidatesOnNotifyDataErrors=True}">
                              <ComboBoxItem Tag="iso834" Content="{DynamicResource FireSection_CurveIso834}"/>
                              <ComboBoxItem Tag="hydrocarbon" Content="{DynamicResource FireSection_CurveHydrocarbon}"/>
                              <ComboBoxItem Tag="slow" Content="{DynamicResource FireSection_CurveSlow}"/>
                           </ComboBox>
                           <TextBlock Grid.Row="2" Text="{DynamicResource Material_AggregateType}" Style="{StaticResource Lbl}"/>
                           <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Cmb}" SelectedValuePath="Tag"
                                     SelectedValue="{Binding AggregateType, ValidatesOnNotifyDataErrors=True}">
                              <ComboBoxItem Tag="" Content="{DynamicResource FireSection_AggregateAuto}"/>
                              <ComboBoxItem Tag="silicate" Content="{DynamicResource Material_AggregateType_Silicate}"/>
                              <ComboBoxItem Tag="carbonate" Content="{DynamicResource Material_AggregateType_Carbonate}"/>
                              <ComboBoxItem Tag="lightweight" Content="{DynamicResource Material_AggregateType_Lightweight}"/>
                           </ComboBox>
                           <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AggregateFromSectionText}" Style="{StaticResource Hint}"/>
                        </Grid>
                     </GroupBox>

                     <!-- Граничные условия -->
                     <GroupBox Header="{DynamicResource FireSection_CardBc}" Style="{StaticResource CardGroupBox}" Margin="0,0,0,8">
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="190"/>
                              <ColumnDefinition Width="*"/>
                           </Grid.ColumnDefinitions>
                           <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                           </Grid.RowDefinitions>
                           <TextBlock Grid.Row="0" Text="{DynamicResource FireSection_BcPreset}" Style="{StaticResource Lbl}"/>
                           <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Cmb}" SelectedValuePath="Tag"
                                     SelectedValue="{Binding BcPreset, ValidatesOnNotifyDataErrors=True}">
                              <ComboBoxItem Tag="manual" Content="{DynamicResource FireSection_BcManual}"/>
                              <ComboBoxItem Tag="1-sided" Content="{DynamicResource FireSection_Bc1Sided}"/>
                              <ComboBoxItem Tag="2-sided" Content="{DynamicResource FireSection_Bc2Sided}"/>
                              <ComboBoxItem Tag="3-sided" Content="{DynamicResource FireSection_Bc3Sided}"/>
                              <ComboBoxItem Tag="all-sided" Content="{DynamicResource FireSection_BcAllSided}"/>
                           </ComboBox>
                           <TextBlock Grid.Row="1" Text="{DynamicResource FireSection_HoleBc}" Style="{StaticResource Lbl}"/>
                           <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Cmb}" SelectedValuePath="Tag"
                                     SelectedValue="{Binding HoleBcPreset, ValidatesOnNotifyDataErrors=True}">
                              <ComboBoxItem Tag="ambient" Content="{DynamicResource FireSection_HoleAmbient}"/>
                              <ComboBoxItem Tag="adiabatic" Content="{DynamicResource FireSection_HoleAdiabatic}"/>
                           </ComboBox>
                           <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{DynamicResource FireSection_ManualHint}" Style="{StaticResource Hint}"/>
                           <DockPanel Grid.Row="3" Grid.ColumnSpan="2">
                              <Button DockPanel.Dock="Right" Content="{DynamicResource FireSection_ResetEdges}"
                                      Command="{Binding ResetEdgesCommand}" Padding="8,2"/>
                              <TextBlock Text="{Binding ManualEdgesText}" VerticalAlignment="Center"/>
                           </DockPanel>
                        </Grid>
                     </GroupBox>

                     <!-- Сетка -->
                     <GroupBox Header="{DynamicResource FireSection_CardMesh}" Style="{StaticResource CardGroupBox}" Margin="0,0,0,8">
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="190"/>
                              <ColumnDefinition Width="*"/>
                           </Grid.ColumnDefinitions>
                           <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                           </Grid.RowDefinitions>
                           <TextBlock Grid.Row="0" Text="{DynamicResource FireSection_MeshStep}" Style="{StaticResource Lbl}"/>
                           <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Fld}"
                                    Text="{Binding MeshStepMmText, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                           <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding MeshWarningText}" Foreground="DarkOrange"
                                      TextWrapping="Wrap" Margin="0,0,0,6"
                                      Visibility="{Binding HasMeshWarning, Converter={StaticResource BoolToVisibility}}"/>
                           <TextBlock Grid.Row="2" Text="{DynamicResource FireSection_Algorithm}" Style="{StaticResource Lbl}"/>
                           <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Cmb}" SelectedValuePath="Tag"
                                     SelectedValue="{Binding Algorithm, ValidatesOnNotifyDataErrors=True}">
                              <ComboBoxItem Tag="ruppert" Content="{DynamicResource FireSection_AlgRuppert}"/>
                              <ComboBoxItem Tag="advancing_front" Content="{DynamicResource FireSection_AlgAdvancingFront}"/>
                           </ComboBox>
                           <TextBlock Grid.Row="3" Text="{DynamicResource FireSection_Smoothing}" Style="{StaticResource Lbl}"/>
                           <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Fld}"
                                    Text="{Binding SmoothingText, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                        </Grid>
                     </GroupBox>

                     <!-- Расчёт по времени -->
                     <GroupBox Header="{DynamicResource FireSection_CardTime}" Style="{StaticResource CardGroupBox}" Margin="0,0,0,8">
                        <StackPanel>
                           <Grid>
                              <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="190"/>
                                 <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                              </Grid.RowDefinitions>
                              <TextBlock Grid.Row="0" Text="{DynamicResource FireSection_TimeStep}" Style="{StaticResource Lbl}"/>
                              <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Fld}"
                                       Text="{Binding TimeStepText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                              <TextBlock Grid.Row="1" Text="{DynamicResource FireSection_SnapshotStep}" Style="{StaticResource Lbl}"/>
                              <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Fld}"
                                       Text="{Binding SnapshotStepText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                           </Grid>
                           <Expander Header="{DynamicResource FireSection_Solver}" IsExpanded="False">
                              <Grid Margin="0,4,0,0">
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="186"/>
                                    <ColumnDefinition Width="*"/>
                                 </Grid.ColumnDefinitions>
                                 <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                 </Grid.RowDefinitions>
                                 <TextBlock Grid.Row="0" Text="{DynamicResource FireSection_Theta}" Style="{StaticResource Lbl}"/>
                                 <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Fld}"
                                          Text="{Binding ThetaText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                                 <TextBlock Grid.Row="1" Text="{DynamicResource FireSection_PicardTol}" Style="{StaticResource Lbl}"/>
                                 <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Fld}"
                                          Text="{Binding PicardTolText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                                 <TextBlock Grid.Row="2" Text="{DynamicResource FireSection_PicardMaxIter}" Style="{StaticResource Lbl}"/>
                                 <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Fld}"
                                          Text="{Binding PicardMaxIterText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                              </Grid>
                           </Expander>
                        </StackPanel>
                     </GroupBox>
                  </StackPanel>
               </ScrollViewer>
            </DockPanel>

            <!-- Справа: превью сечения -->
            <Grid Grid.Column="1" Margin="4,8,8,8">
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
               </Grid.RowDefinitions>

               <TextBlock Grid.Row="0" Text="{DynamicResource FireSection_PreviewTitle}"
                          FontWeight="Bold" Margin="0,0,0,4"/>

               <Border Grid.Row="1" BorderThickness="0,0,0,1"
                       BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                       Padding="0,0,0,4" Margin="0,0,0,4">
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                     </Grid.ColumnDefinitions>
                     <CheckBox Grid.Column="0" Content="{DynamicResource FireSection_ShowMesh}"
                               IsChecked="{Binding Preview.ShowMesh}"
                               Checked="ShowMesh_Changed" Unchecked="ShowMesh_Changed"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                     <CheckBox Grid.Column="1" Content="{DynamicResource FireSection_ShowEdgeLabels}"
                               IsChecked="{Binding Preview.ShowEdgeLabels}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                     <TextBlock Grid.Column="2" Text="{Binding Preview.MeshQualityText}"
                                VerticalAlignment="Center" Foreground="Gray" FontSize="11"
                                TextTrimming="CharacterEllipsis"/>
                     <Button Grid.Column="3" Content="{DynamicResource PlotFitAll}"
                             Command="{Binding Preview.FitAllCommand}" Padding="8,2"/>
                  </Grid>
               </Border>

               <Border Grid.Row="2" BorderThickness="1"
                       BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                   <h:FirePreviewCanvas ViewModel="{Binding Preview}"/>
               </Border>

               <TextBlock Grid.Row="2" Text="{DynamicResource FireSection_NoPreview}"
                          Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding Preview.HasGeometry, Converter={StaticResource InverseBoolToVisibility}}"/>

               <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                  <Ellipse Width="12" Height="12" Fill="#E02020" Margin="0,0,4,0"/>
                  <TextBlock Text="{DynamicResource FireSection_BcFire}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                  <Ellipse Width="12" Height="12" Fill="#2050DC" Margin="0,0,4,0"/>
                  <TextBlock Text="{DynamicResource FireSection_BcAmbient}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                  <Ellipse Width="12" Height="12" Fill="#808080" Margin="0,0,4,0"/>
                  <TextBlock Text="{DynamicResource FireSection_BcAdiabatic}" VerticalAlignment="Center"/>
               </StackPanel>
            </Grid>
         </Grid>
      </TabItem>

      <TabItem x:Name="thermalResultTab" Header="{DynamicResource FireSection_TabThermalResult}">
         <Grid>
            <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
               <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0"
                       Content="{DynamicResource FireThermal_Delete}"
                       Command="{Binding DeleteThermalCommand}"/>
               <TextBlock Text="{Binding ThermalStatusText}" TextWrapping="Wrap">
                  <TextBlock.Style>
                     <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                           <DataTrigger Binding="{Binding ThermalStatusIsProblem}" Value="True">
                              <Setter Property="Foreground" Value="DarkOrange"/>
                              <Setter Property="FontWeight" Value="Bold"/>
                           </DataTrigger>
                        </Style.Triggers>
                     </Style>
                  </TextBlock.Style>
               </TextBlock>
            </DockPanel>
            <ContentControl x:Name="thermalResultHost" Grid.Row="1"/>
         </Grid>
      </TabItem>
   </TabControl>
</UserControl>
