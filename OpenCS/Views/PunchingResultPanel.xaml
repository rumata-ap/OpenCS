<UserControl x:Class="OpenCS.Views.PunchingResultPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:OpenCS.Views.Helpers">
   <!-- Общая панель продавливания: плашка вердикта, рисунок контуров, таблица вариантов, предупреждения.
        DataContext — PunchingResultVM (окно результата и живой пересчёт окна параметров). -->
   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="2*" MinHeight="160"/>
         <RowDefinition Height="5"/>
         <RowDefinition Height="*" MinHeight="90"/>
         <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Вердикт -->
      <Border Grid.Row="0" Padding="12,8" Margin="0,0,0,6" CornerRadius="4" BorderThickness="1"
              BorderBrush="{Binding VerdictBrush}" Background="{Binding VerdictBackground}">
         <StackPanel>
            <TextBlock Text="{Binding VerdictText}" FontWeight="Bold" FontSize="14"
                       Foreground="{Binding VerdictBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#8B0000"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding RatiosText}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#555"/>
         </StackPanel>
      </Border>

      <!-- Рисунок -->
      <Border Grid.Row="1" BorderBrush="#D5DDE5" BorderThickness="1">
         <h:PunchingPlanCanvas Scene="{Binding Scene}" SelectedVariantId="{Binding SelectedVariantId, Mode=TwoWay}"/>
      </Border>

      <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

      <!-- Варианты контура -->
      <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                RowStyle="{StaticResource BatchVerdictRowStyle}"
                AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False">
         <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource PunchingColVariant}" Binding="{Binding Title}" Width="2*">
               <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                     <Style.Triggers>
                        <DataTrigger Binding="{Binding Governs}" Value="True">
                           <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                     </Style.Triggers>
                  </Style>
               </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="u, м" Binding="{Binding U}"/>
            <DataGridTextColumn Header="F, кН" Binding="{Binding F}"/>
            <DataGridTextColumn Header="Fult, кН" Binding="{Binding Fult}"/>
            <DataGridTextColumn Header="Mx,ult, кН·м" Binding="{Binding Mxult}"/>
            <DataGridTextColumn Header="My,ult, кН·м" Binding="{Binding Myult}"/>
            <DataGridTextColumn Header="M*x, кН·м" Binding="{Binding MxStar}"/>
            <DataGridTextColumn Header="M*y, кН·м" Binding="{Binding MyStar}"/>
            <DataGridTextColumn Header="kF" Binding="{Binding KF}"/>
            <DataGridTextColumn Header="kM" Binding="{Binding KM}"/>
            <DataGridTextColumn Header="{DynamicResource PunchingKisp}" Binding="{Binding K}" SortMemberPath="KValue">
               <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                     <Setter Property="FontWeight" Value="SemiBold"/>
                  </Style>
               </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="{DynamicResource PunchingColSw}" Binding="{Binding Sw}"/>
         </DataGrid.Columns>
      </DataGrid>

      <!-- Предупреждения -->
      <Border Grid.Row="4" Padding="8,6" Margin="0,6,0,0" CornerRadius="4"
              Background="#FFF8F0" BorderBrush="#E8D5C0" BorderThickness="1"
              Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
         <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
               <DataTemplate>
                  <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="11" TextWrapping="Wrap" Margin="0,1"/>
               </DataTemplate>
            </ItemsControl.ItemTemplate>
         </ItemsControl>
      </Border>
   </Grid>
</UserControl>
