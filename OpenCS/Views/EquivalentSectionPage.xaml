<UserControl x:Class="OpenCS.Views.EquivalentSectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenCS.ViewModels">
   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
              Padding="8,6">
         <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource Tag}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Tag}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="{DynamicResource RecalculateEquivalentSection}"
                    Command="{Binding RecalculateCommand}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource DeleteEquivalentSection}"
                    Command="{Binding DeleteCommand}"/>
         </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
         <StackPanel Margin="10">
            <GroupBox Header="{DynamicResource EquivalentSectionSource}" Margin="0,0,0,8">
               <Grid Margin="6">
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="190"/>
                     <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="{DynamicResource EquivalentSectionSourceSchema}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceSchemaId}"/>
                  <TextBlock Grid.Row="1" Text="{DynamicResource EquivalentSectionSourceRegion}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SourceRegionId}"/>
                  <TextBlock Grid.Row="2" Text="{DynamicResource EquivalentSectionSourcePlate}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SourcePlateSectionId}"/>
                  <TextBlock Grid.Row="3" Text="{DynamicResource EquivalentSectionSourceKind}"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SourceKindText}"/>
               </Grid>
            </GroupBox>

            <GroupBox Header="{DynamicResource EquivalentSectionGeometry}" Margin="0,0,0,8">
               <Grid Margin="6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="{DynamicResource EquivalentSectionWidth}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WidthM, StringFormat={}{0:G8}}"/>
                  <TextBlock Grid.Row="1" Text="{DynamicResource EquivalentSectionLength}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LengthM, StringFormat={}{0:G8}}"/>
                  <TextBlock Grid.Row="2" Text="{DynamicResource EquivalentSectionStationFraction}"/>
                  <TextBox Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                           Text="{Binding SpanStationFraction, StringFormat={}{0:G4}}"/>
               </Grid>
            </GroupBox>

            <GroupBox Header="{DynamicResource EquivalentSectionPolicy}" Margin="0,0,0,8">
               <Grid Margin="6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="{DynamicResource EquivalentSectionPolicy}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,0,0,4"
                            ItemsSource="{Binding PolicyNames}" SelectedIndex="{Binding PolicyIndex}"/>
                  <TextBlock Grid.Row="1" Text="{DynamicResource EquivalentSectionIntegrationPoints}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WidthIntegrationPoints}"/>
                  <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0"
                            Content="{DynamicResource EquivalentSectionTimoshenko}"
                            IsChecked="{Binding IsTimoshenko}"/>
               </Grid>
            </GroupBox>

            <GroupBox Header="{DynamicResource EquivalentSectionStiffness}" Margin="0,0,0,8">
               <Grid Margin="6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="{DynamicResource EquivalentSectionEA}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EA, StringFormat={}{0:G8}}"/>
                  <TextBlock Grid.Row="1" Text="{DynamicResource EquivalentSectionEIy}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EIy, StringFormat={}{0:G8}}"/>
                  <TextBlock Grid.Row="2" Text="{DynamicResource EquivalentSectionEIz}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EIz, StringFormat={}{0:G8}}"/>
                  <TextBlock Grid.Row="3" Text="{DynamicResource EquivalentSectionGJ}"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GJ, StringFormat={}{0:G8}}"/>
                  <TextBlock Grid.Row="4" Text="{DynamicResource EquivalentSectionGAy}"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GAy, StringFormat={}{0:G8}}"/>
                  <TextBlock Grid.Row="5" Text="{DynamicResource EquivalentSectionGAz}"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding GAz, StringFormat={}{0:G8}}"/>
               </Grid>
            </GroupBox>

            <TextBlock Text="{DynamicResource EquivalentSectionUnitNotice}" Foreground="DarkSlateGray" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource EquivalentSectionNoTorsion}" Foreground="DarkSlateGray" Margin="0,0,0,4" TextWrapping="Wrap"
                       Visibility="{Binding NoTorsionNoticeVisibility}"/>
            <TextBlock Text="{DynamicResource EquivalentSectionKinematicNotice}" Foreground="DarkSlateGray" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <GroupBox Header="{DynamicResource EquivalentSectionMatrix}" Margin="0,0,0,8">
               <DataGrid ItemsSource="{Binding MatrixRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="4">
                  <DataGrid.Columns>
                     <DataGridTextColumn Header="" Binding="{Binding Label}" Width="80"/>
                     <DataGridTextColumn Header="{DynamicResource EquivalentSectionMatrixColumn0}" Binding="{Binding K0, StringFormat={}{0:G8}}" Width="*"/>
                     <DataGridTextColumn Header="{DynamicResource EquivalentSectionMatrixColumn1}" Binding="{Binding K1, StringFormat={}{0:G8}}" Width="*"/>
                     <DataGridTextColumn Header="{DynamicResource EquivalentSectionMatrixColumn2}" Binding="{Binding K2, StringFormat={}{0:G8}}" Width="*"/>
                  </DataGrid.Columns>
               </DataGrid>
            </GroupBox>

            <GroupBox Header="{DynamicResource StripRunGroup}" Margin="0,0,0,8" DataContext="{Binding Run}">
               <StackPanel Margin="6">
                  <TextBlock Text="{DynamicResource StripRunSupports}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                     <TextBlock Text="{DynamicResource StripRunStart}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                     <ComboBox Width="120" ItemsSource="{Binding ConditionNames}"
                               SelectedIndex="{Binding StartConditionIndex}" Margin="0,0,16,0"/>
                     <TextBlock Text="{DynamicResource StripRunEnd}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                     <ComboBox Width="120" ItemsSource="{Binding ConditionNames}"
                               SelectedIndex="{Binding EndConditionIndex}"/>
                  </StackPanel>
                  <CheckBox Content="{DynamicResource StripRunAxialBoth}" IsChecked="{Binding AxialBothEnds}" Margin="0,0,0,8"/>

                  <TextBlock Text="{DynamicResource StripRunLoads}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <DataGrid ItemsSource="{Binding Loads}" AutoGenerateColumns="False" CanUserAddRows="False"
                            HeadersVisibility="Column" Margin="0,0,0,4">
                     <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{DynamicResource StripRunLoadKind}" Width="150">
                           <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                 <ComboBox ItemsSource="{Binding KindNames}" SelectedIndex="{Binding KindIndex}"/>
                              </DataTemplate>
                           </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource StripRunLoadFrom}"
                                            Binding="{Binding FromFraction, StringFormat={}{0:G6}}" Width="*"/>
                        <DataGridTemplateColumn Header="{DynamicResource StripRunLoadTo}" Width="*">
                           <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                 <TextBox Text="{Binding ToFraction, StringFormat={}{0:G6}}" IsEnabled="{Binding ToEnabled}"
                                          BorderThickness="0"/>
                              </DataTemplate>
                           </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource StripRunLoadValue}"
                                            Binding="{Binding Value, StringFormat={}{0:G6}}" Width="*"/>
                        <DataGridTemplateColumn Width="90">
                           <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                 <Button Content="{DynamicResource StripRunRemoveLoad}"
                                         Command="{Binding DataContext.RemoveLoadCommand,
                                                   RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                         CommandParameter="{Binding}"/>
                              </DataTemplate>
                           </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                     </DataGrid.Columns>
                  </DataGrid>
                  <Button Content="{DynamicResource StripRunAddLoad}" Command="{Binding AddLoadCommand}"
                          HorizontalAlignment="Left" Margin="0,0,0,8"/>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                     <TextBlock Text="{DynamicResource StripRunSteps}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                     <TextBox Width="60" Text="{Binding LoadSteps}" Margin="0,0,16,0"/>
                     <TextBlock Text="{DynamicResource StripRunElements}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                     <TextBox Width="60" Text="{Binding ElementCount}"/>
                  </StackPanel>
                  <CheckBox Content="{DynamicResource StripRunFiberCheck}" IsChecked="{Binding FiberCheck}" Margin="0,0,0,8"/>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                     <Button Content="{DynamicResource StripRunRun}" Command="{Binding RunCommand}" Padding="12,3"/>
                     <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                Foreground="DarkSlateGray"/>
                  </StackPanel>

                  <TextBlock Text="{DynamicResource StripRunStale}" Foreground="DarkOrange" TextWrapping="Wrap"
                             Margin="0,0,0,4" Visibility="{Binding StaleVisibility}"/>
                  <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding FiberText}" TextWrapping="Wrap" Margin="0,0,0,8"
                             Visibility="{Binding FiberVisibility}"/>

                  <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                            CanUserAddRows="False" HeadersVisibility="Column" Visibility="{Binding ResultVisibility}">
                     <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource StripRunColX}"
                                            Binding="{Binding X, StringFormat={}{0:F3}}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource StripRunColN}"
                                            Binding="{Binding N, StringFormat={}{0:F2}}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource StripRunColMy}"
                                            Binding="{Binding My, StringFormat={}{0:F2}}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource StripRunColMz}"
                                            Binding="{Binding Mz, StringFormat={}{0:F2}}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource StripRunColW}"
                                            Binding="{Binding W, StringFormat={}{0:F3}}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource StripRunColFiberMy}"
                                            Binding="{Binding FiberMy}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource StripRunColFiberW}"
                                            Binding="{Binding FiberW}" Width="*"/>
                     </DataGrid.Columns>
                  </DataGrid>

                  <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,8,0,0">
                     <ItemsControl.ItemTemplate>
                        <DataTemplate>
                           <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,2"
                                      Foreground="DarkSlateGray"/>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource EquivalentSectionDiagnostics}">
               <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="6">
                  <ItemsControl.ItemTemplate>
                     <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                     </DataTemplate>
                  </ItemsControl.ItemTemplate>
               </ItemsControl>
            </GroupBox>
         </StackPanel>
      </ScrollViewer>
   </Grid>
</UserControl>
