<Window x:Class="OpenCS.Views.FemAreaLoadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FemAreaLoadDialogTitle}" SizeToContent="WidthAndHeight" MinWidth="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="{DynamicResource FemAreaLoadTarget}"/>
        <ComboBox x:Name="targetCombo" SelectedValuePath="Tag" SelectedIndex="0" Margin="0,2,0,4" SelectionChanged="TargetChanged">
            <ComboBoxItem Tag="selection" Content="{DynamicResource FemAreaLoadTargetSelection}"/>
            <ComboBoxItem Tag="group" Content="{DynamicResource FemAreaLoadTargetGroupItem}"/>
            <ComboBoxItem Tag="list" Content="{DynamicResource FemAreaLoadTargetList}"/>
        </ComboBox>
        <ComboBox x:Name="groupCombo" DisplayMemberPath="Tag" Visibility="Collapsed" Margin="0,0,0,4"/>
        <TextBox x:Name="tagsBox" Visibility="Collapsed" Margin="0,0,0,4" ToolTip="{DynamicResource FemAreaLoadTagsHint}"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="{DynamicResource FemAreaLoadValue}"/>
                <TextBox x:Name="valueBox" Text="-1"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Text="{DynamicResource FemAreaLoadDirection}"/>
                <ComboBox x:Name="directionCombo" SelectedValuePath="Tag" SelectedIndex="2">
                    <ComboBoxItem Tag="global:x" Content="X"/>
                    <ComboBoxItem Tag="global:y" Content="Y"/>
                    <ComboBoxItem Tag="global:z" Content="Z"/>
                    <ComboBoxItem Tag="local:z" Content="{DynamicResource FemAreaLoadDirNormal}"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        <TextBlock Text="{DynamicResource FemAreaLoadSignHint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" MaxWidth="320" Margin="1,4,1,4"/>
        <TextBlock x:Name="errorText" Foreground="#B00020" TextWrapping="Wrap" MaxWidth="320" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource OK}" IsDefault="True" Width="80" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Cancel}" IsCancel="True" Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>
