<UserControl x:Class="OpenCS.Views.ShellLayeredSlsBatchResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <Grid Margin="16">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,8">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
            <ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/>
         </Grid.ColumnDefinitions>
         <TextBlock Grid.Column="0" Text="{DynamicResource ShellLayeredSlsBatchNumColumn}" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="1" Text="{DynamicResource ShellLayeredSlsBatchLabelColumn}" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="2" Text="{DynamicResource ShellLayeredSlsBatchStatusColumn}" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="3" Text="{DynamicResource ShellLayeredSlsBatchAcrcColumn}" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="4" Text="{DynamicResource ShellLayeredSlsBatchAngleColumn}" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="5" Text="{DynamicResource ShellLayeredSlsBatchDirFaceColumn}" FontWeight="SemiBold"/>
      </Grid>
      <ListBox Grid.Row="1" x:Name="RowsList" ItemsSource="{Binding Rows}" SelectionMode="Single"
               HorizontalContentAlignment="Stretch" BorderThickness="0"
               MouseDoubleClick="RowsList_MouseDoubleClick">
         <ListBox.ContextMenu>
            <ContextMenu>
               <MenuItem Header="{DynamicResource CalcTaskNew}" Click="CreateTask_Click"/>
            </ContextMenu>
         </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
               <DataTemplate>
                  <Border Padding="4" Margin="0,0,0,2" BorderBrush="#E0E0E0" BorderThickness="1">
                     <Grid>
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
                           <ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Num}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Label}"/>
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}"/>
                        <TextBlock Grid.Column="3" Text="{Binding AcrcText}"/>
                        <TextBlock Grid.Column="4" Text="{Binding AngleText}"/>
                        <TextBlock Grid.Column="5" Text="{Binding DirectionFaceText}"/>
                     </Grid>
                  </Border>
               </DataTemplate>
            </ListBox.ItemTemplate>
      </ListBox>

      <!-- Кнопки внизу -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
         <Button Content="{DynamicResource CalcTaskNew}" Click="CreateTask_Click"
                 Padding="12,4" x:Name="CreateTaskBtn" IsEnabled="False"/>
      </StackPanel>
   </Grid>
</UserControl>
