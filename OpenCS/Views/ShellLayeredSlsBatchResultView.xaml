<UserControl x:Class="OpenCS.Views.ShellLayeredSlsBatchResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:OpenCS.Views">
   <Grid Margin="16">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="{Binding SummaryText}" FontWeight="SemiBold" Margin="0,0,0,8"/>

      <DockPanel Grid.Row="1">
         <v:BatchVerdictFilterBar DockPanel.Dock="Top" Target="{Binding ElementName=RowsGrid}"/>
         <DataGrid x:Name="RowsGrid" RowStyle="{StaticResource BatchVerdictRowStyle}" ItemsSource="{Binding Rows}"
                   AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                   CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow"
                   MouseDoubleClick="RowsGrid_MouseDoubleClick">
            <DataGrid.ContextMenu>
               <ContextMenu>
                  <MenuItem Header="{DynamicResource CalcTaskNew}" Click="CreateTask_Click"/>
               </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
               <DataGridTextColumn Header="{DynamicResource ShellLayeredSlsBatchNumColumn}" Binding="{Binding Num}" Width="50"/>
               <DataGridTextColumn Header="{DynamicResource ShellLayeredSlsBatchElemColumn}" Binding="{Binding ElemText}"
                                   SortMemberPath="Elem" Width="60"/>
               <DataGridTextColumn Header="{DynamicResource ShellLayeredSlsBatchLabelColumn}" Binding="{Binding Label}" Width="*"/>
               <DataGridTextColumn Header="{DynamicResource ShellLayeredSlsBatchStatusColumn}" Binding="{Binding StatusText}" Width="90"/>
               <DataGridTextColumn Header="{DynamicResource ShellLayeredSlsBatchAcrcColumn}" Binding="{Binding AcrcText}"
                                   SortMemberPath="AcrcValue" Width="80"/>
               <DataGridTextColumn Header="{DynamicResource BatchVerdictColUtil}" Binding="{Binding Reason.UtilText}"
                                   SortMemberPath="Reason.SortUtil" Width="60"/>
               <DataGridTextColumn Header="{DynamicResource ShellLayeredSlsBatchAngleColumn}" Binding="{Binding AngleText}" Width="70"/>
               <DataGridTextColumn Header="{DynamicResource ShellLayeredSlsBatchDirFaceColumn}" Binding="{Binding DirectionFaceText}" Width="100"/>
               <DataGridTextColumn Header="{DynamicResource BatchVerdictColReason}" Binding="{Binding Reason.ReasonText}" Width="2*"/>
            </DataGrid.Columns>
         </DataGrid>
      </DockPanel>

      <!-- Кнопки внизу -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
         <Button Content="{DynamicResource CalcTaskNew}" Click="CreateTask_Click"
                 Padding="12,4" x:Name="CreateTaskBtn" IsEnabled="False"/>
      </StackPanel>
   </Grid>
</UserControl>
