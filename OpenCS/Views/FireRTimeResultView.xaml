<UserControl x:Class="OpenCS.Views.FireRTimeResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenCS.Views">

   <Grid Margin="12">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="180"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="8,6" Margin="0,0,0,8"
              Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
         <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource FireRTime_RMin}" Foreground="Gray"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding RMinText}" FontSize="16" FontWeight="Bold"/>
         </StackPanel>
      </Border>

      <TextBlock Grid.Row="1" Text="{Binding StatusNote}" Foreground="DarkRed"
                 TextWrapping="Wrap" Margin="0,0,0,6"
                 Visibility="{Binding HasStatusNote, Converter={StaticResource BoolToVisibility}}"/>
      <TextBlock Grid.Row="2" Text="{Binding RefinementText}" Foreground="Gray"
                 TextWrapping="Wrap" Margin="0,0,0,6"/>

      <Grid Grid.Row="3" Margin="0,0,0,8"
            Visibility="{Binding HasFactorChart, Converter={StaticResource BoolToVisibility}}">
         <local:FireChartView DataContext="{Binding FactorChart}"/>
      </Grid>

      <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
         <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource FireRTime_ColTime}" Binding="{Binding TimeText}" Width="100"/>
            <DataGridTextColumn Header="{DynamicResource FireRTime_ColFactor}" Binding="{Binding FactorText}" Width="140"/>
            <DataGridTextColumn Header="{DynamicResource FireRTime_ColGoverning}" Binding="{Binding GoverningText}" Width="*"/>
         </DataGrid.Columns>
      </DataGrid>
   </Grid>
</UserControl>
