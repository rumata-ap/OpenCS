<Window x:Class="OpenCS.Views.FemMemberRotationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FemMemberRotationTitle}"
        Width="300" MinWidth="260" MinHeight="140" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="{DynamicResource FemMemberRotationDeg}"/>
        <TextBox x:Name="angleBox" Margin="0,2,0,6"/>
        <TextBlock Text="{DynamicResource FemMemberRotationConventionHint}"
                   Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource FemMemberRotationApply}" Click="Apply_Click" IsDefault="True" Padding="12,4" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Close}" Click="Close_Click" IsCancel="True" Padding="12,4"/>
        </StackPanel>
    </StackPanel>
</Window>
