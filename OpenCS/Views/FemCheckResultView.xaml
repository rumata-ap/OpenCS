<UserControl x:Class="OpenCS.Views.FemCheckResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Раскраска строки по состоянию: прошла / не прошла / не проверена -->
        <Style x:Key="StateRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="ok">
                    <Setter Property="Background" Value="#1A2D7A3E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="failed">
                    <Setter Property="Background" Value="#1AC0392B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="not_checked">
                    <Setter Property="Background" Value="#26E6AA28"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Сводка -->
        <Border Grid.Row="0" Padding="8,6" Margin="0,0,0,6" CornerRadius="4"
                Background="{Binding SummaryBrush}">
            <TextBlock Text="{Binding SummaryText}" FontWeight="Bold"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </Border>

        <!-- Пропущенные строки, непокрытые КЭ, предупреждения -->
        <TextBlock Grid.Row="1" Text="{Binding DetailsText}" TextWrapping="Wrap" Foreground="Gray"
                   Margin="0,0,0,6" Visibility="{Binding DetailsVisibility}"/>

        <!-- Фильтры -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <CheckBox Content="{DynamicResource FemCheckResultOnlyFailed}"
                      IsChecked="{Binding OnlyFailed}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ElementFilterText}" VerticalAlignment="Center" Margin="16,0,8,0"
                       Visibility="{Binding ElementFilterVisibility}"/>
            <Button Content="{DynamicResource FemCheckResultAllElements}" Padding="8,1"
                    Command="{Binding ClearElementFilterCommand}"
                    Visibility="{Binding ElementFilterVisibility}"/>
        </StackPanel>

        <TabControl Grid.Row="3" x:Name="Tabs">
            <!-- По КЭ -->
            <TabItem Header="{DynamicResource FemCheckResultTabElements}"
                     Visibility="{Binding ElementsTabVisibility}">
                <DataGrid x:Name="ElementsGrid" ItemsSource="{Binding Elements}" IsReadOnly="True"
                          SelectedItem="{Binding SelectedElement}" SelectionMode="Single"
                          AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                          CanUserSortColumns="True" RowStyle="{StaticResource StateRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultElem}"
                                            Binding="{Binding ElemText}" SortMemberPath="ElemNum" Width="70"/>
                        <DataGridTextColumn x:Name="ElemSectionColumn"
                                            Header="{DynamicResource FemCheckResultSection}"
                                            Binding="{Binding SectionLabel}" Width="150"/>
                        <!-- столбцы коэффициента использования по источникам добавляются в коде -->
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultForceSet}"
                                            Binding="{Binding ForceSetTag}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultLabel}"
                                            Binding="{Binding Label}" Width="110"/>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultWorstCheck}"
                                            Binding="{Binding WorstCheckText}" Width="220"/>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultRows}"
                                            Binding="{Binding Rows}" Width="60"/>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultNotChecked}"
                                            Binding="{Binding NotChecked}" Width="90"/>
                        <DataGridTextColumn x:Name="AsSelectedColumn"
                                            Header="{DynamicResource FemCheckResultAsSelected}"
                                            Binding="{Binding AsSelectedText}" Width="100"/>
                        <DataGridTextColumn x:Name="AsProvidedColumn"
                                            Header="{DynamicResource FemCheckResultAsProvided}"
                                            Binding="{Binding AsProvidedText}" Width="100"/>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultStatus}"
                                            Binding="{Binding StatusText}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Все строки -->
            <TabItem Header="{DynamicResource FemCheckResultTabRows}">
                <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True"
                          AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                          CanUserSortColumns="True" RowStyle="{StaticResource StateRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="RowElemColumn"
                                            Header="{DynamicResource FemCheckResultElem}"
                                            Binding="{Binding ElemNum}" Width="70"/>
                        <DataGridTextColumn x:Name="RowSectionNumColumn"
                                            Header="{DynamicResource FemCheckResultSecNum}"
                                            Binding="{Binding SectionNum}" Width="50"/>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultLabel}"
                                            Binding="{Binding Label}" Width="110"/>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultForceSet}"
                                            Binding="{Binding ForceSetTag}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultCalcType}"
                                            Binding="{Binding CalcType}" Width="50"/>
                        <DataGridTextColumn x:Name="RowSectionColumn"
                                            Header="{DynamicResource FemCheckResultSection}"
                                            Binding="{Binding SectionLabel}" Width="150"/>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultUtil}"
                                            Binding="{Binding UtilText}" SortMemberPath="Utilization" Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultWorstCheck}"
                                            Binding="{Binding WorstCheckText}" Width="220"/>
                        <DataGridTextColumn Header="{DynamicResource FemCheckResultStatus}"
                                            Binding="{Binding StatusText}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
