<UserControl x:Class="OpenCS.Views.ShearInclinedResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:OpenCS.Views.Helpers">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding SectionTag}"/>
            <TextBlock Text="{Binding ForceLabel}" Margin="0,2,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- Исходные данные -->
        <Border Grid.Row="1" Padding="8,6" Margin="0,0,0,8" CornerRadius="4"
                Background="#F0F4F8" BorderBrush="#D5DDE5" BorderThickness="1">
            <StackPanel>
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#555"
                           Text="{DynamicResource ShearInclinedInputsTitle}"/>
                <TextBlock FontSize="12" Text="{Binding InputsSummary}" Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Вердикт -->
        <Border Grid.Row="2" Padding="12,8" Margin="0,0,0,8" CornerRadius="4"
                BorderBrush="#D5DDE5" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding VerdictText}" HorizontalAlignment="Center"
                           FontWeight="Bold" FontSize="14" Foreground="{Binding VerdictBrush}"/>
                <TextBlock Text="{Binding ExactUtilizationText}" HorizontalAlignment="Center"
                           FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Оговорки -->
        <Border Grid.Row="3" Padding="8,6" Margin="0,0,0,8" CornerRadius="4"
                Background="#FFF8F0" BorderBrush="#E8D5C0" BorderThickness="1"
                Visibility="{Binding CautionsVisibility}">
            <StackPanel>
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#555"
                           Text="{DynamicResource ShearInclinedCautionsTitle}"/>
                <ItemsControl ItemsSource="{Binding Cautions}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{DynamicResource ExportCsvBtn}" Padding="12,4" Click="ExportCsv_Click"/>
            <Button Content="{DynamicResource ShearInclinedShowProjection}" Padding="12,4"
                    Margin="8,0,0,0" Click="ShowProjection_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Группы проверок -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="True" Margin="0,0,0,8">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding MaxRatioText}" Margin="12,0,0,0"
                                                   FontWeight="SemiBold" Foreground="{Binding MaxRatioBrush}"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="4,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="4"
                                                    Background="{Binding RowBackground}"
                                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontWeight="Bold" Foreground="#2C3E50"
                                                                   Text="{Binding Title}"/>
                                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                                                   Margin="8,0,0,0"/>
                                                        <TextBlock Margin="12,0,0,0" Foreground="#555">
                                                            <Run Text="{Binding AppliedText, Mode=OneWay}"/>
                                                            <Run Text=" ≤ "/>
                                                            <Run Text="{Binding AllowableText, Mode=OneWay}"/>
                                                            <Run Text="  →  "/>
                                                        </TextBlock>
                                                        <TextBlock FontWeight="Bold" Foreground="{Binding RatioBrush}"
                                                                   Text="{Binding RatioText}"/>
                                                        <TextBlock Margin="8,0,0,0" FontWeight="Bold"
                                                                   Foreground="{Binding RatioBrush}"
                                                                   Text="{Binding PassedText}"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Foreground="#888" Margin="0,2,0,0"
                                                               Text="{Binding NormRef}"/>
                                                    <TextBlock FontSize="11" Foreground="#6A5ACD" Margin="0,2,0,0"
                                                               Text="{Binding Trace}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- График коэффициента использования по длине -->
                <TextBlock Text="{DynamicResource ShearInclinedEtaChartTitle}"
                           FontWeight="SemiBold" Margin="0,8,0,4"/>
                <Border BorderBrush="#D5DDE5" BorderThickness="1" CornerRadius="4" Height="180">
                    <helpers:ShearInclinedEtaCanvas x:Name="EtaCanvas" Background="White"/>
                </Border>

                <!-- Таблица стоянок -->
                <TextBlock Text="{DynamicResource ShearInclinedStationsTitle}"
                           FontWeight="SemiBold" Margin="0,12,0,4"/>
                <DataGrid x:Name="StationsGrid" ItemsSource="{Binding Stations}"
                          AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnPlane}"
                                            Binding="{Binding Plane}"/>
                        <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnS}"
                                            Binding="{Binding S, StringFormat=F3}"/>
                        <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnTensionSide}"
                                            Binding="{Binding TensionSideText}"/>
                        <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnQ}"
                                            Binding="{Binding Q, StringFormat=F1}"/>
                        <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnQb}"
                                            Binding="{Binding Qb, StringFormat=F1}"/>
                        <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnQsw}"
                                            Binding="{Binding Qsw, StringFormat=F1}"/>
                        <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnC}"
                                            Binding="{Binding CriticalC, StringFormat=F3}"/>
                        <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnEta}"
                                            Binding="{Binding Eta, StringFormat=F3}"/>
                        <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnMApplied}"
                                            Binding="{Binding MomentApplied, StringFormat=F1}"/>
                        <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnCMoment}"
                                            Binding="{Binding CriticalCMoment, StringFormat=F3}"/>
                        <DataGridTextColumn Header="{DynamicResource ShearInclinedColumnEtaM}"
                                            Binding="{Binding EtaM, StringFormat=F3}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
