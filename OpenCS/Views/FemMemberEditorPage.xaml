<UserControl x:Class="OpenCS.Views.FemMemberEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenCS.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Ширина панели свойств меняется разделителем (длинные подписи параметров СП 16) -->
            <ColumnDefinition x:Name="colEditor" Width="360" MinWidth="280"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"
                      Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>

        <!-- Левая панель: редактор свойств FemMember -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Tag}"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox   Grid.Row="0" Grid.Column="1"
                           Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource FemMemberType}"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox  Grid.Row="1" Grid.Column="1"
                           ItemsSource="{Binding MemberTypes}"
                           DisplayMemberPath="Name"
                           SelectedValuePath="Code"
                           SelectedValue="{Binding MemberType}"
                           Visibility="{Binding CanChooseType, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,0,0,8"/>
                <!-- Группа КЭ импортированной схемы: вид — по составу, тип не выбирается -->
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Composition}"
                           Visibility="{Binding CanChooseType, Converter={StaticResource InverseBoolToVisibility}}"
                           VerticalAlignment="Center" Foreground="Gray" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource CalcTaskSection}"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox  Grid.Row="2" Grid.Column="1"
                           ItemsSource="{Binding AllSections}"
                           SelectedItem="{Binding SelectedSection}"
                           DisplayMemberPath="Tag"
                           Margin="0,0,0,8"/>


                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource CalcTaskForceSet}"
                           VerticalAlignment="Center" Margin="0,0,8,4"
                           Visibility="{Binding CanBindForceSet, Converter={StaticResource BoolToVisibility}}"/>
                <ComboBox  Grid.Row="3" Grid.Column="1"
                           Visibility="{Binding CanBindForceSet, Converter={StaticResource BoolToVisibility}}"
                           ItemsSource="{Binding AllForceSets}"
                           SelectedItem="{Binding SelectedForceSet}"
                           DisplayMemberPath="Tag"
                           Margin="0,0,0,4"/>

                <CheckBox  Grid.Row="4" Grid.Column="1"
                           Visibility="{Binding CanBindForceSet, Converter={StaticResource BoolToVisibility}}"
                           IsChecked="{Binding ShowAllForceSets}"
                           Content="{DynamicResource FemMemberShowAllForceSets}"
                           Margin="0,0,0,8" FontSize="11" Foreground="Gray"/>

                <GroupBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                          Header="{DynamicResource SteelCheckParamsHeader}" Margin="0,4,0,0"
                          Visibility="{Binding ShowSteelParams, Converter={StaticResource BoolToVisibility}}">
                    <local:SteelDesignParamsEditor DataContext="{Binding SteelEditor}" LabelWidth="180" Margin="4"/>
                </GroupBox>

                <!-- Продольный изгиб / расчётные длины проверок группы — тот же блок, что в диалоге проверки -->
                <GroupBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                          Header="{DynamicResource FemGroupCheckParams}" Margin="0,8,0,0"
                          ToolTip="{DynamicResource FemGroupCheckHint}"
                          Visibility="{Binding HasChecks, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="4">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource FemGroupCheckLabel}" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Checks}" SelectedItem="{Binding SelectedCheck}"
                                      DisplayMemberPath="DisplayTag"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Buckling.Header}" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Visibility="{Binding Buckling.Visibility}"/>
                        <local:FemCheckBucklingEditor DataContext="{Binding Buckling}"/>
                        <Button Content="{DynamicResource FemGroupCheckSaveRun}" Command="{Binding SaveRunCheckCommand}"
                                HorizontalAlignment="Right" Padding="8,2" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <Button Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="{DynamicResource Save}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Right" Width="100"/>
            </Grid>
        </ScrollViewer>

        <!-- Правая панель: 3D-вид с переключателем режима -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ToolBar Grid.Row="0">
                <RadioButton x:Name="rbIsolated" Content="{DynamicResource Fem3DViewIsolated}"
                             IsChecked="True" GroupName="ViewMode"
                             VerticalAlignment="Center" Margin="4,0"
                             Checked="ViewMode_Changed"/>
                <RadioButton x:Name="rbSchema" Content="{DynamicResource Fem3DViewSchema}"
                             GroupName="ViewMode"
                             VerticalAlignment="Center" Margin="4,0"
                             Checked="ViewMode_Changed"/>
            </ToolBar>
            <local:FemSchemaView3D x:Name="view3D" Grid.Row="1"/>
        </Grid>
    </Grid>
</UserControl>
