<UserControl x:Class="OpenCS.Views.FemCsfeaBatchProblemBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Плашка пакетного результата CSfea: не дошедшие до предела λ и не посчитанные варианты, «Показать» (сводка пакета
         с фильтром), «Новый пакет из недошедших…». DataContext — FemCsfeaResultVM. Общая для окна результата и 3D-вида. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Border Background="#FFF1DC" BorderBrush="#E8A33D" BorderThickness="1" CornerRadius="3" Padding="6,2"
            Visibility="{Binding HasBatchProblems, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="⚠" Foreground="#B05A00" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding BatchProblemText}" Foreground="#8A4700" VerticalAlignment="Center"/>
            <Button Content="{DynamicResource FemCsfeaBatchShowProblems}" Click="Show_Click" Padding="8,0" Margin="8,0,0,0"
                    VerticalAlignment="Center" ToolTip="{DynamicResource FemCsfeaBatchShowProblemsTip}"/>
            <Button Content="{DynamicResource FemCsfeaBatchNewFromProblems}" Click="NewBatch_Click" Padding="8,0" Margin="4,0,0,0"
                    VerticalAlignment="Center" IsEnabled="{Binding CanNewBatchFromProblems}"
                    ToolTip="{DynamicResource FemCsfeaBatchNewFromProblemsTip}" ToolTipService.ShowOnDisabled="True"/>
        </StackPanel>
    </Border>
</UserControl>
