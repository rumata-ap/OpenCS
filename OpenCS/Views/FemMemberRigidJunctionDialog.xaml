<Window x:Class="OpenCS.Views.FemMemberRigidJunctionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FemMemberRigidJunctionTitle}"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="targetText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <GroupBox Header="{DynamicResource FemMemberRigidJunctionMode}" Margin="0,0,0,6">
            <StackPanel Margin="4">
                <RadioButton x:Name="autoRadio" GroupName="mode" Content="{DynamicResource FemMemberRigidJunctionModeAuto}" Margin="0,0,0,2"/>
                <RadioButton x:Name="offRadio" GroupName="mode" Content="{DynamicResource FemMemberRigidJunctionModeOff}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="{DynamicResource FemMemberRigidJunctionKind}" Margin="0,0,0,6">
            <StackPanel Margin="4">
                <RadioButton x:Name="rigidRadio" GroupName="kind" Content="{DynamicResource FemMemberRigidJunctionKindRigid}" Margin="0,0,0,2"/>
                <RadioButton x:Name="coupledRadio" GroupName="kind" Content="{DynamicResource FemMemberRigidJunctionKindCoupled}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="{DynamicResource FemMemberRigidJunctionDofs}" Margin="0,0,0,6">
            <UniformGrid Columns="6" Margin="4">
                <CheckBox x:Name="dofX" Content="X"/>
                <CheckBox x:Name="dofY" Content="Y"/>
                <CheckBox x:Name="dofZ" Content="Z"/>
                <CheckBox x:Name="dofUX" Content="UX"/>
                <CheckBox x:Name="dofUY" Content="UY"/>
                <CheckBox x:Name="dofUZ" Content="UZ"/>
            </UniformGrid>
        </GroupBox>
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="resetTraceButton" DockPanel.Dock="Right" Content="{DynamicResource FemMemberRigidJunctionTraceReset}"
                    Padding="8,1" Click="ResetTrace_Click"/>
            <TextBlock x:Name="traceText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
        </DockPanel>
        <TextBlock Text="{DynamicResource FemMemberRigidJunctionHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="72" IsDefault="True" Click="Apply_Click" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Cancel}" Width="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
