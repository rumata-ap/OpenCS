<Window x:Class="OpenCS.Views.Dialogs.DoubleInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="Label1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,4"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="Value1Box" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="Error1" Foreground="#B91C1C"
                   TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>

        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="Label2" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,4"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="Value2Box" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="Error2" Foreground="#B91C1C"
                   TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource OK}" IsDefault="True" Click="Ok_Click" Width="90" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Cancel}" IsCancel="True" Width="90"/>
        </StackPanel>
    </Grid>
</Window>
