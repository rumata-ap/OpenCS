<Window x:Class="OpenCS.Views.PunchingParamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:OpenCS.Views"
        xmlns:u="clr-namespace:OpenCS.Utilites"
        Title="{DynamicResource PunchingParamsTitle}"
        Width="1320" Height="880" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
   <Window.Resources>
      <!-- Строгий разбор: «1.05.05» — красная рамка и запрет сохранения, а не молчаливое прежнее значение -->
      <u:StrictDoubleConverter x:Key="AnyDoubleConv"/>
      <Style x:Key="Num" TargetType="TextBox">
         <EventSetter Event="GotKeyboardFocus" Handler="NumBox_GotKeyboardFocus"/>
         <EventSetter Event="PreviewMouseLeftButtonDown" Handler="NumBox_PreviewMouseLeftButtonDown"/>
         <Setter Property="Width" Value="80"/>
         <Setter Property="Margin" Value="0,2,4,2"/>
         <Setter Property="HorizontalContentAlignment" Value="Right"/>
         <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style x:Key="Lbl" TargetType="TextBlock">
         <Setter Property="VerticalAlignment" Value="Center"/>
         <Setter Property="Margin" Value="0,2,8,2"/>
      </Style>
      <Style x:Key="Unit" TargetType="TextBlock">
         <Setter Property="VerticalAlignment" Value="Center"/>
         <Setter Property="Foreground" Value="#666"/>
         <Setter Property="Margin" Value="0,2,10,2"/>
      </Style>
      <Style x:Key="Hint" TargetType="TextBlock">
         <Setter Property="Foreground" Value="#555"/>
         <Setter Property="TextWrapping" Value="Wrap"/>
         <Setter Property="Margin" Value="0,3,0,2"/>
      </Style>
      <Style TargetType="Expander">
         <Setter Property="Margin" Value="0,0,0,6"/>
         <Setter Property="IsExpanded" Value="True"/>
         <Setter Property="Padding" Value="6,4,4,4"/>
      </Style>
      <Style TargetType="ComboBox">
         <Setter Property="Margin" Value="0,2,4,2"/>
         <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style TargetType="CheckBox">
         <Setter Property="Margin" Value="0,4,0,2"/>
         <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
   </Window.Resources>

   <Grid Margin="10">
      <Grid.ColumnDefinitions>
         <ColumnDefinition Width="460" MinWidth="380"/>
         <ColumnDefinition Width="6"/>
         <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ── Форма ─────────────────────────────────────────────── -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
         <StackPanel>

            <!-- Площадь -->
            <Expander Header="{DynamicResource PunchingGroupArea}">
               <StackPanel>
                  <!-- Вид узла: колонна или пилон, торец стены, угол стен (СП 430 п. 6.3.8) -->
                  <StackPanel Orientation="Horizontal">
                     <TextBlock Text="{DynamicResource PunchingNodeKind}" Style="{StaticResource Lbl}"/>
                     <ComboBox Width="280" ItemsSource="{Binding NodeKinds}" DisplayMemberPath="Label"
                               SelectedValuePath="Id" SelectedValue="{Binding NodeKind}"/>
                  </StackPanel>
                  <StackPanel Visibility="{Binding IsWallNode, Converter={StaticResource BoolToVisibility}}">
                     <WrapPanel>
                        <TextBlock Text="a1" Style="{StaticResource Lbl}" ToolTip="{DynamicResource PunchingWallA1Hint}"/>
                        <TextBox Style="{StaticResource Num}" ToolTip="{DynamicResource PunchingWallA1Hint}"
                                 Text="{Binding WallA1, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsWallCorner, Converter={StaticResource BoolToVisibility}}">
                           <TextBlock Text="a2" Style="{StaticResource Lbl}" ToolTip="{DynamicResource PunchingWallA2Hint}"/>
                           <TextBox Style="{StaticResource Num}" ToolTip="{DynamicResource PunchingWallA2Hint}"
                                    Text="{Binding WallA2, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                           <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                        </StackPanel>
                     </WrapPanel>
                     <TextBlock Text="{DynamicResource PunchingWallEndHint}" Style="{StaticResource Hint}"
                                Visibility="{Binding IsWallEnd, Converter={StaticResource BoolToVisibility}}"/>
                     <TextBlock Text="{DynamicResource PunchingWallCornerHint}" Style="{StaticResource Hint}"
                                Visibility="{Binding IsWallCorner, Converter={StaticResource BoolToVisibility}}"/>
                  </StackPanel>
                  <StackPanel Visibility="{Binding IsColumnNode, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                     <TextBlock Text="{DynamicResource PunchingAreaShape}" Style="{StaticResource Lbl}"/>
                     <ComboBox Width="180" ItemsSource="{Binding AreaShapes}" DisplayMemberPath="Label"
                               SelectedValuePath="Id" SelectedValue="{Binding AreaShape}"/>
                  </StackPanel>
                  <WrapPanel Visibility="{Binding IsRectangle, Converter={StaticResource BoolToVisibility}}">
                     <TextBlock Text="bx" Style="{StaticResource Lbl}"/>
                     <TextBox Style="{StaticResource Num}" Text="{Binding Bx, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                     <TextBlock Text="by" Style="{StaticResource Lbl}"/>
                     <TextBox Style="{StaticResource Num}" Text="{Binding By, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                  </WrapPanel>
                  <WrapPanel Visibility="{Binding IsRound, Converter={StaticResource BoolToVisibility}}">
                     <TextBlock Text="D" Style="{StaticResource Lbl}"/>
                     <TextBox Style="{StaticResource Num}" Text="{Binding D, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                     <TextBlock Text="t" Style="{StaticResource Lbl}" Visibility="{Binding IsRing, Converter={StaticResource BoolToVisibility}}"/>
                     <TextBox Style="{StaticResource Num}" Visibility="{Binding IsRing, Converter={StaticResource BoolToVisibility}}"
                              Text="{Binding T, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="мм" Style="{StaticResource Unit}" Visibility="{Binding IsRing, Converter={StaticResource BoolToVisibility}}"/>
                  </WrapPanel>
                  <StackPanel Visibility="{Binding IsPolygon, Converter={StaticResource BoolToVisibility}}">
                     <TextBlock Text="{DynamicResource PunchingPolygonHint}" Style="{StaticResource Hint}"/>
                     <DataGrid ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}" AutoGenerateColumns="False"
                               CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="160" Margin="0,2">
                        <DataGrid.Columns>
                           <DataGridTextColumn Header="x, мм" Width="*" Binding="{Binding X, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=LostFocus}"/>
                           <DataGridTextColumn Header="y, мм" Width="*" Binding="{Binding Y, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=LostFocus}"/>
                        </DataGrid.Columns>
                     </DataGrid>
                     <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource PunchingAdd}" Command="{Binding AddPointCommand}" Padding="10,2" Margin="0,2,6,2"/>
                        <Button Content="{DynamicResource PunchingRemove}" Command="{Binding RemovePointCommand}" Padding="10,2" Margin="0,2"/>
                     </StackPanel>
                  </StackPanel>
                  <TextBlock Text="{DynamicResource PunchingWallRatioHint}" Style="{StaticResource Hint}" Foreground="#9A5B00"
                             Visibility="{Binding ShowWallHint, Converter={StaticResource BoolToVisibility}}"/>
                  </StackPanel>
               </StackPanel>
            </Expander>

            <!-- Плита -->
            <Expander Header="{DynamicResource PunchingGroupSlab}">
               <StackPanel>
                  <WrapPanel>
                     <TextBlock Text="h" Style="{StaticResource Lbl}"/>
                     <TextBox Style="{StaticResource Num}" Text="{Binding H, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                     <TextBlock Text="ax" Style="{StaticResource Lbl}" ToolTip="{DynamicResource PunchingAxHint}"/>
                     <TextBox Style="{StaticResource Num}" Width="60" ToolTip="{DynamicResource PunchingAxHint}"
                              Text="{Binding Ax, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                     <TextBlock Text="ay" Style="{StaticResource Lbl}" ToolTip="{DynamicResource PunchingAyHint}"/>
                     <TextBox Style="{StaticResource Num}" Width="60" ToolTip="{DynamicResource PunchingAyHint}"
                              Text="{Binding Ay, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding H0Text}" Style="{StaticResource Hint}"/>
                  <StackPanel Orientation="Horizontal">
                     <TextBlock Text="{DynamicResource PunchingConcrete}" Style="{StaticResource Lbl}"/>
                     <ComboBox Width="200" ItemsSource="{Binding Concretes}" DisplayMemberPath="Tag" SelectedItem="{Binding Concrete}"
                               IsEnabled="{Binding RbtManual, Converter={StaticResource InverseBool}}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                     <CheckBox Content="{DynamicResource PunchingRbtManual}" IsChecked="{Binding RbtManual}" Margin="0,4,8,2"/>
                     <TextBox Style="{StaticResource Num}" IsEnabled="{Binding RbtManual}"
                              Text="{Binding RbtManualValue, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="МПа" Style="{StaticResource Unit}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding RbtText}" Style="{StaticResource Hint}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                     <TextBlock Text="{DynamicResource PunchingFromPlateSection}" Style="{StaticResource Lbl}"/>
                     <ComboBox Width="160" ItemsSource="{Binding PlateSections}" DisplayMemberPath="Tag" SelectedItem="{Binding SelectedPlateSection}"/>
                     <Button Content="{DynamicResource PunchingTake}" Command="{Binding TakeFromPlateSectionCommand}" Padding="10,2"
                             ToolTip="{DynamicResource PunchingFromPlateSectionHint}"/>
                  </StackPanel>
               </StackPanel>
            </Expander>

            <!-- Положение -->
            <Expander Header="{DynamicResource PunchingGroupPosition}">
               <StackPanel>
                  <StackPanel Orientation="Horizontal">
                     <TextBlock Text="{DynamicResource PunchingPosition}" Style="{StaticResource Lbl}"/>
                     <ComboBox Width="160" ItemsSource="{Binding Positions}" DisplayMemberPath="Label"
                               SelectedValuePath="Id" SelectedValue="{Binding Position}"/>
                  </StackPanel>
                  <WrapPanel Visibility="{Binding HasEdge1, Converter={StaticResource BoolToVisibility}}">
                     <TextBlock Text="{DynamicResource PunchingEdge1}" Style="{StaticResource Lbl}" Width="54"/>
                     <ComboBox Width="56" ItemsSource="{Binding Sides}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Edge1Side}"/>
                     <TextBlock Text="c" Style="{StaticResource Lbl}" Margin="6,2,4,2"/>
                     <TextBox Style="{StaticResource Num}" Width="60" Text="{Binding Edge1C, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                     <TextBlock Text="α" Style="{StaticResource Lbl}" Margin="0,2,4,2"/>
                     <TextBox Style="{StaticResource Num}" Width="44" Text="{Binding Edge1Angle, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="°" Style="{StaticResource Unit}"/>
                  </WrapPanel>
                  <WrapPanel Visibility="{Binding HasEdge2, Converter={StaticResource BoolToVisibility}}">
                     <TextBlock Text="{DynamicResource PunchingEdge2}" Style="{StaticResource Lbl}" Width="54"/>
                     <ComboBox Width="56" ItemsSource="{Binding Sides}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Edge2Side}"/>
                     <TextBlock Text="c" Style="{StaticResource Lbl}" Margin="6,2,4,2"/>
                     <TextBox Style="{StaticResource Num}" Width="60" Text="{Binding Edge2C, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                     <TextBlock Text="α" Style="{StaticResource Lbl}" Margin="0,2,4,2"/>
                     <TextBox Style="{StaticResource Num}" Width="44" Text="{Binding Edge2Angle, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="°" Style="{StaticResource Unit}"/>
                  </WrapPanel>
                  <TextBlock Text="{DynamicResource PunchingEdgeHint}" Style="{StaticResource Hint}"
                             Visibility="{Binding HasEdge1, Converter={StaticResource BoolToVisibility}}"/>
               </StackPanel>
            </Expander>

            <!-- Отверстия -->
            <Expander Header="{DynamicResource PunchingGroupHoles}" IsExpanded="False">
               <StackPanel>
                  <TextBlock Text="{DynamicResource PunchingHolesHint}" Style="{StaticResource Hint}"/>
                  <DataGrid ItemsSource="{Binding Holes}" SelectedItem="{Binding SelectedHole}" AutoGenerateColumns="False"
                            CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="180" Margin="0,2">
                     <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{DynamicResource PunchingHoleShape}" Width="Auto" MinWidth="130">
                           <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                 <ComboBox Margin="0" BorderThickness="0"
                                           ItemsSource="{Binding DataContext.HoleShapes, RelativeSource={RelativeSource AncestorType=Window}}"
                                           DisplayMemberPath="Label" SelectedValuePath="Id"
                                           SelectedValue="{Binding Shape, UpdateSourceTrigger=PropertyChanged}"/>
                              </DataTemplate>
                           </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="xc, мм" Width="*" Binding="{Binding Cx, Converter={StaticResource AnyDoubleConv}}"/>
                        <DataGridTextColumn Header="yc, мм" Width="*" Binding="{Binding Cy, Converter={StaticResource AnyDoubleConv}}"/>
                        <DataGridTextColumn Header="bx, мм" Width="*" Binding="{Binding Bx, Converter={StaticResource AnyDoubleConv}}"/>
                        <DataGridTextColumn Header="by, мм" Width="*" Binding="{Binding By, Converter={StaticResource AnyDoubleConv}}"/>
                        <DataGridTextColumn Header="D, мм" Width="*" Binding="{Binding D, Converter={StaticResource AnyDoubleConv}}"/>
                     </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel Orientation="Horizontal">
                     <Button Content="{DynamicResource PunchingAdd}" Command="{Binding AddHoleCommand}" Padding="10,2" Margin="0,2,6,2"/>
                     <Button Content="{DynamicResource PunchingRemove}" Command="{Binding RemoveHoleCommand}" Padding="10,2" Margin="0,2"/>
                  </StackPanel>
               </StackPanel>
            </Expander>

            <!-- Поперечная арматура -->
            <Expander Header="{DynamicResource PunchingGroupSw}">
               <StackPanel>
                  <CheckBox Content="{DynamicResource PunchingSwEnabled}" IsChecked="{Binding SwEnabled}"/>
                  <StackPanel IsEnabled="{Binding SwEnabled}">
                     <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource PunchingRebar}" Style="{StaticResource Lbl}"/>
                        <ComboBox Width="200" ItemsSource="{Binding Rebars}" DisplayMemberPath="Tag" SelectedItem="{Binding Rebar}"
                                  IsEnabled="{Binding RswManual, Converter={StaticResource InverseBool}}"/>
                     </StackPanel>
                     <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource PunchingSwLayout}" Style="{StaticResource Lbl}"/>
                        <ComboBox Width="290" ItemsSource="{Binding SwLayouts}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SwLayout}"/>
                     </StackPanel>
                     <WrapPanel>
                        <TextBlock Text="d" Style="{StaticResource Lbl}"/>
                        <TextBox Style="{StaticResource Num}" Width="50" Text="{Binding Diameter, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowLegacyCount, Converter={StaticResource BoolToVisibility}}">
                           <TextBlock Text="n" Style="{StaticResource Lbl}" ToolTip="{DynamicResource PunchingSwCountHint}"/>
                           <TextBox Style="{StaticResource Num}" Width="40" ToolTip="{DynamicResource PunchingSwCountHint}"
                                    Text="{Binding Count, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSwUniform, Converter={StaticResource BoolToVisibility}}">
                           <TextBlock Text="sw" Style="{StaticResource Lbl}" Margin="6,2,8,2" ToolTip="{DynamicResource PunchingSwStepHint}"/>
                           <TextBox Style="{StaticResource Num}" Width="50" ToolTip="{DynamicResource PunchingSwStepHint}"
                                    Text="{Binding Step, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                           <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                        </StackPanel>
                     </WrapPanel>

                     <!-- Ряды поперёк сторон контура (п. 10.3.17) -->
                     <CheckBox Content="{DynamicResource PunchingSwByRows}" IsChecked="{Binding SwByRows}" Margin="0,4,0,2"
                               ToolTip="{DynamicResource PunchingSwByRowsHint}"/>
                     <WrapPanel Visibility="{Binding SwByRows, Converter={StaticResource BoolToVisibility}}" Margin="16,0,0,0">
                        <TextBlock Text="s1" Style="{StaticResource Lbl}" ToolTip="{DynamicResource PunchingSwFirstRowHint}"/>
                        <TextBox Style="{StaticResource Num}" Width="50" ToolTip="{DynamicResource PunchingSwFirstRowHint}"
                                 Text="{Binding FirstRow, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                        <TextBlock Text="sd" Style="{StaticResource Lbl}" ToolTip="{DynamicResource PunchingSwRowStepHint}"/>
                        <TextBox Style="{StaticResource Num}" Width="50" ToolTip="{DynamicResource PunchingSwRowStepHint}"
                                 Text="{Binding RowStep, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                        <TextBlock Text="{DynamicResource PunchingSwRowCount}" Style="{StaticResource Lbl}"/>
                        <TextBox Style="{StaticResource Num}" Width="40" Text="{Binding RowCount, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     </WrapPanel>
                     <StackPanel Orientation="Horizontal" Visibility="{Binding SwLegacy, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="{DynamicResource PunchingSwZone}" IsChecked="{Binding ZoneEnabled}" Margin="0,4,8,2"
                                  ToolTip="{DynamicResource PunchingSwZoneHint}"/>
                        <TextBox Style="{StaticResource Num}" IsEnabled="{Binding ZoneEnabled}"
                                 Text="{Binding Zone, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                     </StackPanel>

                     <!-- Лучи креста (рис. 8.11г): линии стержней поперёк луча, Lsw = (n − 1)·sw -->
                     <StackPanel Visibility="{Binding IsSwCross, Converter={StaticResource BoolToVisibility}}" Margin="0,2,0,0">
                        <WrapPanel ToolTip="{DynamicResource PunchingCrossHint}">
                           <TextBlock Text="{DynamicResource PunchingCrossAlongX}" Style="{StaticResource Lbl}" Width="92"/>
                           <TextBlock Text="{DynamicResource PunchingCrossLines}" Style="{StaticResource Lbl}"/>
                           <TextBox Style="{StaticResource Num}" Width="36" Text="{Binding CrossXLines, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                           <TextBlock Text="sw" Style="{StaticResource Lbl}" Margin="6,2,8,2"/>
                           <TextBox Style="{StaticResource Num}" Width="46" Text="{Binding CrossXStep, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                           <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                           <CheckBox Content="+X" IsChecked="{Binding CrossXPos}" Margin="4,4,4,2"/>
                           <CheckBox Content="−X" IsChecked="{Binding CrossXNeg}" Margin="4,4,8,2"/>
                           <TextBlock Text="{Binding CrossXWidthText}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <WrapPanel ToolTip="{DynamicResource PunchingCrossHint}">
                           <TextBlock Text="{DynamicResource PunchingCrossAlongY}" Style="{StaticResource Lbl}" Width="92"/>
                           <TextBlock Text="{DynamicResource PunchingCrossLines}" Style="{StaticResource Lbl}"/>
                           <TextBox Style="{StaticResource Num}" Width="36" Text="{Binding CrossYLines, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                           <TextBlock Text="sw" Style="{StaticResource Lbl}" Margin="6,2,8,2"/>
                           <TextBox Style="{StaticResource Num}" Width="46" Text="{Binding CrossYStep, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                           <TextBlock Text="мм" Style="{StaticResource Unit}"/>
                           <CheckBox Content="+Y" IsChecked="{Binding CrossYPos}" Margin="4,4,4,2"/>
                           <CheckBox Content="−Y" IsChecked="{Binding CrossYNeg}" Margin="4,4,8,2"/>
                           <TextBlock Text="{Binding CrossYWidthText}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </WrapPanel>
                     </StackPanel>
                     <StackPanel Orientation="Horizontal">
                        <CheckBox Content="{DynamicResource PunchingRswManual}" IsChecked="{Binding RswManual}" Margin="0,4,8,2"/>
                        <TextBox Style="{StaticResource Num}" IsEnabled="{Binding RswManual}"
                                 Text="{Binding RswManualValue, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        <TextBlock Text="МПа" Style="{StaticResource Unit}"/>
                     </StackPanel>
                     <TextBlock Text="{Binding SwText}" Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                     <Button Content="{DynamicResource PunchingDesignButton}" Command="{Binding DesignCommand}" Padding="10,2"
                             ToolTip="{DynamicResource PunchingDesignButtonHint}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding DesignApplyText}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
               </StackPanel>
            </Expander>

            <!-- Усилия -->
            <Expander Header="{DynamicResource PunchingGroupForces}">
               <StackPanel>
                  <!-- Пакет: усилия — из всех строк набора -->
                  <TextBlock Text="{Binding BatchForcesText}" Style="{StaticResource Hint}"
                             Visibility="{Binding IsBatch, Converter={StaticResource BoolToVisibility}}"/>
                  <WrapPanel Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
                     <TextBlock Text="F" Style="{StaticResource Lbl}"/>
                     <TextBox Style="{StaticResource Num}" Text="{Binding F, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="кН" Style="{StaticResource Unit}"/>
                     <StackPanel Orientation="Horizontal" Visibility="{Binding ShowMx, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding MxLabel}" Style="{StaticResource Lbl}" ToolTip="{Binding MxHint}"/>
                        <TextBox Style="{StaticResource Num}" Width="64" ToolTip="{Binding MxHint}"
                                 Text="{Binding Mx, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        <TextBlock Text="кН·м" Style="{StaticResource Unit}"/>
                     </StackPanel>
                     <StackPanel Orientation="Horizontal" Visibility="{Binding ShowMy, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="My" Style="{StaticResource Lbl}"/>
                        <TextBox Style="{StaticResource Num}" Width="64" Text="{Binding My, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        <TextBlock Text="кН·м" Style="{StaticResource Unit}"/>
                     </StackPanel>
                  </WrapPanel>
                  <!-- Торец стены: ΔM и помощник по моментам с двух сторон стены -->
                  <StackPanel Visibility="{Binding IsWallEnd, Converter={StaticResource BoolToVisibility}}">
                     <TextBlock Text="{DynamicResource PunchingDeltaMShortHint}" Style="{StaticResource Hint}"/>
                     <Expander Header="{DynamicResource PunchingWallMomentsBySides}" IsExpanded="False" Margin="0,0,0,2"
                               Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                           <WrapPanel>
                              <TextBlock Text="{DynamicResource PunchingWallMPlus}" Style="{StaticResource Lbl}"/>
                              <TextBox Style="{StaticResource Num}" Width="64"
                                       Text="{Binding WallMPlus, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                              <TextBlock Text="кН·м" Style="{StaticResource Unit}"/>
                              <TextBlock Text="{DynamicResource PunchingWallMMinus}" Style="{StaticResource Lbl}"/>
                              <TextBox Style="{StaticResource Num}" Width="64"
                                       Text="{Binding WallMMinus, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                              <TextBlock Text="кН·м" Style="{StaticResource Unit}"/>
                           </WrapPanel>
                           <TextBlock Text="{DynamicResource PunchingWallMomentsBySidesHint}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                     </Expander>
                  </StackPanel>
                  <TextBlock Text="{DynamicResource PunchingWallCornerForcesHint}" Style="{StaticResource Hint}"
                             Visibility="{Binding IsWallCorner, Converter={StaticResource BoolToVisibility}}"/>
                  <CheckBox Content="{DynamicResource PunchingMloc}" IsChecked="{Binding MomentsAreMloc}"
                            Visibility="{Binding ShowMlocOption, Converter={StaticResource BoolToVisibility}}"/>
                  <StackPanel Orientation="Horizontal">
                     <TextBlock Text="{DynamicResource PunchingLoadSide}" Style="{StaticResource Lbl}"/>
                     <ComboBox Width="290" ItemsSource="{Binding LoadSides}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding LoadSide}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                     <TextBlock Text="{DynamicResource PunchingCounterPressure}" Style="{StaticResource Lbl}"/>
                     <TextBox Style="{StaticResource Num}" Text="{Binding CounterPressure, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="кПа" Style="{StaticResource Unit}"/>
                  </StackPanel>
                  <StackPanel Visibility="{Binding ShowForceRow, Converter={StaticResource BoolToVisibility}}">
                     <TextBlock Text="{Binding ForceRowText}" Style="{StaticResource Hint}"/>
                     <Button Content="{DynamicResource PunchingTakeFromRow}" Command="{Binding TakeForcesFromRowCommand}"
                             HorizontalAlignment="Left" Padding="10,2" ToolTip="{DynamicResource PunchingTakeFromRowHint}"/>
                  </StackPanel>
               </StackPanel>
            </Expander>

            <!-- Настройки -->
            <Expander Header="{DynamicResource PunchingGroupOptions}" IsExpanded="False">
               <Grid>
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="Auto"/>
                     <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                     <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="{DynamicResource PunchingEccX}" Style="{StaticResource Lbl}"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding EccentricityModes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding EccentricityX}"/>
                  <TextBlock Grid.Row="1" Text="{DynamicResource PunchingEccY}" Style="{StaticResource Lbl}"/>
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding EccentricityModes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding EccentricityY}"/>
                  <TextBlock Grid.Row="2" Text="{DynamicResource PunchingWb}" Style="{StaticResource Lbl}"/>
                  <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding WbModes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Wb}"/>
                  <TextBlock Grid.Row="3" Text="{DynamicResource PunchingPylon}" Style="{StaticResource Lbl}"/>
                  <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding PylonModes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Pylon}"
                            IsEnabled="{Binding IsColumnNode}"/>
                  <TextBlock Grid.Row="4" Text="{DynamicResource PunchingHoleInfluence}" Style="{StaticResource Lbl}"/>
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                     <TextBox Style="{StaticResource Num}" Width="50" Text="{Binding HoleInfluence, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="h0" Style="{StaticResource Unit}"/>
                  </StackPanel>
                  <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="{DynamicResource PunchingPylonReduced}" IsChecked="{Binding PylonReduced}"
                            IsEnabled="{Binding IsColumnNode}"/>
                  <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal">
                     <CheckBox Content="{DynamicResource PunchingMu}" IsChecked="{Binding MuEnabled}" Margin="0,4,8,2"/>
                     <TextBox Style="{StaticResource Num}" Width="50" IsEnabled="{Binding MuEnabled}"
                              Text="{Binding MuPercent, Converter={StaticResource AnyDoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                     <TextBlock Text="%" Style="{StaticResource Unit}"/>
                  </StackPanel>
               </Grid>
            </Expander>
         </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" Background="Transparent"/>

      <!-- ── Живой результат ───────────────────────────────────── -->
      <DockPanel Grid.Column="2">
         <Border DockPanel.Dock="Top" Padding="8,6" Margin="0,0,0,6" CornerRadius="4" Background="#FDECEA" BorderBrush="#C0392B" BorderThickness="1"
                 Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
               <TextBlock Text="{Binding ErrorText}" Foreground="#8B0000" TextWrapping="Wrap"/>
               <TextBlock Text="{DynamicResource PunchingPreviewStale}" Foreground="#666" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
         </Border>
         <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewNote}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"
                    Visibility="{Binding IsBatch, Converter={StaticResource BoolToVisibility}}"/>
         <v:PunchingResultPanel DataContext="{Binding Preview}"/>
      </DockPanel>

      <!-- ── Кнопки ────────────────────────────────────────────── -->
      <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
         <Button Content="{DynamicResource PunchingSaveAndRun}" Click="SaveAndRun_Click" Padding="14,4" Margin="0,0,8,0"
                 IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBool}}"/>
         <Button Content="{DynamicResource Save}" Click="Save_Click" Padding="14,4" Margin="0,0,8,0"/>
         <Button Content="{DynamicResource Cancel}" IsCancel="True" Padding="14,4"/>
      </StackPanel>
   </Grid>
</Window>
