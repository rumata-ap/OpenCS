<UserControl x:Class="OpenCS.Views.PunchingFemResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:OpenCS.Views"
             xmlns:h="clr-namespace:OpenCS.Views.Helpers">
   <!-- Результат проверки продавливания по МКЭ: сводка, план перекрытия, узлы, ключи узла и полный расчёт строки. -->
   <UserControl.Resources>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
      <!-- Длинные заголовки («Основание, кН», «Загружение / сочетание») переносятся, а не обрезаются. -->
      <Style TargetType="DataGridColumnHeader">
         <Setter Property="ContentTemplate">
            <Setter.Value>
               <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="110"/>
               </DataTemplate>
            </Setter.Value>
         </Setter>
         <Setter Property="VerticalContentAlignment" Value="Bottom"/>
      </Style>
      <Style x:Key="StatusCell" TargetType="TextBlock">
         <Setter Property="FontWeight" Value="SemiBold"/>
         <Setter Property="Margin" Value="4,0"/>
         <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <!-- Выделенная строка — светлый фон: цветной текст статуса остаётся читаемым (на системном синем он пропадал). -->
      <Style TargetType="DataGridCell">
         <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
               <Setter Property="Background" Value="#DBEAFE"/>
               <Setter Property="BorderBrush" Value="#DBEAFE"/>
               <Setter Property="Foreground" Value="#111827"/>
            </Trigger>
         </Style.Triggers>
      </Style>
   </UserControl.Resources>
   <Grid Margin="8">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Сводка: вердикт и счётчики одной строкой, предупреждения свёрнуты; кнопки справа -->
      <DockPanel Grid.Row="0" Margin="0,0,0,6">
         <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="ReportButton" Content="{DynamicResource PunchingFemReport}" Click="Report_Click" Padding="10,3" Margin="6,0,0,0"/>
            <Button x:Name="ParamsButton" Content="{DynamicResource PunchingFemParams}" Click="Params_Click" Padding="10,3" Margin="6,0,0,0"/>
            <Button x:Name="RunButton" Content="{DynamicResource PunchingFemRerun}" Click="Run_Click" Padding="10,3" Margin="6,0,0,0"/>
         </StackPanel>
         <Border Padding="10,5" CornerRadius="4" BorderThickness="1" BorderBrush="{Binding VerdictBrush}">
            <StackPanel>
               <TextBlock TextWrapping="Wrap">
                  <Run Text="{Binding Title, Mode=OneWay}" FontWeight="Bold" FontSize="14"/>
                  <Run Text="   "/>
                  <Run Text="{Binding VerdictText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding VerdictBrush}"/>
               </TextBlock>
               <TextBlock Text="{Binding ErrorText}" Foreground="#8B0000" TextWrapping="Wrap"
                          Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
               <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#333" Margin="0,2,0,0"/>
               <Expander Header="{Binding WarningsHeader}" Foreground="#7A4F00" Margin="0,2,0,0" IsExpanded="False"
                         Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                  <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                     <TextBlock Text="{Binding WarningsText}" TextWrapping="Wrap" Foreground="#7A4F00"/>
                  </ScrollViewer>
               </Expander>
            </StackPanel>
         </Border>
      </DockPanel>

      <TabControl Grid.Row="1" x:Name="Tabs">
         <!-- План: схема во всю площадь, справа — узкий список узлов и карточка выбранного -->
         <TabItem Header="{DynamicResource PunchingFemTabPlan}">
            <Grid Margin="4">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="300"/>
                  <ColumnDefinition Width="5"/>
                  <ColumnDefinition Width="330" MinWidth="240"/>
               </Grid.ColumnDefinitions>
               <DockPanel Grid.Column="0">
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,3">
                     <Button DockPanel.Dock="Right" Content="{DynamicResource PunchingFemFit}" Click="Fit_Click" Padding="8,1" Margin="6,0,0,0"/>
                     <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding Levels}" DisplayMemberPath="Label"
                               SelectedItem="{Binding SelectedLevel}" Visibility="{Binding HasLevels, Converter={StaticResource BoolToVisibility}}"/>
                     <TextBlock Text="{DynamicResource PunchingFemPlanHint}" Foreground="#555" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="{Binding LiraLegend}" Foreground="#8E24AA" Margin="0,0,0,3" TextWrapping="Wrap"
                             Visibility="{Binding HasLira, Converter={StaticResource BoolToVisibility}}"/>
                  <Border BorderBrush="#D5DDE5" BorderThickness="1">
                     <h:PunchingFemPlanCanvas x:Name="Plan" Data="{Binding Data}" Level="{Binding LevelZ}" SelectedNode="{Binding SelectedJointNode}"/>
                  </Border>
               </DockPanel>
               <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
               <DockPanel Grid.Column="2">
                  <!-- Карточка выбранного узла -->
                  <Border DockPanel.Dock="Bottom" BorderBrush="#D5DDE5" BorderThickness="1" Padding="8,6" Margin="0,6,0,0"
                          Visibility="{Binding HasSelectedJoint, Converter={StaticResource BoolToVisibility}}">
                     <StackPanel>
                        <TextBlock Text="{Binding JointHeader}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding JointCard}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <Button Content="{DynamicResource PunchingFemOpenJoint}" Click="OpenJoint_Click" HorizontalAlignment="Left"
                                Padding="10,3" Margin="0,6,0,0"/>
                     </StackPanel>
                  </Border>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" ToolTip="{DynamicResource PunchingFemNodeSearchHint}">
                     <TextBlock Text="{DynamicResource PunchingFemNodeSearch}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                     <TextBox Width="80" Text="{Binding NodeSearch, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                     <TextBlock Text="{DynamicResource PunchingFemNodeSearchMissing}" Foreground="#B00020" VerticalAlignment="Center" Margin="6,0,0,0"
                                Visibility="{Binding NodeSearchMissing, Converter={StaticResource BoolToVisibility}}"/>
                  </DockPanel>
                  <DataGrid x:Name="JointsListGrid" ItemsSource="{Binding Joints}" SelectedItem="{Binding SelectedJoint}"
                            AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                            SelectionMode="Single" GridLinesVisibility="Horizontal" MouseDoubleClick="JointsGrid_MouseDoubleClick">
                     <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource PunchingFemColNode}" Binding="{Binding Node}" SortMemberPath="NodeOrder" Width="Auto"/>
                        <DataGridTextColumn Header="{DynamicResource PunchingKisp}" Binding="{Binding K}" SortMemberPath="KValue" Width="Auto">
                           <DataGridTextColumn.ElementStyle>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource StatusCell}">
                                 <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                              </Style>
                           </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="{DynamicResource PunchingFemColStatus}" Width="*" SortMemberPath="StatusShort">
                           <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                 <TextBlock Text="{Binding StatusShort}" Foreground="{Binding StatusBrush}" Style="{StaticResource StatusCell}"
                                            ToolTip="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
                              </DataTemplate>
                           </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                     </DataGrid.Columns>
                  </DataGrid>
               </DockPanel>
            </Grid>
         </TabItem>

         <!-- Таблица узлов: все столбцы -->
         <TabItem Header="{DynamicResource PunchingFemTabJoints}">
            <DataGrid x:Name="JointsGrid" Margin="4" ItemsSource="{Binding Joints}" SelectedItem="{Binding SelectedJoint}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                      SelectionMode="Single" GridLinesVisibility="Horizontal" MouseDoubleClick="JointsGrid_MouseDoubleClick">
               <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource PunchingFemColNode}" Binding="{Binding Node}" SortMemberPath="NodeOrder" Width="Auto"/>
                  <DataGridTextColumn Header="{DynamicResource PunchingFemColSection}" Binding="{Binding Section}" Width="Auto"/>
                  <DataGridTextColumn Header="{DynamicResource PunchingFemColSlab}" Binding="{Binding Slab}" Width="Auto"/>
                  <DataGridTextColumn Header="{DynamicResource PunchingFemColPosition}" Binding="{Binding Position}" Width="Auto"/>
                  <DataGridTextColumn Header="{DynamicResource PunchingKisp}" Binding="{Binding K}" SortMemberPath="KValue" Width="Auto">
                     <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusCell}">
                           <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                        </Style>
                     </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Header="{DynamicResource PunchingFemColStatus}" Width="*" MinWidth="160" SortMemberPath="StatusShort">
                     <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                           <TextBlock Text="{Binding StatusShort}" Foreground="{Binding StatusBrush}" Style="{StaticResource StatusCell}"
                                      ToolTip="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{DynamicResource PunchingFemColQsw}" Binding="{Binding Qsw}" SortMemberPath="QswValue" Width="Auto"/>
                  <DataGridTemplateColumn Header="{DynamicResource PunchingFemColLira}" Width="Auto" SortMemberPath="LiraValue">
                     <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                           <TextBlock Text="{Binding LiraText}" ToolTip="{Binding LiraHint}" Style="{StaticResource StatusCell}"/>
                        </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{DynamicResource PunchingFemColKey}" Binding="{Binding GoverningKey}" Width="Auto"/>
                  <DataGridTextColumn Header="F, кН" Binding="{Binding F}" Width="Auto"/>
                  <DataGridTextColumn Header="Mx, кН·м" Binding="{Binding Mx}" Width="Auto"/>
                  <DataGridTextColumn Header="My, кН·м" Binding="{Binding My}" Width="Auto"/>
                  <DataGridTextColumn Header="{DynamicResource PunchingFemColMethod}" Binding="{Binding Method}" Width="Auto"/>
                  <DataGridTemplateColumn Header="⚠" Width="Auto">
                     <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                           <TextBlock Text="{Binding Warnings}" Foreground="#7A4F00" ToolTip="{Binding WarningsText}" Margin="4,0"/>
                        </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
               </DataGrid.Columns>
            </DataGrid>
         </TabItem>

         <!-- Расчёт узла: ключи узла сверху, полный расчёт выбранной строки ниже -->
         <TabItem x:Name="JointTab" Header="{Binding JointTabHeader}">
            <Grid Margin="4">
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*" MinHeight="90" MaxHeight="260"/>
                  <RowDefinition Height="5"/>
                  <RowDefinition Height="3*" MinHeight="240"/>
               </Grid.RowDefinitions>
               <DockPanel Grid.Row="0" Margin="0,0,0,3">
                  <Button x:Name="CreateTaskBtn" DockPanel.Dock="Right" Content="{DynamicResource PunchingFemCreateTask}" Click="CreateTask_Click"
                          Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Top" ToolTip="{DynamicResource PunchingFemCreateTaskHint}"/>
                  <TextBlock Text="{Binding JointHeader}" TextWrapping="Wrap" FontWeight="SemiBold">
                     <TextBlock.ToolTip>
                        <ToolTip MaxWidth="480">
                           <TextBlock Text="{Binding RowsHint}" TextWrapping="Wrap"/>
                        </ToolTip>
                     </TextBlock.ToolTip>
                  </TextBlock>
               </DockPanel>
               <DataGrid Grid.Row="1" x:Name="RowsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                         IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
                         GridLinesVisibility="Horizontal" MouseDoubleClick="RowsGrid_MouseDoubleClick">
                  <DataGrid.Columns>
                     <DataGridTextColumn Header="{DynamicResource PunchingFemColKey}" Binding="{Binding Key}" Width="*" MinWidth="120"/>
                     <DataGridTextColumn Header="F, кН" Binding="{Binding F}" Width="Auto"/>
                     <DataGridTextColumn x:Name="RowsMxCol" Header="Mx" Binding="{Binding Mx}" Width="Auto"/>
                     <DataGridTextColumn Header="My" Binding="{Binding My}" Width="Auto"/>
                     <DataGridTextColumn Header="{DynamicResource PunchingFemColSide}" Binding="{Binding Side}" Width="Auto"/>
                     <DataGridTextColumn x:Name="RowsColumnCol" Header="{DynamicResource PunchingFemColColumn}" Binding="{Binding Column}" Width="Auto"/>
                     <DataGridTextColumn Header="{DynamicResource PunchingFemColBase}" Binding="{Binding BaseLoad}" Width="Auto"/>
                     <DataGridTextColumn Header="{DynamicResource PunchingFemColContour}" Binding="{Binding Contour}" Width="Auto"/>
                     <DataGridTextColumn x:Name="RowsMismatchCol" Header="{DynamicResource PunchingFemColMismatch}" Binding="{Binding Mismatch}" Width="Auto"/>
                     <DataGridTextColumn x:Name="RowsPylonCol" Header="{DynamicResource PunchingFemColPylon}" Binding="{Binding Pylon}" Width="Auto"/>
                     <DataGridTextColumn Header="{DynamicResource PunchingKisp}" Binding="{Binding K}" SortMemberPath="KValue" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                           <Style TargetType="TextBlock" BasedOn="{StaticResource StatusCell}">
                              <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                           </Style>
                        </DataGridTextColumn.ElementStyle>
                     </DataGridTextColumn>
                  </DataGrid.Columns>
               </DataGrid>
               <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent"/>
               <v:PunchingResultPanel Grid.Row="3" DataContext="{Binding Detail}"/>
            </Grid>
         </TabItem>
      </TabControl>
   </Grid>
</UserControl>