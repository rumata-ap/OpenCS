<Window x:Class="OpenCS.Views.FemLoadSourcePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860" Height="580" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Бейдж типа: C/CL/N/NL/A у комбинаций, G/L/Q/A у загружений -->
        <DataTemplate x:Key="TypeBadge">
            <Border CornerRadius="3" Padding="4,0" MinWidth="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="#E8EEF7" BorderBrush="#B8C7DD" BorderThickness="1">
                <TextBlock Text="{Binding TypeBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#2F4A73"
                           HorizontalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <Style x:Key="PickerGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="RowHeight" Value="22"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <!-- Недоступный источник (комбинация со слагаемым вне расчёта) — серый, причина в подсказке -->
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Foreground" Value="#A0A0A0"/>
                                <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GrayCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TypeToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{DynamicResource Cancel}" IsCancel="True" Padding="16,4" MinWidth="80" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="{Binding AcceptText}" IsDefault="True"
                    IsEnabled="{Binding CanAccept}" Click="Select_Click" Padding="16,4" MinWidth="80"/>
        </DockPanel>

        <!-- Состав выбранной строки: коэффициент · код имя -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,6" Background="#F7F8FA" BorderBrush="#E1E4E8" BorderThickness="1"
                CornerRadius="3" MinHeight="54" MaxHeight="120">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedCaption}" FontWeight="SemiBold" Margin="0,0,0,4"
                           TextTrimming="CharacterEllipsis"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedTerms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1,18,1">
                                    <TextBlock Text="{Binding Coefficient}" FontWeight="SemiBold" MinWidth="32" TextAlignment="Right"/>
                                    <TextBlock Text=" · " Foreground="#888888"/>
                                    <TextBlock Text="{Binding Code}" Foreground="#2F4A73"/>
                                    <TextBlock Text="{Binding Name}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab}">
            <!-- ── Комбинации ─────────────────────────────────────────── -->
            <TabItem Header="{Binding CombinationsHeader}">
                <DockPanel Margin="6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding HasCombinations, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource FemLoadSourcePickerTypes}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ItemsControl ItemsSource="{Binding TypeFilters}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource TypeToggle}" Content="{Binding Label}" ToolTip="{Binding ToolTip}"
                                                  IsChecked="{Binding IsOn}" IsEnabled="{Binding IsAvailable}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{DynamicResource FemLoadSourcePickerAllTypes}" Click="AllTypes_Click" Padding="8,1" Margin="4,0,0,0"
                                VerticalAlignment="Center"/>
                        <Border/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding HasCombinations, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CombinationsShownText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="#666666"/>
                        <TextBlock Text="{DynamicResource FemLoadSourcePickerSearch}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="CombinationSearchBox" Height="22" VerticalContentAlignment="Center"
                                 Text="{Binding CombinationSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 ToolTip="{DynamicResource FemLoadSourcePickerSearchTip}" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVis}}">
                        <Button Content="{DynamicResource FemLoadSourcePickerCheckVisible}" Click="CheckVisible_Click" Padding="8,1"/>
                        <Button Content="{DynamicResource FemLoadSourcePickerUncheckVisible}" Click="UncheckVisible_Click" Padding="8,1" Margin="4,0,0,0"/>
                        <TextBlock Text="{Binding CheckedText}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                        <Border/>
                    </DockPanel>
                    <Grid>
                        <DataGrid x:Name="CombinationsGrid" Style="{StaticResource PickerGrid}"
                                  ItemsSource="{Binding VisibleCombinations}" SelectedItem="{Binding SelectedCombination}"
                                  MouseDoubleClick="Grid_MouseDoubleClick" PreviewKeyDown="Grid_PreviewKeyDown"
                                  Visibility="{Binding HasCombinations, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="CombinationsCheckColumn" Width="28" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding IsEnabled}" Focusable="False"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      PreviewMouseLeftButtonDown="Check_PreviewMouseLeftButtonDown"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource FemLoadSourcePickerNumberColumn}" Binding="{Binding Number}" Width="44"
                                                    ElementStyle="{StaticResource GrayCell}"/>
                                <DataGridTemplateColumn Header="{DynamicResource FemLoadSourcePickerTypeColumn}" Width="48" SortMemberPath="TypeBadge"
                                                        CellTemplate="{StaticResource TypeBadge}"/>
                                <DataGridTextColumn Header="{DynamicResource FemLoadSourcePickerNameColumn}" Binding="{Binding Tag}" Width="2*"
                                                    ElementStyle="{StaticResource TextCell}"/>
                                <DataGridTextColumn Header="{DynamicResource FemLoadSourcePickerFormulaColumn}" Binding="{Binding Formula}" Width="3*"
                                                    ElementStyle="{StaticResource GrayCell}"/>
                                <DataGridTextColumn Header="{DynamicResource FemLoadSourcePickerOriginColumn}" Binding="{Binding Origin}" Width="80"
                                                    ElementStyle="{StaticResource GrayCell}"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                        <TextBlock Text="{DynamicResource FemLoadSourcePickerNoMatches}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#888888" IsHitTestVisible="False" x:Name="CombinationsNoMatches" Visibility="Collapsed"/>
                        <TextBlock Text="{DynamicResource FemLoadSourcePickerNoCombinations}" TextWrapping="Wrap" Margin="24" MaxWidth="520"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666" x:Name="NoCombinationsText"
                                   Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ── Загружения ─────────────────────────────────────────── -->
            <TabItem Header="{Binding CasesHeader}">
                <DockPanel Margin="6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CasesShownText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="#666666"/>
                        <TextBlock Text="{DynamicResource FemLoadSourcePickerSearch}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="CaseSearchBox" Height="22" VerticalContentAlignment="Center"
                                 Text="{Binding CaseSearch, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVis}}">
                        <Button Content="{DynamicResource FemLoadSourcePickerCheckVisible}" Click="CheckVisible_Click" Padding="8,1"/>
                        <Button Content="{DynamicResource FemLoadSourcePickerUncheckVisible}" Click="UncheckVisible_Click" Padding="8,1" Margin="4,0,0,0"/>
                        <TextBlock Text="{Binding CheckedText}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                        <Border/>
                    </DockPanel>
                    <Grid>
                        <DataGrid x:Name="CasesGrid" Style="{StaticResource PickerGrid}"
                                  ItemsSource="{Binding VisibleCases}" SelectedItem="{Binding SelectedCase}"
                                  MouseDoubleClick="Grid_MouseDoubleClick" PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="CasesCheckColumn" Width="28" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding IsEnabled}" Focusable="False"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      PreviewMouseLeftButtonDown="Check_PreviewMouseLeftButtonDown"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource FemLoadSourcePickerCodeColumn}" Binding="{Binding Formula}" Width="52"
                                                    SortMemberPath="Number" ElementStyle="{StaticResource GrayCell}"/>
                                <DataGridTemplateColumn Header="{DynamicResource FemLoadSourcePickerTypeColumn}" Width="56" SortMemberPath="TypeBadge">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Width="16" Height="16" Source="{DynamicResource FemIcon_LoadShort}" x:Name="Icon"/>
                                                <TextBlock Text="{Binding TypeBadge}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Sp20Type}" Value="permanent">
                                                    <Setter TargetName="Icon" Property="Source" Value="{DynamicResource FemIcon_LoadPermanent}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Sp20Type}" Value="long_term">
                                                    <Setter TargetName="Icon" Property="Source" Value="{DynamicResource FemIcon_LoadLong}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Sp20Type}" Value="accidental">
                                                    <Setter TargetName="Icon" Property="Source" Value="{DynamicResource FemIcon_LoadAccidental}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource FemCsfeaLinearCasesNameColumn}" Binding="{Binding Tag}" Width="*"
                                                    ElementStyle="{StaticResource TextCell}"/>
                                <DataGridTextColumn Header="γf" Binding="{Binding GammaText}" Width="56" ElementStyle="{StaticResource GrayCell}"/>
                                <DataGridTextColumn Header="{DynamicResource FemCsfeaLinearCasesShareColumn}" Binding="{Binding ShareText}" Width="70"
                                                    ElementStyle="{StaticResource GrayCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{DynamicResource FemLoadSourcePickerNoMatches}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#888888" IsHitTestVisible="False" x:Name="CasesNoMatches" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
