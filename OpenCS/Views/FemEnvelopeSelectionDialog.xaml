<Window x:Class="OpenCS.Views.FemEnvelopeSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FemEnvelopeSelectionTitle}"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="sourceText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource FemEnvelopeSelectionValueKind}" VerticalAlignment="Center"
                       ToolTip="{DynamicResource FemEnvelopeSelectionValueKindTip}"/>
            <ComboBox x:Name="valueKindBox" Grid.Column="1" SelectionChanged="ValueKind_Changed"
                      ToolTip="{DynamicResource FemEnvelopeSelectionValueKindTip}">
                <ComboBoxItem Tag="normative" Content="{DynamicResource CalcSettingsSp20Normative}"/>
                <ComboBoxItem Tag="design" Content="{DynamicResource CalcSettingsSp20Design}"/>
            </ComboBox>
        </Grid>
        <TextBlock x:Name="valueKindWarning" Text="{DynamicResource FemEnvelopeSelectionImportedWarning}"
                   Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
        <TextBlock Text="{DynamicResource FemEnvelopeSelectionGroups}" Margin="0,0,0,4"/>
        <StackPanel x:Name="groupsPanel" Margin="8,0,0,8">
            <CheckBox x:Name="groupC" Tag="C" Content="{DynamicResource FemCombinationGroupC}" Margin="0,0,0,2"/>
            <CheckBox x:Name="groupCL" Tag="CL" Content="{DynamicResource FemCombinationGroupCL}" Margin="0,0,0,2"/>
            <CheckBox x:Name="groupN" Tag="N" Content="{DynamicResource FemCombinationGroupN}" Margin="0,0,0,2"/>
            <CheckBox x:Name="groupNL" Tag="NL" Content="{DynamicResource FemCombinationGroupNL}" Margin="0,0,0,2"/>
            <CheckBox x:Name="groupA" Tag="A" Content="{DynamicResource FemCombinationGroupA}"/>
        </StackPanel>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource FemEnvelopeSelectionTolerance}" VerticalAlignment="Center"/>
            <TextBox x:Name="toleranceBox" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Text="{DynamicResource FemEnvelopeSelectionMax}" VerticalAlignment="Center"/>
            <TextBox x:Name="maxBox" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center"/>
        </Grid>
        <TextBlock Text="{DynamicResource FemEnvelopeSelectionHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="72" IsDefault="True" Click="Apply_Click" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Cancel}" Width="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
