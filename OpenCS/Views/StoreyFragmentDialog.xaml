<Window x:Class="OpenCS.Views.StoreyFragmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource StoreyFragmentTitle}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="NoteText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock Text="{Binding ParentTag}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding PickMessage}" Foreground="DarkOrange" Style="{StaticResource NoteText}"/>

        <StackPanel Visibility="{Binding HasLevels, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{DynamicResource StoreyFloorLabel}" Margin="0,0,0,2"/>
            <ListBox x:Name="levelsList" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"
                     DisplayMemberPath="Label" MaxHeight="180" Margin="0,0,0,6" IsEnabled="{Binding Auto}"/>
            <TextBlock Text="{Binding BelowText}" Style="{StaticResource NoteText}"/>
            <TextBlock Text="{Binding AboveText}" Style="{StaticResource NoteText}"/>
            <TextBlock Text="{Binding Warning}" Foreground="DarkOrange" Style="{StaticResource NoteText}"/>
            <CheckBox Content="{DynamicResource StoreyFloorManual}" IsChecked="{Binding Manual}" Margin="0,2,0,6"/>
        </StackPanel>

        <Grid Margin="0,0,0,8" Visibility="{Binding Manual, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource StoreyFragmentZ1}" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox x:Name="z1Box" Grid.Column="1" Width="80" Margin="0,0,0,4" VerticalContentAlignment="Center"
                     Text="{Binding Z1Text, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="1" Text="{DynamicResource StoreyFragmentZ2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Width="80" VerticalContentAlignment="Center"
                     Text="{Binding Z2Text, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <TextBlock Text="{Binding RangeText}" Foreground="Gray" Style="{StaticResource NoteText}"/>
        <TextBlock Text="{DynamicResource StoreyFragmentName}" Margin="0,0,0,2"/>
        <TextBox Margin="0,0,0,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{DynamicResource StoreyFragmentHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource StoreyFragmentBuild}" MinWidth="72" Padding="8,0" IsDefault="True"
                    Click="Apply_Click" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Cancel}" Width="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
