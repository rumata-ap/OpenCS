<UserControl x:Class="OpenCS.Views.FemSchemaView3D" x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OpenCS.Views.Helpers"
             xmlns:local="clr-namespace:OpenCS.Views"
             xmlns:mosaic="clr-namespace:OpenCS.Views.Mosaic"
             xmlns:conv="clr-namespace:OpenCS.Converters"
             xmlns:u="clr-namespace:OpenCS.Utilites"
             xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf">
    <UserControl.Resources>
        <conv:NullToCollapsedVisibilityConverter x:Key="NullToCollapsedConv"/>
        <conv:NullableDoubleTextConverter x:Key="NullableDoubleTextConverter"/>
        <u:AnyDoubleConverter x:Key="AnyDoubleConv"/>
        <Style x:Key="IconToggleButton25" TargetType="ToggleButton">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Линейная иконка 24×24 строки результата (контур, без заливки) -->
        <Style x:Key="ResultIconStroke" TargetType="Path">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>
        <ContextMenu x:Key="MemberContextMenu">
            <MenuItem helpers:CommandIcons.Header="FemMemberSectionCtx" Click="MemberSectionCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemMemberPropertiesCtx" Click="MemberPropertiesCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemMemberRotationCtx" Click="MemberRotationCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemMemberMeshStepCtx" Click="MemberMeshStepCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemMemberLoadCtx" Click="MemberLoadCtx_Click"/>
            <Separator/>
            <MenuItem helpers:CommandIcons.Header="FemMemberMoveCtx" Click="MemberMoveCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemMemberCopyCtx" Click="MemberCopyCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemMemberSplitCtx" Click="MemberSplitCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemMemberDeleteCtx" Click="MemberDeleteCtx_Click"/>
            <Separator/>
            <MenuItem helpers:CommandIcons.Header="FemMemberForcesCtx" Click="MemberForcesCtx_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="NodeContextMenu">
            <MenuItem helpers:CommandIcons.Header="FemNodeMoveCtx" Click="NodeMoveCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemNodeCopyCtx" Click="NodeCopyCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemNodeLoadCtx" Click="NodeLoadCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemKinematicLoadCtx" Click="KinematicLoadCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemNodeBoundaryCtx" Click="NodeBoundaryCtx_Click"/>
            <Separator/>
            <MenuItem helpers:CommandIcons.Header="FemNodePropertiesCtx" Click="NodePropertiesCtx_Click"/>
            <Separator/>
            <MenuItem helpers:CommandIcons.Header="FemNodeDeleteCtx" Click="NodeDeleteCtx_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="LoadContextMenu">
            <MenuItem helpers:CommandIcons.Header="FemLoadEditCtx" Click="LoadEditCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemLoadDeleteCtx" Click="LoadDeleteCtx_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="PlanarRegionContextMenu">
            <MenuItem helpers:CommandIcons.Header="PlanarRegionEditCtx" Click="PlanarRegionEditCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemMemberMeshStepCtx" Click="MemberMeshStepCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="FemLineSupportMenu" Click="PlateLineSupportCtx_Click"/>
            <MenuItem helpers:CommandIcons.Header="PlanarRegionDeleteCtx" Click="PlanarRegionDeleteCtx_Click"/>
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Строка 1 — редактирование и вид; сворачивается (сама — при показе результата расчёта) -->
        <ToolBar x:Name="editToolBar" Grid.Row="0">
            <Button Style="{StaticResource IconButton25}" Click="CollapseEditBar_Click"
                    ToolTip="{DynamicResource Fem3DEditBarCollapse}">
                <Path Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z" Fill="Black" Stretch="Uniform" Margin="4"/>
            </Button>
            <!-- Строка мозаик свёрнута (сама — при просмотре схемы без результата) — развернуть -->
            <Button x:Name="expandMosaicBarButton" Style="{StaticResource IconButton25}" Visibility="Collapsed"
                    Click="ExpandMosaicBar_Click" ToolTip="{DynamicResource Fem3DMosaicBarExpand}">
                <Path Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z" Fill="Black" Stretch="Uniform" Margin="4"/>
            </Button>
            <Separator/>
            <ToggleButton Style="{StaticResource IconToggleButton25}"
                          IsChecked="{Binding Editor.CreateNodeMode, ElementName=root, Mode=TwoWay}"
                          ToolTip="{DynamicResource FemCreateNodeMode}">
                <Path Data="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </ToggleButton>
            <ToggleButton Style="{StaticResource IconToggleButton25}"
                          IsChecked="{Binding Editor.CreateBarMode, ElementName=root, Mode=TwoWay}"
                          ToolTip="{DynamicResource FemCreateBarMode}">
                <Path Data="M15,3.5A3.5,3.5 0 0,1 18.5,7C18.5,8.75 17.21,10.2 15.53,10.45L10.45,15.53C10.2,17.21 8.75,18.5 7,18.5A3.5,3.5 0 0,1 3.5,15C3.5,13.25 4.79,11.8 6.47,11.55L11.55,6.47C11.8,4.79 13.25,3.5 15,3.5M15,5.5A1.5,1.5 0 0,0 13.5,7A1.5,1.5 0 0,0 15,8.5A1.5,1.5 0 0,0 16.5,7A1.5,1.5 0 0,0 15,5.5M7,13.5A1.5,1.5 0 0,0 5.5,15A1.5,1.5 0 0,0 7,16.5A1.5,1.5 0 0,0 8.5,15A1.5,1.5 0 0,0 7,13.5Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </ToggleButton>
            <ToggleButton Style="{StaticResource IconToggleButton25}"
                          IsChecked="{Binding Editor.CreatePlateMode, ElementName=root, Mode=TwoWay}"
                          ToolTip="{DynamicResource FemCreatePlateMode}">
                <Path Data="M4,4 H20 V20 H4 Z" Fill="Transparent" Stroke="Black" StrokeThickness="2" Stretch="Uniform" Margin="2"/>
            </ToggleButton>
            <ToggleButton Style="{StaticResource IconToggleButton25}"
                          IsChecked="{Binding Editor.CreateWallMode, ElementName=root, Mode=TwoWay}"
                          ToolTip="{DynamicResource FemCreateWallMode}">
                <Path Data="M9,3 H15 V21 H9 Z" Fill="Transparent" Stroke="Black" StrokeThickness="2" Stretch="Uniform" Margin="2"/>
            </ToggleButton>
            <ToggleButton Style="{StaticResource IconToggleButton25}"
                          IsChecked="{Binding Editor.CreateSpatialPlateMode, ElementName=root, Mode=TwoWay}"
                          ToolTip="{DynamicResource FemCreateSpatialPlateMode}">
                <Path Data="M4,16 L10,4 L20,8 L14,20 Z" Fill="Transparent" Stroke="Black" StrokeThickness="2" Stretch="Uniform" Margin="2"/>
            </ToggleButton>
            <!-- Режим выбора: КЭ импортированной сетки вместо конструктивных элементов -->
            <ToggleButton x:Name="meshPickCheck" Style="{StaticResource IconToggleButton25}" Visibility="Collapsed"
                          ToolTip="{DynamicResource Fem3DMeshPickMode}" Click="MeshPickToggle_Click">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Data="M2,2 H16 V16 H2 Z M2,9 H16 M9,2 V16" Stroke="Black" StrokeThickness="1.5"/>
                        <Path Data="M9,2 H16 V9 H9 Z" Fill="#FF4500"/>
                        <Path Data="M13,12 L22,16 L18,17.5 L16.5,22 Z" Fill="Black"/>
                    </Canvas>
                </Viewbox>
            </ToggleButton>
            <Separator/>
            <Button Style="{StaticResource IconButton25}" Click="NodeLoadTool_Click"
                    ToolTip="{DynamicResource FemNodeLoadToolTip}">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Data="M6,21.5 H18" Stroke="#2C3E50" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M12,18.5 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" Fill="#2C3E50"/>
                        <Path Data="M12,2 V10" Stroke="#E74C3C" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M8,9 L12,15 L16,9 Z" Fill="#E74C3C"/>
                    </Canvas>
                </Viewbox>
            </Button>
            <Button Style="{StaticResource IconButton25}" Click="KinematicLoadTool_Click"
                    ToolTip="{DynamicResource FemKinematicLoadToolTip}">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,3 V21" Stroke="#2C3E50" StrokeThickness="1.5"/>
                        <Path Data="M5,8 L12,3 L19,8" Stroke="#8E44AD" StrokeThickness="2" Fill="Transparent"/>
                        <Path Data="M5,16 L12,21 L19,16" Stroke="#8E44AD" StrokeThickness="2" Fill="Transparent"/>
                    </Canvas>
                </Viewbox>
            </Button>
            <Button Style="{StaticResource IconButton25}" Click="MemberLoadTool_Click"
                    ToolTip="{DynamicResource FemMemberLoadToolTip}">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3,19 H21" Stroke="#2C3E50" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M4,19 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" Fill="#2C3E50"/>
                        <Path Data="M20,19 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" Fill="#2C3E50"/>
                        <Path Data="M5,5 H19" Stroke="#1976D2" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M6,5 V13 M12,5 V13 M18,5 V13" Stroke="#1976D2" StrokeThickness="1.5"/>
                        <Path Data="M4.5,11 L6,15.5 L7.5,11 Z M10.5,11 L12,15.5 L13.5,11 Z M16.5,11 L18,15.5 L19.5,11 Z" Fill="#1976D2"/>
                    </Canvas>
                </Viewbox>
            </Button>
            <Separator/>
            <!-- Переместить / Копировать в духе AutoCAD: базовая точка → вторая точка -->
            <Button Style="{StaticResource IconButton25}" Click="MoveTool_Click"
                    ToolTip="{DynamicResource FemTransformMoveTip}">
                <Image Source="{StaticResource CmdIcon_Move}" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource IconButton25}" Click="CopyTool_Click"
                    ToolTip="{DynamicResource FemTransformCopyTip}">
                <Image Source="{StaticResource CmdIcon_Copy}" Width="16" Height="16"/>
            </Button>
            <!-- Грани пластин: выбор для линейных связей -->
            <ToggleButton x:Name="edgePickButton" Style="{StaticResource IconToggleButton25}" Click="EdgePickTool_Click"
                          ToolTip="{DynamicResource FemLineSupportPickMode}">
                <Image Source="{StaticResource CmdIcon_LineSupport}" Width="16" Height="16"/>
            </ToggleButton>
            <Separator/>
            <Button Style="{StaticResource IconButton25}"
                    Command="{Binding Editor.UndoCommand, ElementName=root}"
                    ToolTip="{DynamicResource FemUndo}">
                <Path Data="M13.5,7A6.5,6.5 0 0,1 20,13.5A6.5,6.5 0 0,1 13.5,20H10V18H13.5C16,18 18,16 18,13.5C18,11 16,9 13.5,9H7.83L10.91,12.09L9.5,13.5L4,8L9.5,2.5L10.92,3.91L7.83,7H13.5Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </Button>
            <Button Style="{StaticResource IconButton25}"
                    Command="{Binding Editor.RedoCommand, ElementName=root}"
                    ToolTip="{DynamicResource FemRedo}">
                <Path Data="M10.5,7A6.5,6.5 0 0,0 4,13.5A6.5,6.5 0 0,0 10.5,20H14V18H10.5C8,18 6,16 6,13.5C6,11 8,9 10.5,9H16.17L13.09,12.09L14.5,13.5L20,8L14.5,2.5L13.08,3.91L16.17,7H10.5Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </Button>
            <Button Style="{StaticResource IconButton25}"
                    Command="{Binding Editor.SaveCommand, ElementName=root}"
                    ToolTip="{DynamicResource FemSaveSchema}">
                <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </Button>
            <Separator/>
            <Button Style="{StaticResource IconButton25}" Click="ZoomExtents_Click"
                    ToolTip="{DynamicResource Fem3DZoomExtents}">
                <Path Data="M10,21V19H6.41L10.91,14.5L9.5,13.09L5,17.59V14H3V21H10M14.5,10.91L19,6.41V10H21V3H14V5H17.59L13.09,9.5L14.5,10.91M3,3V10H5V6.41L9.5,10.91L10.91,9.5L6.41,5H10V3H3M21,21V14H19V17.59L14.5,13.09L13.09,14.5L17.59,19H14V21H21Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </Button>
            <ToggleButton x:Name="showNodesCheck" Style="{StaticResource IconToggleButton25}"
                          IsChecked="False" ToolTip="{DynamicResource Fem3DShowNodes}"
                          Checked="NodesToggle" Unchecked="NodesToggle">
                <Path Data="M12,4A2.5,2.5 0 0,1 14.5,6.5A2.5,2.5 0 0,1 12,9A2.5,2.5 0 0,1 9.5,6.5A2.5,2.5 0 0,1 12,4M5.5,14A2.5,2.5 0 0,1 8,16.5A2.5,2.5 0 0,1 5.5,19A2.5,2.5 0 0,1 3,16.5A2.5,2.5 0 0,1 5.5,14M18.5,14A2.5,2.5 0 0,1 21,16.5A2.5,2.5 0 0,1 18.5,19A2.5,2.5 0 0,1 16,16.5A2.5,2.5 0 0,1 18.5,14Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </ToggleButton>
            <ToggleButton x:Name="showGridCheck" Style="{StaticResource IconToggleButton25}"
                          IsChecked="False" ToolTip="{DynamicResource Fem3DShowGrid}"
                          Checked="GridToggle" Unchecked="GridToggle">
                <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,11H13V5H19V11M11,5V11H5V5H11M5,19V13H11V19H5M13,19V13H19V19H13Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </ToggleButton>
            <!-- Камера: ортогональная проекция или перспектива с углом обзора -->
            <ToggleButton x:Name="orthographicCheck" Style="{StaticResource IconToggleButton25}"
                          ToolTip="{DynamicResource Fem3DOrthographic}">
                <Path Data="M4,8 L12,4 L20,8 L20,16 L12,20 L4,16 Z M4,8 L12,12 L20,8 M12,12 L12,20" Stroke="Black" StrokeThickness="1.5"
                      Fill="Transparent" Stretch="Uniform" Margin="3"/>
            </ToggleButton>
            <Slider x:Name="fieldOfViewSlider" Width="80" Minimum="10" Maximum="90" VerticalAlignment="Center" Margin="4,0"
                    IsEnabled="{Binding IsChecked, ElementName=orthographicCheck, Converter={StaticResource InverseBool}}"/>
            <Separator/>
            <local:FemGlyphFlagsMenu/>
            <TextBlock Text="{DynamicResource Fem3DLoadDisplay}" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <ComboBox Width="180" ItemsSource="{Binding DiagramLoadSources}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedDiagramLoadSource, Mode=TwoWay}"/>
            <Separator/>
            <Button Style="{StaticResource IconButton25}"
                    Command="{Binding Editor.DiscretizeCommand, ElementName=root}"
                    ToolTip="{DynamicResource FemDiscretize}">
                <Path Data="M2,11 H22 V13 H2 Z M6,7 V17 H8 V7 Z M11,7 V17 H13 V7 Z M16,7 V17 H18 V7 Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </Button>
            <Button Style="{StaticResource IconButton25}"
                    Command="{Binding Editor.MergeNodesCommand, ElementName=root}"
                    ToolTip="{DynamicResource FemMergeNodes}">
                <Path Data="M9,12 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 M15,12 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" Fill="Black" Stretch="Uniform" Margin="2"/>
            </Button>
        </ToolBar>

        <!-- Мозаика по КЭ — отдельной строкой: в общей панели её списки уходили в скрытую часть (overflow);
             сворачивается кнопкой и сама при просмотре схемы без результата и мозаики -->
        <Border x:Name="mosaicBar" Grid.Row="1" BorderThickness="0,0,0,1" Padding="2"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="collapseMosaicBarButton" Style="{StaticResource IconButton25}" Click="CollapseMosaicBar_Click"
                        ToolTip="{DynamicResource Fem3DMosaicBarCollapse}">
                    <Path Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z" Fill="Black" Stretch="Uniform" Margin="4"/>
                </Button>
                <Button x:Name="expandEditBarButton" Style="{StaticResource IconButton25}" Visibility="Collapsed"
                        Click="ExpandEditBar_Click" ToolTip="{DynamicResource Fem3DEditBarExpand}">
                    <Path Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z" Fill="Black" Stretch="Uniform" Margin="4"/>
                </Button>
                <!-- Фрагмент: изоляция и скрытие выбранного и групп; работает для всех мозаик -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="fragmentShowOnlyButton" Style="{StaticResource IconButton25}" Click="FragmentShowOnly_Click"
                            ToolTip="{DynamicResource Fem3DFragmentShowOnly}">
                        <Path Data="M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9M12,4.5C17,4.5 21.27,7.61 23,12C21.27,16.39 17,19.5 12,19.5C7,19.5 2.73,16.39 1,12C2.73,7.61 7,4.5 12,4.5M3.18,12C4.83,15.36 8.24,17.5 12,17.5C15.76,17.5 19.17,15.36 20.82,12C19.17,8.64 15.76,6.5 12,6.5C8.24,6.5 4.83,8.64 3.18,12Z" Fill="Black" Stretch="Uniform" Margin="3"/>
                    </Button>
                    <Button x:Name="fragmentHideButton" Style="{StaticResource IconButton25}" Click="FragmentHide_Click"
                            ToolTip="{DynamicResource Fem3DFragmentHide}">
                        <Path Data="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8,5.2L10.17,7.35C10.74,7.13 11.35,7 12,7Z" Fill="Black" Stretch="Uniform" Margin="3"/>
                    </Button>
                    <Button Style="{StaticResource IconButton25}" Click="FragmentInvert_Click"
                            IsEnabled="{Binding IsFragmentActive}" ToolTip="{DynamicResource Fem3DFragmentInvert}">
                        <Path Data="M21,9L17,5V8H10V10H17V13M7,11L3,15L7,19V16H14V14H7V11Z" Fill="Black" Stretch="Uniform" Margin="3"/>
                    </Button>
                    <Button Style="{StaticResource IconButton25}" Click="FragmentShowAll_Click"
                            IsEnabled="{Binding IsFragmentActive}" ToolTip="{DynamicResource Fem3DFragmentShowAll}">
                        <Path Data="M9,9H15V15H9M7,17H17V7H7M15,5H17V3H15M15,21H17V19H15M19,17H21V15H19M19,9H21V7H19M19,21A2,2 0 0,0 21,19H19M19,13H21V11H19M11,21H13V19H11M9,3H7V5H9M3,17H5V15H3M5,21V19H3A2,2 0 0,0 5,21M19,3V5H21A2,2 0 0,0 19,3M13,3H11V5H13M3,9H5V7H3M7,21H9V19H7M3,13H5V11H3M3,5H5V3A2,2 0 0,0 3,5Z" Fill="Black" Stretch="Uniform" Margin="3"/>
                    </Button>
                    <Menu VerticalAlignment="Center" Background="Transparent">
                        <MenuItem x:Name="fragmentGroupsMenu" helpers:CommandIcons.Header="Fem3DFragmentGroups"
                                  ToolTip="{DynamicResource Fem3DFragmentGroupsTip}" SubmenuOpened="FragmentGroupsMenu_SubmenuOpened">
                            <MenuItem Header="…"/>
                        </MenuItem>
                    </Menu>
                    <ToggleButton x:Name="ghostCheck" Style="{StaticResource IconToggleButton25}" Click="GhostToggle_Click"
                                  ToolTip="{DynamicResource Fem3DFragmentGhost}">
                        <Path Data="M12,2A9,9 0 0,0 3,11V22L6,19L9,22L12,19L15,22L18,19L21,22V11A9,9 0 0,0 12,2M9,8A2,2 0 0,1 11,10A2,2 0 0,1 9,12A2,2 0 0,1 7,10A2,2 0 0,1 9,8M15,8A2,2 0 0,1 17,10A2,2 0 0,1 15,12A2,2 0 0,1 13,10A2,2 0 0,1 15,8Z" Fill="Gray" Stretch="Uniform" Margin="3"/>
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton25}" Click="ZoomExtents_Click"
                            ToolTip="{DynamicResource Fem3DZoomExtents}">
                        <Path Data="M10,21V19H6.41L10.91,14.5L9.5,13.09L5,17.59V14H3V21H10M14.5,10.91L19,6.41V10H21V3H14V5H17.59L13.09,9.5L14.5,10.91M3,3V10H5V6.41L9.5,10.91L10.91,9.5L6.41,5H10V3H3M21,21V14H19V17.59L14.5,13.09L13.09,14.5L17.59,19H14V21H21Z" Fill="Black" Stretch="Uniform" Margin="3"/>
                    </Button>
                    <TextBlock Text="{Binding FragmentText}" VerticalAlignment="Center" Margin="4,0" Foreground="DarkSlateBlue"/>
                    <Rectangle Width="1" Margin="4,3" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                </StackPanel>
                <!-- Мозаика C1 упругого основания одной кнопкой (то же — «Показать на схеме» в дереве) -->
                <ToggleButton Style="{StaticResource IconToggleButton25}" VerticalAlignment="Center"
                              IsChecked="{Binding Mosaic.IsFoundationShown, Mode=TwoWay}"
                              Visibility="{Binding Mosaic.HasFoundation, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="{DynamicResource Fem3DFoundationMosaic}">
                    <Image Source="{StaticResource FemIcon_Foundation}" Width="18" Height="18"/>
                </ToggleButton>
                <mosaic:PlateRebarMosaicSelector DataContext="{Binding Mosaic}" HorizontalAlignment="Left"/>
            </WrapPanel>
        </Border>

        <!-- Строка 3 — шаг и деформированная схема показанного результата расчёта -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="2"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                Visibility="{Binding Mosaic.IsResultActive, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel DataContext="{Binding Mosaic.ActiveResult}">
                <!-- Вид: сетка и глифы — те же, что в строке редактирования (она при результате обычно свёрнута) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding DataContext, ElementName=root}">
                    <ToggleButton Style="{StaticResource IconToggleButton25}" ToolTip="{DynamicResource Fem3DShowGrid}"
                                  IsChecked="{Binding IsChecked, ElementName=showGridCheck, Mode=TwoWay}">
                        <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,11H13V5H19V11M11,5V11H5V5H11M5,19V13H11V19H5M13,19V13H19V19H13Z" Fill="Black" Stretch="Uniform" Margin="2"/>
                    </ToggleButton>
                    <local:FemGlyphFlagsMenu/>
                    <Rectangle Width="1" Margin="4,3" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                    <!-- Режим выбора в результате: конструктивные элементы целиком или отдельные КЭ (и узлы) -->
                    <ToggleButton x:Name="resultPickMembers" Padding="2,1" VerticalAlignment="Center" Click="ResultPickMode_Click">
                        <ToggleButton.ToolTip>
                            <TextBlock>
                                <Run Text="{DynamicResource FemResultPickMembers}" FontWeight="SemiBold"/><LineBreak/>
                                <Run Text="{DynamicResource FemResultPickMembersTip}"/>
                            </TextBlock>
                        </ToggleButton.ToolTip>
                        <Image Width="24" Height="24" SnapsToDevicePixels="True" Source="{DynamicResource FemIcon_Members}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="resultPickElements" Padding="2,1" Margin="-1,0,0,0" VerticalAlignment="Center" Click="ResultPickMode_Click">
                        <ToggleButton.ToolTip>
                            <TextBlock>
                                <Run Text="{DynamicResource FemResultPickElements}" FontWeight="SemiBold"/><LineBreak/>
                                <Run Text="{DynamicResource FemResultPickElementsTip}"/>
                            </TextBlock>
                        </ToggleButton.ToolTip>
                        <Image Width="24" Height="24" SnapsToDevicePixels="True" Source="{DynamicResource FemIcon_MeshElements}"/>
                    </ToggleButton>
                    <Rectangle Width="1" Margin="4,3" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                </StackPanel>
                <!-- Нелинейный расчёт — шаги ползунком; линейный — загружения и комбинации списком -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowStepSlider, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{DynamicResource FemResultStep}" VerticalAlignment="Center" Margin="4,0"/>
                    <Slider Width="240" Minimum="0" Maximum="{Binding MaxStepIndex}" VerticalAlignment="Center"
                            Value="{Binding SelectedStepIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <TextBlock Text="{Binding StepLabel}" VerticalAlignment="Center" Margin="6,0,12,0" MaxWidth="260"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StepLabel}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowCaseList, Converter={StaticResource BoolToVisibility}}">
                    <local:FemCsfeaCaseSelector DataContext="{Binding Csfea}" Margin="4,0,6,0"/>
                </StackPanel>
                <!-- Деформированная схема: иконка-переключатель, масштаб, сброс, исходная схема под ней -->
                <ToggleButton Style="{StaticResource IconToggleButton25}" IsChecked="{Binding ShowDeformed}"
                              IsEnabled="{Binding CanShowDeformed}" ToolTip="{DynamicResource Fem3DShowDeformedSchema}">
                    <Viewbox Margin="2">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource ResultIconStroke}" Data="M2,7 H22" StrokeDashArray="1.5 1.5" Stroke="Gray"/>
                            <Path Style="{StaticResource ResultIconStroke}" Data="M2,7 C8,20 16,20 22,7"/>
                            <Path Style="{StaticResource ResultIconStroke}" Data="M2,5 V9 M22,5 V9"/>
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding DeformedShown}">
                    <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0,1,0" ToolTip="{DynamicResource Fem3DDisplacementScale}"/>
                    <TextBox Width="55" TextAlignment="Center" VerticalAlignment="Center" ToolTip="{DynamicResource Fem3DDisplacementScale}"
                             Text="{Binding DeformScale, Converter={StaticResource AnyDoubleConv}, ConverterParameter=F2, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                    <Button Style="{StaticResource IconButton25}" ToolTip="{DynamicResource FemResetScale}" Command="{Binding ResetDeformScaleCommand}">
                        <Path Data="M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12C4,14.21 4.9,16.21 6.34,17.65L7.76,16.24C6.67,15.15 6,13.66 6,12A6,6 0 0,1 12,6Z" Fill="Black" Stretch="Uniform" Margin="2"/>
                    </Button>
                    <ToggleButton Style="{StaticResource IconToggleButton25}" IsChecked="{Binding ShowOriginal}">
                        <ToggleButton.ToolTip>
                            <TextBlock>
                                <Run Text="{DynamicResource Fem3DShowOriginalSchema}" FontWeight="SemiBold"/><LineBreak/>
                                <Run Text="{DynamicResource Fem3DShowOriginalSchemaTip}"/>
                            </TextBlock>
                        </ToggleButton.ToolTip>
                        <Viewbox Margin="2">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource ResultIconStroke}" Data="M3,4 H21 V20 H3 Z M12,4 V20 M3,12 H21" StrokeDashArray="2 1.5" Stroke="DimGray"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                </StackPanel>
                <!-- Ширина раскрытия трещин CSfea — доля длительной части усилий шага -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCrackFieldShown, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{DynamicResource FemCsfeaCrackLongShare}" VerticalAlignment="Center" Margin="12,0,2,0"
                               ToolTip="{DynamicResource FemCsfeaCrackLongShareTip}"/>
                    <TextBox Width="50" TextAlignment="Center" VerticalAlignment="Center" ToolTip="{DynamicResource FemCsfeaCrackLongShareTip}"
                             Text="{Binding LongShare, Converter={StaticResource AnyDoubleConv}, ConverterParameter=F2, UpdateSourceTrigger=PropertyChanged, Delay=700}"/>
                    <Button Content="{DynamicResource FemCsfeaCrackLongShareFromSets}" Command="{Binding LongShareFromSetsCommand}"
                            ToolTip="{DynamicResource FemCsfeaCrackLongShareFromSetsTip}" Padding="6,0" Margin="4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LongShareNote}" VerticalAlignment="Center" Margin="2,0" Foreground="Gray"/>
                </StackPanel>
                <!-- Реакции опор CSfea: стрелки сил на виде, множитель длины, итог шага -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasReactions, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle Width="1" Margin="6,3" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                    <ToggleButton Style="{StaticResource IconToggleButton25}" IsChecked="{Binding ShowReactions}">
                        <ToggleButton.ToolTip>
                            <TextBlock>
                                <Run Text="{DynamicResource FemResultShowReactions}" FontWeight="SemiBold"/><LineBreak/>
                                <Run Text="{DynamicResource FemResultShowReactionsTip}"/>
                            </TextBlock>
                        </ToggleButton.ToolTip>
                        <Viewbox Margin="2">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource ResultIconStroke}" Data="M12,13 V2 M8,6 L12,2 L16,6"/>
                                <Path Style="{StaticResource ResultIconStroke}" Data="M12,15 L6,21 H18 Z M4,23 H20"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding ShowReactions}">
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0,1,0" ToolTip="{DynamicResource FemResultReactionScaleTip}"/>
                        <TextBox Width="40" TextAlignment="Center" VerticalAlignment="Center" ToolTip="{DynamicResource FemResultReactionScaleTip}"
                                 Text="{Binding ReactionScale, Converter={StaticResource AnyDoubleConv}, ConverterParameter=F2, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                        <ToggleButton Style="{StaticResource IconToggleButton25}" IsChecked="{Binding ShowReactionValues}"
                                      ToolTip="{DynamicResource FemResultReactionValuesTip}">
                            <TextBlock Text="кН" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
                <Button Content="⋯" ToolTip="{DynamicResource FemResultActionsTip}" Click="ResultActions_Click"
                        Padding="8,0" Margin="8,0,2,0" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <!-- 3D viewport -->
        <h:HelixViewport3D x:Name="viewport" Grid.Row="2"
                           Background="White"
                           ShowCoordinateSystem="True"
                           ShowViewCube="True"
                           ZoomAroundMouseDownPoint="True"/>

        <!-- Легенда мозаики армирования пластин -->
        <mosaic:PlateRebarMosaicLegend Grid.Row="2" DataContext="{Binding Mosaic}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="8" Panel.ZIndex="10"/>

        <!-- Подписи результата в области 3D (как в ЛИРЕ/RFEM): шапка — расчёт и показанное, низ — min/max и ΣR -->
        <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="80,0,80,6" Padding="8,3"
                Background="#D8FFFFFF" CornerRadius="3" Panel.ZIndex="11" IsHitTestVisible="False"
                DataContext="{Binding Mosaic.ActiveResult}" Visibility="{Binding Converter={StaticResource NullToCollapsedConv}}">
            <StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding BarSummaryText}" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding HasBarSummary, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding ReactionSummaryText}" Foreground="DimGray" HorizontalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding HasReactions, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Panel.ZIndex="12">
        <Border Padding="6,2" Background="#D8FFFFFF" CornerRadius="3" HorizontalAlignment="Left" IsHitTestVisible="False"
                DataContext="{Binding Mosaic.ActiveResult}" Visibility="{Binding Converter={StaticResource NullToCollapsedConv}}">
            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="700"/>
        </Border>
        <!-- Карточка значений выбранного в результате расчёта (узел, КЭ, КонЭ) -->
        <Border x:Name="resultCard" HorizontalAlignment="Left" Margin="0,4,0,0"
                Padding="8,4,8,6" Background="#F2FFFFFF" BorderBrush="Gray" BorderThickness="1" CornerRadius="3"
                DataContext="{Binding Mosaic.ActiveResult.Card, FallbackValue={x:Null}}"
                Visibility="{Binding Converter={StaticResource NullToCollapsedConv}}">
            <StackPanel Grid.IsSharedSizeScope="True" MaxWidth="420">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" Margin="8,0,0,0" BorderThickness="0" Background="Transparent"
                            VerticalAlignment="Top" ToolTip="{DynamicResource FemResultCardCloseTip}" Click="ResultCardClose_Click"/>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="label"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Foreground="DimGray" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Значение КЭ мозаики у курсора -->
        <Border x:Name="mosaicHoverTip" Grid.Row="2" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="5,2" Background="#F0FFFFE1" BorderBrush="Gray" BorderThickness="1" CornerRadius="2"
                Panel.ZIndex="15">
            <TextBlock Text="{Binding Mosaic.HoverText}"/>
        </Border>

        <!-- Немодальная панель «Добавить узел» -->
        <Border x:Name="createNodePanel" Grid.Row="2"
                Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8" Padding="10" Background="#F0FFFFFF"
                BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                Panel.ZIndex="20">
            <StackPanel Width="200">
                <Grid>
                    <TextBlock Text="{DynamicResource FemCreateNodePanelTitle}" FontWeight="Bold"/>
                    <Button Content="{DynamicResource FemPanelClose}"
                            HorizontalAlignment="Right" Padding="4,0"
                            Click="CloseCreateNodePanel_Click"/>
                </Grid>
                <TextBlock Text="{DynamicResource FemCreateNodeHint}"
                           TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,8"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource FemCreateNodeX}" Grid.Column="0"/>
                    <TextBox x:Name="createNodeXBox" Grid.Column="1" Text="0"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource FemCreateNodeY}" Grid.Column="0"/>
                    <TextBox x:Name="createNodeYBox" Grid.Column="1" Text="0"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource FemCreateNodeZ}" Grid.Column="0"/>
                    <TextBox x:Name="createNodeZBox" Grid.Column="1" Text="0"/>
                </Grid>
                <Button Content="{DynamicResource FemCreateNodeAdd}" Margin="0,8,0,0"
                        Click="CreateNodeFromPanel_Click"/>
            </StackPanel>
        </Border>

        <!-- Немодальная панель «Добавить элемент» -->
        <Border x:Name="createBarPanel" Grid.Row="2"
                Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8" Padding="10" Background="#F0FFFFFF"
                BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                Panel.ZIndex="20">
            <StackPanel Width="220">
                <Grid>
                    <TextBlock Text="{DynamicResource FemCreateMemberPanelTitle}" FontWeight="Bold"/>
                    <Button Content="{DynamicResource FemPanelClose}"
                            HorizontalAlignment="Right" Padding="4,0"
                            Click="CloseCreateBarPanel_Click"/>
                </Grid>
                <TextBlock Text="{DynamicResource FemCreateMemberHint}"
                           TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,8"/>
                <TextBlock Text="{DynamicResource FemCreateMemberSection}" Margin="0,2"/>
                <ComboBox x:Name="createBarSectionCombo"
                          DisplayMemberPath="Tag"
                          SelectionChanged="CreateBarSectionCombo_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Командная строка «Переместить» / «Копировать» (как в AutoCAD) -->
        <Border x:Name="transformBar" Grid.Row="2" Visibility="Collapsed"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                Margin="8" Padding="8,4" Background="#F2FFFFFF"
                BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Panel.ZIndex="25">
            <DockPanel LastChildFill="True">
                <Image x:Name="transformIcon" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Margin="6,0,0,0" BorderThickness="0" Background="Transparent"
                        VerticalAlignment="Center" ToolTip="{DynamicResource FemTransformCloseTip}" Click="TransformClose_Click"/>
                <ToggleButton DockPanel.Dock="Right" Content="{DynamicResource FemTransformOrtho}" IsChecked="{Binding Ortho}"
                              Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False"/>
                <TextBox x:Name="transformInput" DockPanel.Dock="Right" Width="170" VerticalAlignment="Center"
                         PreviewKeyDown="TransformInput_PreviewKeyDown"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="transformStatus" Foreground="Gray" FontSize="11"/>
                    <TextBlock Text="{Binding Message}" Foreground="#D9480F" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Режим «Грани пластин» (линейные связи) -->
        <Border x:Name="edgePickBar" Grid.Row="2" Visibility="Collapsed"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                Margin="8" Padding="8,4" Background="#F2FFFFFF"
                BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Panel.ZIndex="25">
            <DockPanel LastChildFill="True">
                <Image Source="{StaticResource CmdIcon_LineSupport}" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Margin="6,0,0,0" BorderThickness="0" Background="Transparent"
                        VerticalAlignment="Center" ToolTip="{DynamicResource FemLineSupportPickExit}" Click="EdgePickClose_Click"/>
                <Button DockPanel.Dock="Right" Content="{DynamicResource FemLineSupportMenu}" Padding="8,1" Margin="6,0,0,0"
                        VerticalAlignment="Center" Click="EdgePickAssign_Click"/>
                <TextBlock x:Name="edgePickStatus" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Оверлей загрузки -->
        <Border Grid.Row="2"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                Background="#80000000" Panel.ZIndex="10">
            <TextBlock Text="{Binding Status}"
                       Foreground="White" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Оверлей «нет данных» -->
        <Border Grid.Row="2"
                Visibility="{Binding NoData, Converter={StaticResource BoolToVisibility}}"
                Background="#80000000" Panel.ZIndex="10">
            <TextBlock Text="{DynamicResource Fem3DNoData}"
                       Foreground="White" FontSize="13" TextWrapping="Wrap"
                       MaxWidth="400"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
