<UserControl x:Class="OpenCS.Views.TotalCurvatureSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12,8">
         <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <TextBlock Text="{Binding TaskTag}" FontSize="14" FontWeight="Bold"
                       Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}" FontSize="13"
                       Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
         </StackPanel>
         <TextBlock Text="{Binding CreatedText}" Foreground="Gray" Margin="0,0,0,10"/>

         <TextBlock Text="{DynamicResource TotalCurvature_InputHeader}" FontWeight="Bold" Margin="0,0,0,4"/>
         <TextBlock><Run Text="{DynamicResource TotalCurvature_LabelNColon}"/><Run Text="{Binding NText, Mode=OneWay}"/></TextBlock>
         <TextBlock><Run Text="{DynamicResource TotalCurvature_LabelMxLongColon}"/><Run Text="{Binding MxLongText, Mode=OneWay}"/></TextBlock>
         <TextBlock><Run Text="{DynamicResource TotalCurvature_LabelMxTotalColon}"/><Run Text="{Binding MxTotalText, Mode=OneWay}"/></TextBlock>
         <TextBlock><Run Text="{DynamicResource TotalCurvature_LabelMyLongColon}"/><Run Text="{Binding MyLongText, Mode=OneWay}"/></TextBlock>
         <TextBlock><Run Text="{DynamicResource TotalCurvature_LabelMyTotalColon}"/><Run Text="{Binding MyTotalText, Mode=OneWay}"/></TextBlock>

         <TextBlock Text="{Binding CrackedText}" FontWeight="Bold" Margin="0,10,0,4"/>
         <TextBlock><Run Text="{DynamicResource TotalCurvature_LabelMcrcColon}"/><Run Text="{Binding McrcText, Mode=OneWay}"/></TextBlock>
         <TextBlock><Run Text="{DynamicResource TotalCurvature_LabelMxCrcColon}"/><Run Text="{Binding MxCrcText, Mode=OneWay}"/></TextBlock>
         <TextBlock><Run Text="{DynamicResource TotalCurvature_LabelMyCrcColon}"/><Run Text="{Binding MyCrcText, Mode=OneWay}"/></TextBlock>

         <StackPanel Margin="0,10,0,2"
                     Visibility="{Binding HasStage1, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
               <Button DockPanel.Dock="Right" Content="{DynamicResource TotalCurvature_StagePlotButton}"
                       ToolTip="{Binding Stage1PlotTooltip}"
                       IsEnabled="{Binding CanPlotStage1, Mode=OneWay}"
                       Click="StagePlot_Click" Tag="1"
                       Padding="8,3" Margin="12,0,0,0"/>
               <TextBlock Text="{Binding Stage1Label}" FontWeight="Bold"
                          VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding Stage1Text}"/>
         </StackPanel>
         <StackPanel Margin="0,10,0,2"
                     Visibility="{Binding HasStage2, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
               <Button DockPanel.Dock="Right" Content="{DynamicResource TotalCurvature_StagePlotButton}"
                       ToolTip="{Binding Stage2PlotTooltip}"
                       IsEnabled="{Binding CanPlotStage2, Mode=OneWay}"
                       Click="StagePlot_Click" Tag="2"
                       Padding="8,3" Margin="12,0,0,0"/>
               <TextBlock Text="{Binding Stage2Label}" FontWeight="Bold"
                          VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding Stage2Text}"/>
         </StackPanel>
         <StackPanel Margin="0,10,0,2"
                     Visibility="{Binding HasStage3, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
               <Button DockPanel.Dock="Right" Content="{DynamicResource TotalCurvature_StagePlotButton}"
                       ToolTip="{Binding Stage3PlotTooltip}"
                       IsEnabled="{Binding CanPlotStage3, Mode=OneWay}"
                       Click="StagePlot_Click" Tag="3"
                       Padding="8,3" Margin="12,0,0,0"/>
               <TextBlock Text="{Binding Stage3Label}" FontWeight="Bold"
                          VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding Stage3Text}"/>
         </StackPanel>

         <TextBlock Text="{DynamicResource TotalCurvature_ResultHeader}" FontWeight="Bold" Margin="0,10,0,4"/>
         <TextBlock><Run Text="{DynamicResource TotalCurvature_LabelKyFullColon}"/><Run Text="{Binding KyFullText, Mode=OneWay}"/></TextBlock>
         <TextBlock><Run Text="{DynamicResource TotalCurvature_LabelKzFullColon}"/><Run Text="{Binding KzFullText, Mode=OneWay}"/></TextBlock>
         <TextBlock><Run Text="{DynamicResource TotalCurvature_LabelKFullColon}"/><Run Text="{Binding KFullText, Mode=OneWay}"/></TextBlock>

         <GroupBox Header="{DynamicResource ResultStiffness}"
                   Margin="0,10,0,6" Padding="8,4"
                   Visibility="{Binding HasStiffness, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
               <TextBlock Text="{DynamicResource TotalCurvature_StiffnessNote}"
                          Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"/>
               <ItemsControl ItemsSource="{Binding StiffnessRows}">
                  <ItemsControl.ItemTemplate>
                     <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                           <TextBlock Text="{Binding StageLabel}" FontWeight="Bold" Margin="0,0,0,2"/>
                           <Grid>
                              <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="110"/>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="110"/>
                                 <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                              </Grid.RowDefinitions>
                              <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource TotalCurvature_StiffnessXc}" Foreground="Gray" Margin="0,1"/>
                              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding XcText}" FontFamily="Consolas" Margin="0,1"/>
                              <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource TotalCurvature_StiffnessYc}" Foreground="Gray" Margin="0,1"/>
                              <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding YcText}" FontFamily="Consolas" Margin="0,1"/>
                              <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource TotalCurvature_StiffnessEA}" Foreground="Gray" Margin="0,1"/>
                              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EAText}" FontFamily="Consolas" Margin="0,1"/>
                              <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource TotalCurvature_StiffnessEIy0}" Foreground="Gray" Margin="0,1"/>
                              <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding EIy0Text}" FontFamily="Consolas" Margin="0,1"/>
                              <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource TotalCurvature_StiffnessEIz0}" Foreground="Gray" Margin="0,1"/>
                              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EIz0Text}" FontFamily="Consolas" Margin="0,1"/>
                              <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource TotalCurvature_StiffnessEIyc}" Foreground="Gray" Margin="0,1"/>
                              <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding EIycText}" FontFamily="Consolas" Margin="0,1"/>
                              <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource TotalCurvature_StiffnessEIzc}" Foreground="Gray" Margin="0,1"/>
                              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EIzcText}" FontFamily="Consolas" Margin="0,1"/>
                           </Grid>
                        </StackPanel>
                     </DataTemplate>
                  </ItemsControl.ItemTemplate>
               </ItemsControl>
            </StackPanel>
         </GroupBox>

         <GroupBox Header="{DynamicResource ResultElasticStiffness}"
                   Margin="0,0,0,6" Padding="8,4"
                   Visibility="{Binding HasStiffness, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding StiffnessRows}">
               <ItemsControl.ItemTemplate>
                  <DataTemplate>
                     <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding StageLabel}" FontWeight="Bold" Margin="0,0,0,2"/>
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="110"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="110"/>
                              <ColumnDefinition Width="*"/>
                           </Grid.ColumnDefinitions>
                           <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                           </Grid.RowDefinitions>
                           <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource TotalCurvature_StiffnessEAel}" Foreground="Gray" Margin="0,1"/>
                           <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EAelText}" FontFamily="Consolas" Margin="0,1"/>
                           <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource TotalCurvature_StiffnessEIyel}" Foreground="Gray" Margin="0,1"/>
                           <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding EIyelText}" FontFamily="Consolas" Margin="0,1"/>
                           <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource TotalCurvature_StiffnessEIzel}" Foreground="Gray" Margin="0,1"/>
                           <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EIzelText}" FontFamily="Consolas" Margin="0,1"/>
                           <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource TotalCurvature_StiffnessPhiEA}" Foreground="Gray" Margin="0,1"/>
                           <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PhiEAText}" FontFamily="Consolas" Margin="0,1"/>
                           <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource TotalCurvature_StiffnessPhiEIy}" Foreground="Gray" Margin="0,1"/>
                           <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PhiEIyText}" FontFamily="Consolas" Margin="0,1"/>
                           <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource TotalCurvature_StiffnessPhiEIz}" Foreground="Gray" Margin="0,1"/>
                           <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PhiEIzText}" FontFamily="Consolas" Margin="0,1"/>
                        </Grid>
                     </StackPanel>
                  </DataTemplate>
               </ItemsControl.ItemTemplate>
            </ItemsControl>
         </GroupBox>

         <TextBlock Text="{Binding ErrorText}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
      </StackPanel>
   </ScrollViewer>
</UserControl>
