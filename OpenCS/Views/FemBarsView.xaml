<UserControl x:Class="OpenCS.Views.FemBarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OpenCS.Views.Helpers">
   <DockPanel>
      <ToolBar DockPanel.Dock="Top">
         <Button Content="{DynamicResource FemMembersGroupFromSelection}" Click="CreateGroup_Click" Margin="0,0,4,0"/>
         <Button Content="{DynamicResource FemGroupAuto}"   Click="AutoGroup_Click"/>
         <Separator/>
         <Button Content="{DynamicResource FemGroupAddTo}"      Click="AddToGroup_Click" Margin="4,0,4,0"/>
         <Button Content="{DynamicResource FemGroupRemoveFrom}" Click="RemoveFromGroup_Click"/>
         <Separator/>
         <Button Content="{DynamicResource FemCheckAdd}"
                 Command="{Binding DataContext.AddFemCheckCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
      </ToolBar>
      <DataGrid x:Name="barsGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                SelectionMode="Extended"
                EnableRowVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True">
         <DataGrid.ContextMenu>
            <ContextMenu>
               <MenuItem helpers:CommandIcons.Header="FemBarDiagramMenu" Click="ShowDiagrams_Click"/>
               <MenuItem x:Name="liraForcesMenu" helpers:CommandIcons.Header="ImportSubMenuLiraForces">
                  <MenuItem helpers:CommandIcons.Header="ImportLiraForcesFromApi" Tag="lc"  Click="ImportLiraForces_Click"/>
                  <MenuItem helpers:CommandIcons.Header="ImportLiraRsnFromApi"    Tag="rsn" Click="ImportLiraForces_Click"/>
                  <MenuItem helpers:CommandIcons.Header="ImportLiraRsuFromApi"    Tag="rsu" Click="ImportLiraForces_Click"/>
               </MenuItem>
               <MenuItem x:Name="scadForcesMenu" helpers:CommandIcons.Header="ImportSubMenuScadForces">
                  <MenuItem helpers:CommandIcons.Header="ScadForcesLoadCasesFromApi"    Tag="lc"  Click="ImportScadForces_Click"/>
                  <MenuItem helpers:CommandIcons.Header="ScadForcesCombinationsFromApi" Tag="rsn" Click="ImportScadForces_Click"/>
                  <MenuItem helpers:CommandIcons.Header="ScadForcesRsuFromApi"          Tag="rsu" Click="ImportScadForces_Click"/>
               </MenuItem>
            </ContextMenu>
         </DataGrid.ContextMenu>
         <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource FemElemTag}"  Binding="{Binding ElemTag}"    Width="80"/>
            <DataGridTextColumn Header="{DynamicResource FemSection}"  Binding="{Binding SectionTag}" Width="120"/>
            <DataGridTextColumn Header="{DynamicResource FemNodeTag1}" Binding="{Binding Node1}"      Width="80"/>
            <DataGridTextColumn Header="{DynamicResource FemNodeTag2}" Binding="{Binding Node2}"      Width="80"/>
         </DataGrid.Columns>
      </DataGrid>
   </DockPanel>
</UserControl>
