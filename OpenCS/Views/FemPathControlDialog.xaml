<Window x:Class="OpenCS.Views.FemPathControlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:util="clr-namespace:OpenCS.Utilites"
        Title="{DynamicResource FemPathControlDialogTitle}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <util:AnyDoubleConverter x:Key="AnyDoubleConverter"/>
    </Window.Resources>
    <StackPanel Margin="12">
        <StackPanel x:Name="ContinuationPanel" Visibility="Collapsed">
            <CheckBox x:Name="ContinuationEnabledCb" Content="{DynamicResource FemPathControlContinuationEnable}" Margin="0,0,0,8"/>
            <ComboBox x:Name="ContinuationModeBox" DisplayMemberPath="Label" Margin="0,0,0,8"/>
        </StackPanel>

        <GroupBox Header="{DynamicResource FemPathControlDisplacementGroup}" x:Name="DisplacementGroup" Margin="0,0,0,8">
            <StackPanel Margin="4">
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlNodeLabel}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="ControlNodeBox" DisplayMemberPath="NodeTag" SelectedValuePath="Id"/>
                </Grid>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlDofLabel}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="ControlDofBox" DisplayMemberPath="Label"/>
                </Grid>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlInitialIncrementLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="InitialIncrementBox"/>
                </Grid>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlMinIncrementLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="MinIncrementBox"/>
                </Grid>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlMaxIncrementLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="MaxIncrementBox"/>
                </Grid>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlTargetDisplacementLabel}"
                               ToolTip="{DynamicResource FemPathControlTargetDisplacementTip}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TargetDisplacementBox"/>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlMaxStepsLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="DisplacementMaxStepsBox"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{DynamicResource FemPathControlArcLengthGroup}" x:Name="ArcLengthGroup" Margin="0,0,0,8">
            <StackPanel Margin="4">
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlArcLengthSLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="ArcLengthSBox"/>
                </Grid>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlArcLengthAlphaLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="ArcLengthAlphaBox"/>
                </Grid>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlArcLengthMinSLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="ArcLengthMinSBox"/>
                </Grid>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlMaxStepsLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="ArcLengthMaxStepsBox"/>
                </Grid>
                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlMonitorNodeLabel}"
                               ToolTip="{DynamicResource FemPathControlMonitorNodeTip}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="MonitorNodeBox" DisplayMemberPath="NodeTag" SelectedValuePath="Id"/>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource FemPathControlDofLabel}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="MonitorDofBox" DisplayMemberPath="Label"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource OK}" Click="Ok_Click" Padding="16,4" MinWidth="80" x:Name="OkButton"/>
            <Button Content="{DynamicResource Cancel}" Click="Cancel_Click" Padding="16,4" MinWidth="80" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
