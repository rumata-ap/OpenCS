<UserControl x:Class="OpenCS.Views.TotalCurvatureBatchResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <Grid Margin="12">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Padding="8,6" CornerRadius="4" Background="{Binding StatusBrush}" Margin="0,0,0,8">
         <TextBlock Text="{Binding SummaryText}" FontWeight="Bold" HorizontalAlignment="Center"/>
      </Border>
      <DataGrid Grid.Row="1" x:Name="RowsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow"
                MouseDoubleClick="RowsGrid_MouseDoubleClick">
         <DataGrid.ContextMenu>
            <ContextMenu>
               <MenuItem Header="{DynamicResource CalcTaskNew}"
                         Click="CreateTask_Click"/>
            </ContextMenu>
         </DataGrid.ContextMenu>
         <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
               <Style.Triggers>
                  <DataTrigger Binding="{Binding IsConverged}" Value="True">
                     <Setter Property="Background" Value="#1A2D7A3E"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsConverged}" Value="False">
                     <Setter Property="Background" Value="#1AC0392B"/>
                  </DataTrigger>
               </Style.Triggers>
            </Style>
         </DataGrid.RowStyle>
         <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColNum}" Binding="{Binding Num}" Width="40"/>
            <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColLabel}" Binding="{Binding Label}" Width="*"/>
            <DataGridTextColumn Header="{DynamicResource TotalCurvature_ColN}" Binding="{Binding NText}" Width="75"/>
            <DataGridTextColumn Header="{DynamicResource TotalCurvature_ColMxTotal}" Binding="{Binding MxTotalText}" Width="90"/>
            <DataGridTextColumn Header="{DynamicResource TotalCurvature_ColMyTotal}" Binding="{Binding MyTotalText}" Width="90"/>
            <DataGridTextColumn Header="{DynamicResource TotalCurvature_LabelMcrc}" Binding="{Binding McrcText}" Width="90"/>
            <DataGridTextColumn Header="{DynamicResource TotalCurvature_ColCracked}" Binding="{Binding CrackedText}" Width="90"/>
            <DataGridTextColumn Header="{DynamicResource TotalCurvature_ColKyFull}" Binding="{Binding KyFullText}" Width="100"/>
            <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColStatus}" Binding="{Binding StatusText}" Width="70"/>
         </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
         <Button Content="{DynamicResource CalcTaskNew}"
                 Click="CreateTask_Click"
                 Padding="12,4"
                 x:Name="CreateTaskBtn" IsEnabled="False"/>
      </StackPanel>
   </Grid>
</UserControl>
