<Window x:Class="OpenCS.Views.ScadForceImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ScadForceImportDialogTitle}"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
   <StackPanel Margin="12">
      <TextBlock Text="{DynamicResource ScadForceImportElementsLabel}" Margin="0,0,0,6"/>

      <DockPanel LastChildFill="True">
         <Button x:Name="FromMemberButton"
                 DockPanel.Dock="Right"
                 Content="{DynamicResource ScadForceImportFromMember}"
                 Click="FromMember_Click"
                 Margin="8,0,0,0"
                 Padding="8,4"
                 MinWidth="140"/>
         <TextBox x:Name="ElementsBox"
                  VerticalContentAlignment="Center"
                  ToolTip="{DynamicResource ElemRangeHint}"
                  TextChanged="ElementsBox_TextChanged"/>
      </DockPanel>
      <TextBlock x:Name="ElementsErrorText" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,2,0,0"
                 Visibility="Collapsed"/>

      <CheckBox x:Name="AllElementsCheck"
                Content="{DynamicResource ScadForceImportAllElements}"
                Margin="0,8,0,0"
                Checked="AllElements_Changed"
                Unchecked="AllElements_Changed"/>

      <TextBlock x:Name="BindHintText" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
         <Button x:Name="OkButton"
                 Content="{DynamicResource ScadForceImportOk}"
                 IsDefault="True"
                 IsEnabled="False"
                 Click="Ok_Click"
                 MinWidth="90"
                 Margin="0,0,8,0"
                 Padding="10,4"/>
         <Button Content="{DynamicResource ScadForceImportCancel}"
                 IsCancel="True"
                 MinWidth="90"
                 Padding="10,4"/>
      </StackPanel>
   </StackPanel>
</Window>
