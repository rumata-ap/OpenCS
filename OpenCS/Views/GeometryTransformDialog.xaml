<Window x:Class="OpenCS.Views.GeometryTransformDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="260" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <StackPanel x:Name="movePanel">
            <TextBlock Text="{DynamicResource GeometryTransformDx}"/>
            <TextBox x:Name="dxBox" Text="0"/>
            <TextBlock Text="{DynamicResource GeometryTransformDy}" Margin="0,8,0,0"/>
            <TextBox x:Name="dyBox" Text="0"/>
        </StackPanel>
        <StackPanel x:Name="scalePanel">
            <TextBlock Text="{DynamicResource GeometryTransformFactor}"/>
            <TextBox x:Name="factorBox" Text="1"/>
        </StackPanel>
        <StackPanel x:Name="rotatePanel">
            <TextBlock Text="{DynamicResource GeometryTransformAngleDeg}"/>
            <TextBox x:Name="angleBox" Text="0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource OK}" Click="Ok_Click" Padding="16,4" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="{DynamicResource Cancel}" Click="Cancel_Click" Padding="16,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
