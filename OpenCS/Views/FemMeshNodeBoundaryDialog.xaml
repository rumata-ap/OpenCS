<Window x:Class="OpenCS.Views.FemMeshNodeBoundaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenCS.Views"
        Title="{DynamicResource FemMeshNodeBoundaryTitle}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="headerText" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="originText" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>

        <TextBlock Text="{DynamicResource FemBoundaryGlobalAxes}" Foreground="Gray" Margin="0,10,0,4"/>
        <local:FemBoundaryDofEditor x:Name="editor"/>

        <TextBlock x:Name="importHint" Text="{DynamicResource FemMeshNodeBoundaryImportHint}" TextWrapping="Wrap"
                   Foreground="DarkGoldenrod" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource OK}" IsDefault="True" Click="Ok_Click" Padding="20,4" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Cancel}" IsCancel="True" Padding="16,4"/>
        </StackPanel>
    </StackPanel>
</Window>
