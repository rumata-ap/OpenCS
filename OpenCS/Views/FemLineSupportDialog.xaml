<Window x:Class="OpenCS.Views.FemLineSupportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FemLineSupportTitle}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="headerText" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="edgesText" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>

        <TextBlock Text="{DynamicResource FemLineSupportPresets}" Margin="0,10,0,2"/>
        <StackPanel Orientation="Horizontal">
            <StackPanel.Resources>
                <Style x:Key="PresetButton" TargetType="Button">
                    <Setter Property="Width" Value="36"/>
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
                </Style>
            </StackPanel.Resources>
            <Button Style="{StaticResource PresetButton}" Click="PresetPlate_Click" Margin="0,0,6,4">
                <Button.ToolTip>
                    <StackPanel MaxWidth="360">
                        <TextBlock Text="{DynamicResource FemLineSupportPresetPlate}" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource FemLineSupportPresetPlateTip}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button.ToolTip>
                <Image Source="{StaticResource CmdIcon_LineSupportPlate}" Width="24" Height="24"/>
            </Button>
            <Button Style="{StaticResource PresetButton}" Click="PresetHinge_Click" Margin="0,0,6,4">
                <Button.ToolTip>
                    <StackPanel MaxWidth="360">
                        <TextBlock Text="{DynamicResource FemLineSupportPresetHinge}" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource FemLineSupportPresetHingeTip}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button.ToolTip>
                <Image Source="{StaticResource CmdIcon_LineSupportHinge}" Width="24" Height="24"/>
            </Button>
            <Button Style="{StaticResource PresetButton}" Click="PresetFixed_Click" Margin="0,0,6,4">
                <Button.ToolTip>
                    <StackPanel MaxWidth="360">
                        <TextBlock Text="{DynamicResource FemLineSupportPresetFixed}" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource FemLineSupportPresetFixedTip}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button.ToolTip>
                <Image Source="{StaticResource CmdIcon_LineSupportFixed}" Width="24" Height="24"/>
            </Button>
            <Button Style="{StaticResource PresetButton}" Click="PresetNone_Click" Margin="0,0,0,4">
                <Button.ToolTip>
                    <StackPanel MaxWidth="360">
                        <TextBlock Text="{DynamicResource FemLineSupportPresetNone}" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource FemLineSupportPresetNoneTip}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button.ToolTip>
                <Image Source="{StaticResource CmdIcon_LineSupportRemove}" Width="24" Height="24"/>
            </Button>
        </StackPanel>

        <TextBlock Text="{DynamicResource FemMeshNodeBoundarySupport}" Margin="0,8,0,2"/>
        <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="xCheck" Content="X" Margin="0,0,10,0"/>
            <CheckBox x:Name="yCheck" Content="Y" Margin="0,0,10,0"/>
            <CheckBox x:Name="zCheck" Content="Z" Margin="0,0,10,0"/>
            <CheckBox x:Name="uxCheck" Content="UX" Margin="0,0,10,0"/>
            <CheckBox x:Name="uyCheck" Content="UY" Margin="0,0,10,0"/>
            <CheckBox x:Name="uzCheck" Content="UZ"/>
        </StackPanel>
        <CheckBox x:Name="edgeRotationCheck" Content="{DynamicResource FemLineSupportEdgeRotation}" Margin="0,6,0,0"
                  ToolTip="{DynamicResource FemLineSupportEdgeRotationTip}"/>

        <TextBlock Text="{DynamicResource FemLineSupportSprings}" Margin="0,10,0,2"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Kx′" Grid.Column="0" Margin="1"/>
            <TextBlock Text="Ky′" Grid.Column="1" Margin="1"/>
            <TextBlock Text="Kz′" Grid.Column="2" Margin="1"/>
            <TextBlock Text="Kux′" Grid.Column="3" Margin="1"/>
            <TextBlock Text="Kuy′" Grid.Column="4" Margin="1"/>
            <TextBlock Text="Kuz′" Grid.Column="5" Margin="1"/>
            <TextBox x:Name="kxBox" Grid.Row="1" Grid.Column="0" Margin="1"/>
            <TextBox x:Name="kyBox" Grid.Row="1" Grid.Column="1" Margin="1"/>
            <TextBox x:Name="kzBox" Grid.Row="1" Grid.Column="2" Margin="1"/>
            <TextBox x:Name="kuxBox" Grid.Row="1" Grid.Column="3" Margin="1"/>
            <TextBox x:Name="kuyBox" Grid.Row="1" Grid.Column="4" Margin="1"/>
            <TextBox x:Name="kuzBox" Grid.Row="1" Grid.Column="5" Margin="1"/>
        </Grid>
        <TextBlock Text="{DynamicResource FemLineSupportUnitsHint}" Foreground="Gray" FontSize="11" Margin="1,0,1,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="errorText" Foreground="Crimson" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource OK}" IsDefault="True" Click="Ok_Click" Padding="20,4" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Cancel}" IsCancel="True" Padding="16,4"/>
        </StackPanel>
    </StackPanel>
</Window>
