<Window x:Class="OpenCS.Views.FemBoundaryObjectsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FemBoundaryObjectsTitle}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="headerText" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="originText" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>
        <!-- Поля списков (узлы КонЭ, узлы сетки, грани) создаются в коде. -->
        <StackPanel x:Name="fieldsPanel"/>
        <TextBlock Text="{DynamicResource FemBoundaryObjectsHint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="1,6,1,0"/>
        <TextBlock x:Name="errorText" Foreground="Crimson" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource OK}" IsDefault="True" Click="Ok_Click" Padding="20,4" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Cancel}" IsCancel="True" Padding="16,4"/>
        </StackPanel>
    </StackPanel>
</Window>
