<UserControl x:Class="OpenCS.Views.FemCsfeaCaseSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Показ линейного результата CSfea: переключатель «Загружения | Комбинации | Огибающие», один список, ◀ ▶, окно
         выбора «⋯» (комбинации) и |max| / max / min (огибающие).
         DataContext — FemCsfeaResultVM. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ModeButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Иконка режима (как в дереве схемы) и число пунктов; полное название — заголовком подсказки -->
        <Style x:Key="ModeIcon" TargetType="Image">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="ModeCount" TargetType="TextBlock">
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ArrowButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="casesMode" Style="{StaticResource ModeButton}" IsChecked="{Binding ShowLoadCases, Mode=OneWay}" Click="Mode_Click"
                      Visibility="{Binding ShowCasesMode, Converter={StaticResource BoolToVis}}">
            <ToggleButton.ToolTip>
                <TextBlock>
                    <Run Text="{Binding CasesModeLabel, Mode=OneWay}" FontWeight="SemiBold"/><LineBreak/>
                    <Run Text="{DynamicResource FemCsfeaCasesModeTip}"/>
                </TextBlock>
            </ToggleButton.ToolTip>
            <StackPanel Orientation="Horizontal">
                <Image Style="{StaticResource ModeIcon}" Source="{DynamicResource FemIcon_LoadCases}"/>
                <TextBlock Style="{StaticResource ModeCount}" Text="{Binding LoadCaseItems.Count}"/>
            </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="combinationsMode" Style="{StaticResource ModeButton}" Margin="-1,0,0,0" IsEnabled="{Binding CanShowCombinations}"
                      IsChecked="{Binding ShowCombinations, Mode=OneWay}" Click="Mode_Click">
            <ToggleButton.ToolTip>
                <TextBlock MaxWidth="420" TextWrapping="Wrap">
                    <Run Text="{Binding CombinationsModeLabel, Mode=OneWay}" FontWeight="SemiBold"/><LineBreak/>
                    <Run Text="{Binding CombinationsModeTip, Mode=OneWay}"/>
                </TextBlock>
            </ToggleButton.ToolTip>
            <StackPanel Orientation="Horizontal">
                <Image Style="{StaticResource ModeIcon}" Source="{DynamicResource FemIcon_Combinations}"/>
                <TextBlock Style="{StaticResource ModeCount}" Text="{Binding CombinationItems.Count}"/>
            </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="envelopesMode" Style="{StaticResource ModeButton}" Margin="-1,0,6,0" IsEnabled="{Binding CanShowEnvelopes}"
                      IsChecked="{Binding ShowEnvelopes, Mode=OneWay}" Click="Mode_Click">
            <ToggleButton.ToolTip>
                <TextBlock MaxWidth="420" TextWrapping="Wrap">
                    <Run Text="{Binding EnvelopesModeLabel, Mode=OneWay}" FontWeight="SemiBold"/><LineBreak/>
                    <Run Text="{Binding EnvelopesModeTip, Mode=OneWay}"/>
                </TextBlock>
            </ToggleButton.ToolTip>
            <StackPanel Orientation="Horizontal">
                <Image Style="{StaticResource ModeIcon}" Source="{DynamicResource FemIcon_Envelope}"/>
                <TextBlock Style="{StaticResource ModeCount}" Text="{Binding EnvelopeItems.Count}"/>
            </StackPanel>
        </ToggleButton>
        <Button Style="{StaticResource ArrowButton}" Content="◀" Command="{Binding PrevCaseCommand}" ToolTip="{DynamicResource FemCsfeaPrevCase}"/>
        <ComboBox x:Name="list" Width="320" Margin="2,0" VerticalAlignment="Center" ItemsSource="{Binding CaseItems}"
                  SelectedItem="{Binding SelectedCaseItem, Mode=TwoWay}" ToolTip="{Binding SelectedCaseItem.ToolTip}"
                  IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MaxDropDownHeight="480">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" CornerRadius="3" Padding="4,0" MinWidth="24" Margin="0,0,6,0"
                                VerticalAlignment="Center" Background="#E8EEF7" BorderBrush="#B8C7DD" BorderThickness="1">
                            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="#2F4A73"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- Вариант пакета, не дошедший до предела λ -->
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Warning}" Foreground="DarkOrange" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Formula}" Foreground="Gray" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Style="{StaticResource ArrowButton}" Content="▶" Command="{Binding NextCaseCommand}" ToolTip="{DynamicResource FemCsfeaNextCase}"/>
        <Button Style="{StaticResource ArrowButton}" Content="⋯" Margin="2,0,0,0" Click="Pick_Click"
                ToolTip="{DynamicResource FemCsfeaPickCombination}"
                Visibility="{Binding ShowCombinations, Converter={StaticResource BoolToVis}}"/>
        <ComboBox Width="64" Margin="6,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding AggregateOptions}"
                  SelectedItem="{Binding SelectedAggregateOption, Mode=TwoWay}" DisplayMemberPath="Label"
                  ToolTip="{DynamicResource FemCsfeaAggregateTip}"
                  Visibility="{Binding ShowEnvelopes, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</UserControl>
