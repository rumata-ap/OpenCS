<UserControl x:Class="OpenCS.Views.LimitForceBatchResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <Grid Margin="12">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Шапка: вердикт -->
      <StackPanel Grid.Row="0" Margin="0,0,0,8">
         <Border Padding="8,6" CornerRadius="4" Background="{Binding StatusBrush}">
            <StackPanel HorizontalAlignment="Center">
               <TextBlock Text="{Binding SummaryText}" FontWeight="Bold"/>
               <TextBlock Text="{Binding SolverText}" Foreground="Gray" FontSize="11"
                          Margin="0,2,0,0"/>
            </StackPanel>
         </Border>
         <TextBlock Text="{Binding RebarAreaNote}" TextWrapping="Wrap"
                    Foreground="Gray" FontStyle="Italic" Margin="0,6,0,0"
                    Visibility="{Binding ShowRebarAreaNote, Converter={StaticResource BoolToVisibility}}"/>
      </StackPanel>

      <!-- Таблица строк -->
      <DataGrid Grid.Row="1" x:Name="RowsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow"
                MouseDoubleClick="RowsGrid_MouseDoubleClick">
         <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
               <Style.Triggers>
                  <!-- Кисп < 0,99 — обычная; 0,99…1 — на пределе (жёлтая); > 1 — не проходит (красная) -->
                  <DataTrigger Binding="{Binding Verdict}" Value="Pass">
                     <Setter Property="Background" Value="#1A2D7A3E"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Verdict}" Value="NearLimit">
                     <Setter Property="Background" Value="#66F1C40F"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Verdict}" Value="Fail">
                     <Setter Property="Background" Value="#55E74C3C"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Verdict}" Value="NotConverged">
                     <Setter Property="Background" Value="#1AC0392B"/>
                  </DataTrigger>
               </Style.Triggers>
            </Style>
         </DataGrid.RowStyle>
         <DataGrid.ContextMenu>
            <ContextMenu>
               <MenuItem Header="{DynamicResource CalcTaskNew}"
                         Click="CreateTask_Click"/>
               <Separator/>
               <MenuItem Header="{DynamicResource ExportCsvBtn}"
                         Click="ExportCsv_Click"/>
            </ContextMenu>
         </DataGrid.ContextMenu>
         <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColNum}"
                                Binding="{Binding Num}" Width="40"/>
            <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColLabel}"
                                Binding="{Binding Label}" Width="*"/>
            <DataGridTextColumn Binding="{Binding NText}" Width="75">
               <DataGridTextColumn.Header>
                  <TextBlock Text="N, кН" ToolTip="{DynamicResource LimitForceBatch_ColActingTip}"/>
               </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding MxText}" Width="82">
               <DataGridTextColumn.Header>
                  <TextBlock Text="Mx, кН·м" ToolTip="{DynamicResource LimitForceBatch_ColActingTip}"/>
               </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding MyText}" Width="82">
               <DataGridTextColumn.Header>
                  <TextBlock Text="My, кН·м" ToolTip="{DynamicResource LimitForceBatch_ColActingTip}"/>
               </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding NLimText}" Width="85">
               <DataGridTextColumn.Header>
                  <TextBlock Text="{DynamicResource LimitForceBatch_ColNLim}"
                             ToolTip="{DynamicResource LimitForceBatch_ColLimitTip}"/>
               </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding MxLimText}" Width="95">
               <DataGridTextColumn.Header>
                  <TextBlock Text="{DynamicResource LimitForceBatch_ColMxLim}"
                             ToolTip="{DynamicResource LimitForceBatch_ColLimitTip}"/>
               </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding MyLimText}" Width="95">
               <DataGridTextColumn.Header>
                  <TextBlock Text="{DynamicResource LimitForceBatch_ColMyLim}"
                             ToolTip="{DynamicResource LimitForceBatch_ColLimitTip}"/>
               </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Header="k" Binding="{Binding FactorText}" Width="70"/>
            <DataGridTextColumn Header="Использ." Binding="{Binding UtilText}" Width="70"/>
            <DataGridTextColumn Header="{DynamicResource LimitForce_Governing}"
                                Binding="{Binding GovText}" Width="90"/>
            <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColIter}"
                                Binding="{Binding IterText}" Width="52"/>
            <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColStatus}"
                                Binding="{Binding StatusText}" Width="65"/>
            <DataGridTextColumn Header="ηx (8.1.15)" Binding="{Binding EtaXText}" Width="80"/>
            <DataGridTextColumn Header="ηy (8.1.15)" Binding="{Binding EtaYText}" Width="80"/>
         </DataGrid.Columns>
      </DataGrid>

      <!-- Кнопки внизу -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
         <Button Content="{DynamicResource CalcTaskNew}"
                 Click="CreateTask_Click"
                 Padding="12,4" Margin="0,0,8,0"
                 x:Name="CreateTaskBtn" IsEnabled="False"/>
         <Button Content="{DynamicResource ExportCsvBtn}"
                 Click="ExportCsv_Click"
                 Padding="12,4"/>
      </StackPanel>
   </Grid>
</UserControl>
