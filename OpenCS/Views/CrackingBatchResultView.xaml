<UserControl x:Class="OpenCS.Views.CrackingBatchResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:OpenCS.Views">

   <Grid Margin="12">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="8,6" CornerRadius="4" Background="{Binding StatusBrush}" Margin="0,0,0,8">
         <TextBlock Text="{Binding SummaryText}" FontWeight="Bold" HorizontalAlignment="Center"/>
      </Border>

      <DockPanel Grid.Row="1">
         <v:BatchVerdictFilterBar DockPanel.Dock="Top" Target="{Binding ElementName=RowsGrid}"/>
         <DataGrid x:Name="RowsGrid" RowStyle="{StaticResource BatchVerdictRowStyle}" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                   IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                   CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow"
                   MouseDoubleClick="RowsGrid_MouseDoubleClick">
            <DataGrid.ContextMenu>
               <ContextMenu>
                  <MenuItem Header="{DynamicResource CalcTaskNew}" Click="CreateTask_Click"/>
               </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
               <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColNum}" Binding="{Binding Num}" Width="40"/>
               <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColLabel}" Binding="{Binding Label}" Width="*"/>
               <DataGridTextColumn Header="N, кН" Binding="{Binding NText}" Width="75"/>
               <DataGridTextColumn Header="{DynamicResource Cracking_ColMxCrc}" Binding="{Binding MxCrcText}" Width="90"/>
               <DataGridTextColumn Header="{DynamicResource Cracking_ColMyCrc}" Binding="{Binding MyCrcText}" Width="90"/>
               <DataGridTextColumn Header="{DynamicResource Cracking_ColMcrc}" Binding="{Binding McrcText}" Width="90"/>
               <DataGridTextColumn Header="{DynamicResource Cracking_ColNcrc}" Binding="{Binding NCrcText}" Width="90"/>
               <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColStatus}" Binding="{Binding StatusText}" Width="70"/>
            </DataGrid.Columns>
         </DataGrid>
      </DockPanel>

      <!-- Кнопки внизу -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
         <Button Content="{DynamicResource CalcTaskNew}" Click="CreateTask_Click"
                 Padding="12,4" x:Name="CreateTaskBtn" IsEnabled="False"/>
      </StackPanel>
   </Grid>
</UserControl>
