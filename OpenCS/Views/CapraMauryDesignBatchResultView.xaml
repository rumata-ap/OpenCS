<UserControl x:Class="OpenCS.Views.CapraMauryDesignBatchResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <DockPanel Margin="8">
      <StackPanel DockPanel.Dock="Top">
         <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding Title}" Margin="0,0,0,4"/>
         <Border CornerRadius="4" Padding="8,6" Margin="0,0,0,8" Background="{Binding StatusBrush}">
            <TextBlock FontWeight="Bold" Text="{Binding Summary}" HorizontalAlignment="Center"/>
         </Border>
         <TextBlock Text="{DynamicResource CapriDesignModelNote}" TextWrapping="Wrap" Margin="0,0,0,8"/>
         <GroupBox Header="{DynamicResource CapriDesignEnvelope}" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding Envelope}" AutoGenerateColumns="False" IsReadOnly="True"
                      RowHeaderWidth="0" HeadersVisibility="Column">
               <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource CapriDesignColComponent}" Binding="{Binding Component}"/>
                  <DataGridTextColumn Header="{DynamicResource CapriDesignColAs}" Binding="{Binding As}"/>
                  <DataGridTextColumn Header="{DynamicResource CapriDesignColRow}" Binding="{Binding Row}"/>
               </DataGrid.Columns>
            </DataGrid>
         </GroupBox>
         <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="CreateTaskBtn" Content="{DynamicResource CapriDesignCreateTask}" Padding="8,2"
                    IsEnabled="False" Click="CreateTask_Click"/>
         </StackPanel>
      </StackPanel>
      <DataGrid x:Name="RowsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                RowHeaderWidth="0" SelectionMode="Single" MouseDoubleClick="RowsGrid_MouseDoubleClick">
         <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
               <Style.Triggers>
                  <DataTrigger Binding="{Binding Feasible}" Value="False">
                     <Setter Property="Foreground" Value="Firebrick"/>
                  </DataTrigger>
               </Style.Triggers>
            </Style>
         </DataGrid.RowStyle>
         <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Num}"/>
            <DataGridTextColumn Header="{DynamicResource CapriDesignColLabel}" Binding="{Binding Label}"/>
            <DataGridTextColumn Header="{DynamicResource CapriDesignTopX}" Binding="{Binding TopX}"/>
            <DataGridTextColumn Header="{DynamicResource CapriDesignTopY}" Binding="{Binding TopY}"/>
            <DataGridTextColumn Header="{DynamicResource CapriDesignBotX}" Binding="{Binding BotX}"/>
            <DataGridTextColumn Header="{DynamicResource CapriDesignBotY}" Binding="{Binding BotY}"/>
            <DataGridTextColumn Header="{DynamicResource CapriDesignDiagnostics}" Binding="{Binding Diagnostics}"/>
         </DataGrid.Columns>
      </DataGrid>
   </DockPanel>
</UserControl>
