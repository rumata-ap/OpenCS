<Window x:Class="OpenCS.Views.FemAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:util="clr-namespace:OpenCS.Utilites"
        Title="{DynamicResource FemAnalysisCreate}" Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <util:AnyDoubleConverter x:Key="AnyDoubleConverter"/>

        <!-- Нагрузка стадии/расчёта (DataContext — StageRow): бейдж типа, имя, формула серым и «…» — окно выбора.
             Двойной щелчок по ячейке и F2 в столбце стадий — тоже окно выбора. -->
        <DataTemplate x:Key="LoadSourceCell">
            <Grid Background="Transparent" ToolTip="{Binding Source.ToolTipText}" MouseLeftButtonDown="SourceCell_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Badge" Grid.Column="0" CornerRadius="3" Padding="4,0" MinWidth="22" Margin="2,0,5,0" VerticalAlignment="Center"
                        Background="#E8EEF7" BorderBrush="#B8C7DD" BorderThickness="1">
                    <TextBlock Text="{Binding Source.TypeBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#2F4A73" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="SourceName" Grid.Column="1" Text="{Binding Source.Tag}" MaxWidth="240" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SourceFormula" Grid.Column="2" Text="{Binding Source.Formula}" Foreground="#777777" Margin="8,0,4,0"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="Placeholder" Grid.Column="0" Grid.ColumnSpan="3" Text="{DynamicResource FemLoadSourceChoose}"
                           Foreground="#C0392B" FontStyle="Italic" Margin="2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Button Grid.Column="3" Content="…" Width="24" Padding="0" Click="ChooseSource_Click" Tag="{Binding}"
                        ToolTip="{DynamicResource FemLoadSourceChooseTip}" Focusable="False"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="{x:Null}">
                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="SourceName" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="SourceFormula" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Source.TypeBadge}" Value="">
                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Source.IsUnresolved}" Value="True">
                    <Setter TargetName="SourceName" Property="Foreground" Value="#A05A00"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="780">
    <StackPanel Margin="12">
        <Grid x:Name="TagRow" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisTagLabel}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="TagBox" Text="" Height="22" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid x:Name="KindRow" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisKindLabel}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="KindBox" DisplayMemberPath="Label" Height="22" VerticalContentAlignment="Center"
                      SelectionChanged="KindBox_SelectionChanged" ToolTip="{DynamicResource FemAnalysisKindTip}"/>
        </Grid>

        <Grid x:Name="LoadSourceRow" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisLoadLabel}" VerticalAlignment="Center"/>
            <Border Grid.Column="1" x:Name="LoadSourceBox" Height="24" BorderBrush="#ABADB3" BorderThickness="1" Padding="1">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LoadSourceCell}"/>
            </Border>
        </Grid>

        <!-- Линейный CSfea: загружения галочками, каждое отмеченное — отдельный расчёт (FemLinearCasesVM) -->
        <GroupBox x:Name="LinearCasesGroup" Header="{DynamicResource FemCsfeaLinearCasesLabel}" Visibility="Collapsed" Margin="0,4">
            <StackPanel Margin="4">
                <TextBlock Text="{DynamicResource FemCsfeaLinearCasesHint}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11" Opacity="0.8"/>
                <DockPanel Margin="0,0,0,4">
                    <Button Content="{DynamicResource FemCsfeaLinearCasesAll}" Click="LinearCasesAll_Click" Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource FemCsfeaLinearCasesNone}" Click="LinearCasesNone_Click" Padding="8,2" Margin="0,0,4,0"/>
                    <TextBox DockPanel.Dock="Right" Width="180" Height="22" VerticalContentAlignment="Center"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{DynamicResource FemCsfeaLinearCasesSearch}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border/>
                </DockPanel>
                <DataGrid x:Name="LinearCasesGrid" ItemsSource="{Binding VisibleRows}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                          SelectionMode="Extended" SelectionUnit="FullRow" MaxHeight="260" MinHeight="80">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="28">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource FemCsfeaLinearCasesTypeColumn}" Width="44" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Width="16" Height="16" Source="{DynamicResource FemIcon_LoadShort}" x:Name="Icon"/>
                                        <TextBlock Text="{Binding TypeLetter}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Sp20Type}" Value="permanent">
                                            <Setter TargetName="Icon" Property="Source" Value="{DynamicResource FemIcon_LoadPermanent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Sp20Type}" Value="long_term">
                                            <Setter TargetName="Icon" Property="Source" Value="{DynamicResource FemIcon_LoadLong}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Sp20Type}" Value="accidental">
                                            <Setter TargetName="Icon" Property="Source" Value="{DynamicResource FemIcon_LoadAccidental}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Sp20Type}" Value="">
                                            <Setter TargetName="Icon" Property="Source" Value="{x:Null}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaLinearCasesNameColumn}" Binding="{Binding Label}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="γf" Binding="{Binding GammaText}" Width="56" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaLinearCasesShareColumn}" Binding="{Binding ShareText}" Width="64" IsReadOnly="True"/>
                        <DataGridTextColumn Binding="{Binding Note}" Width="Auto" MinWidth="40" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A05A00"/>
                                    <Setter Property="Margin" Value="3,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLegacy}" Value="True">
                                    <Setter Property="Foreground" Value="Gray"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
                <TextBlock Text="{Binding CountText}" Margin="0,4,0,0" FontSize="11" Opacity="0.8"/>
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="StagesGroup" Header="{DynamicResource FemAnalysisStagesLabel}" Visibility="Collapsed" Margin="0,4">
            <StackPanel Margin="4">
                <!-- Секущий CSfea: нагружение по стадиям или пакет вариантов (каждый — отдельный расчёт с нуля) -->
                <StackPanel x:Name="LoadingModePanel" Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="StagedRadio" GroupName="LoadingMode" Content="{DynamicResource FemCsfeaLoadingStaged}" IsChecked="True"
                                 Checked="LoadingMode_Changed" Margin="0,0,16,0"/>
                    <RadioButton x:Name="BatchRadio" GroupName="LoadingMode" Content="{DynamicResource FemCsfeaLoadingBatch}"
                                 Checked="LoadingMode_Changed" ToolTip="{DynamicResource FemCsfeaLoadingBatchTip}"/>
                </StackPanel>
                <TextBlock x:Name="StagesHintText" Text="{DynamicResource FemAnalysisStagesHint}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11" Opacity="0.8"/>
                <StackPanel x:Name="StagedPanel">
                <DataGrid x:Name="StagesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          Height="140" Margin="0,0,0,6" PreviewKeyDown="StagesGrid_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="StagesTagColumn" Header="{DynamicResource FemAnalysisStageTagColumn}" Binding="{Binding Tag}" Width="120"/>
                        <DataGridTemplateColumn x:Name="StagesSourceColumn" Header="{DynamicResource FemAnalysisLoadLabel}" Width="*"
                                                IsReadOnly="True" MinWidth="200" CellTemplate="{StaticResource LoadSourceCell}"/>
                        <DataGridTextColumn x:Name="StagesLoadFactorStepColumn" Header="{DynamicResource FemAnalysisStageLoadFactorStepColumn}" Width="70">
                            <DataGridTextColumn.Binding>
                                <Binding Path="LoadFactorStep" Mode="TwoWay"
                                         Converter="{StaticResource AnyDoubleConverter}"
                                         UpdateSourceTrigger="LostFocus"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PathControlMode.Value}" Value="DisplacementControl">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PathControlMode.Value}" Value="ArcLength">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="StagesMaxLoadFactorColumn" Header="{DynamicResource FemAnalysisStageMaxLoadFactorColumn}" Width="70">
                            <DataGridTextColumn.Binding>
                                <Binding Path="MaxLoadFactor" Mode="TwoWay"
                                         Converter="{StaticResource AnyDoubleConverter}"
                                         UpdateSourceTrigger="LostFocus"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PathControlMode.Value}" Value="DisplacementControl">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PathControlMode.Value}" Value="ArcLength">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridComboBoxColumn x:Name="StagesPathControlColumn" Header="{DynamicResource FemAnalysisStagePathControlColumn}"
                                                 DisplayMemberPath="Label" SelectedItemBinding="{Binding PathControlMode}" Width="120"/>
                        <DataGridTemplateColumn x:Name="StagesPathControlButtonColumn" Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{DynamicResource FemAnalysisStagePathControlConfigure}" Padding="4,2"
                                            Click="ConfigurePathControl_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource FemAnalysisStageAdd}" Click="AddStage_Click" Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource FemAnalysisStageRemove}" Click="RemoveStage_Click" Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource FemAnalysisStageMoveUp}" Click="MoveStageUp_Click" Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource FemAnalysisStageMoveDown}" Click="MoveStageDown_Click" Padding="8,2"/>
                </StackPanel>
                </StackPanel>

                <StackPanel x:Name="BatchPanel" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource FemCsfeaBatchChoose}" Click="ChooseBatch_Click" Padding="8,2"/>
                        <TextBlock x:Name="BatchSummaryText" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DataGrid x:Name="BatchGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                              RowHeight="22" Height="160" Margin="0,0,0,6" MouseDoubleClick="BatchGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource FemLoadSourcePickerTypeColumn}" Width="48">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Badge" CornerRadius="3" Padding="4,0" MinWidth="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="#E8EEF7" BorderBrush="#B8C7DD" BorderThickness="1">
                                            <TextBlock Text="{Binding TypeBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#2F4A73" HorizontalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding TypeBadge}" Value="">
                                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource FemLoadSourcePickerNameColumn}" Binding="{Binding Tag}" Width="2*"/>
                            <DataGridTextColumn Header="{DynamicResource FemLoadSourcePickerFormulaColumn}" Binding="{Binding Formula}" Width="3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUnresolved}" Value="True">
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <StackPanel x:Name="BucklingModesRow" Margin="0,0,0,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource FemBucklingModesLabel}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{DynamicResource FemBucklingModesTip}"/>
                            <TextBox x:Name="BucklingModesBox" Width="60" Height="22" VerticalContentAlignment="Center" Text="20" ToolTip="{DynamicResource FemBucklingModesTip}"/>
                            <TextBlock Text="{DynamicResource FemBucklingMethodLabel}" VerticalAlignment="Center" Margin="16,0,6,0" ToolTip="{DynamicResource FemBucklingMethodTip}"/>
                            <ComboBox x:Name="BucklingMethodCombo" Width="170" Height="22" SelectionChanged="BucklingMethod_Changed" ToolTip="{DynamicResource FemBucklingMethodTip}">
                                <ComboBoxItem Tag="mode" Content="{DynamicResource FemBucklingMethodMode}"/>
                                <ComboBoxItem Tag="asce" Content="{DynamicResource FemBucklingMethodAsce}"/>
                                <ComboBoxItem Tag="sp16" Content="{DynamicResource FemBucklingMethodSp16}"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" ToolTip="{DynamicResource FemBucklingForcesTip}">
                            <TextBlock Text="{DynamicResource FemBucklingForcesLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="BucklingForcesCombo" Width="330" Height="22">
                                <ComboBoxItem Tag="envelope" Content="{DynamicResource FemBucklingForcesEnvelope}"/>
                                <ComboBoxItem Tag="governing" Content="{DynamicResource FemBucklingForcesGoverning}"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="BucklingNomogramPanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource FemBucklingSwayLabel}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{DynamicResource FemBucklingSwayTip}"/>
                                <ComboBox x:Name="BucklingSwayCombo" Width="170" Height="22" SelectionChanged="BucklingMethod_Changed" ToolTip="{DynamicResource FemBucklingSwayTip}">
                                    <ComboBoxItem Tag="mode" Content="{DynamicResource FemBucklingSwayMode}"/>
                                    <ComboBoxItem Tag="stiffness" Content="{DynamicResource FemBucklingSwayStiffness}"/>
                                    <ComboBoxItem Tag="manual" Content="{DynamicResource FemBucklingSwayManual}"/>
                                </ComboBox>
                                <StackPanel x:Name="BucklingSwayStiffnessRow" Orientation="Horizontal" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource FemBucklingSwayThresholdLabel}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                    <TextBox x:Name="BucklingSwayStiffnessBox" Width="50" Height="22" VerticalContentAlignment="Center" Text="5"/>
                                </StackPanel>
                                <StackPanel x:Name="BucklingSwayManualRow" Orientation="Horizontal" Visibility="Collapsed">
                                    <CheckBox x:Name="BucklingSwayXCb" Content="{DynamicResource FemBucklingSwayXLabel}" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <CheckBox x:Name="BucklingSwayYCb" Content="{DynamicResource FemBucklingSwayYLabel}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" ToolTip="{DynamicResource FemBucklingGTip}">
                                <TextBlock Text="{DynamicResource FemBucklingGFixedLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="BucklingGFixedBox" Width="50" Height="22" VerticalContentAlignment="Center" Text="1"/>
                                <TextBlock Text="{DynamicResource FemBucklingGPinnedLabel}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <TextBox x:Name="BucklingGPinnedBox" Width="50" Height="22" VerticalContentAlignment="Center" Text="10"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="BatchOptionsPanel">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource FemAnalysisStageLoadFactorStepColumn}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="BatchStepBox" Width="60" Height="22" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{DynamicResource FemAnalysisStageMaxLoadFactorColumn}" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <TextBox x:Name="BatchMaxBox" Width="60" Height="22" VerticalContentAlignment="Center"/>
                            <CheckBox x:Name="BatchStopAtLimitCb" Content="{DynamicResource FemCsfeaBatchStopAtLimit}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource FemCsfeaBatchRecordingLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton x:Name="BatchRecordFieldsRadio" GroupName="BatchRecording" Content="{DynamicResource FemCsfeaBatchRecordingFields}"
                                         IsChecked="True" Checked="BatchRecording_Changed" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <RadioButton x:Name="BatchRecordEnvelopesRadio" GroupName="BatchRecording" Content="{DynamicResource FemCsfeaBatchRecordingEnvelopes}"
                                         Checked="BatchRecording_Changed" VerticalAlignment="Center" ToolTip="{DynamicResource FemCsfeaBatchRecordingEnvelopesTip}"/>
                        </StackPanel>
                        <CheckBox x:Name="BatchLongNCb" Content="{DynamicResource FemCsfeaBatchLongN}" IsChecked="True" Margin="0,2,0,2"
                                  Checked="BatchLongTerm_Changed" Unchecked="BatchLongTerm_Changed" ToolTip="{DynamicResource FemCsfeaBatchLongNTip}"/>
                        <CheckBox x:Name="BatchLongDeflectionCb" Content="{DynamicResource FemCsfeaBatchLongDeflection}" IsChecked="True" Margin="20,0,0,2"
                                  Checked="BatchLongTerm_Changed" Unchecked="BatchLongTerm_Changed" ToolTip="{DynamicResource FemCsfeaBatchLongDeflectionTip}"/>
                        <CheckBox x:Name="BatchLongCCb" Content="{DynamicResource FemCsfeaBatchLongC}" Margin="0,0,0,4"
                                  Checked="BatchLongTerm_Changed" Unchecked="BatchLongTerm_Changed" ToolTip="{DynamicResource FemCsfeaBatchLongCTip}"/>
                        <TextBlock x:Name="BatchEstimateText" TextWrapping="Wrap" FontSize="11" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel x:Name="NonlinearPanel" Visibility="Collapsed" Margin="0,4,0,0">
            <Separator x:Name="NonlinearSeparator" Margin="0,4"/>
            <!-- Только в режиме субмодели: единственная стадия до λ = 1 строится сервисом, задаётся лишь шаг -->
            <Grid x:Name="LoadFactorStepRow" Margin="0,2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource SubmodelLoadFactorStepLabel}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="LoadFactorStepBox" Text="0.1" Height="22" VerticalContentAlignment="Center"/>
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisCalcTypeLabel}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="CalcTypeBox" Height="22" VerticalContentAlignment="Center"/>
            </Grid>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisElementFormulationLabel}" VerticalAlignment="Center"
                           ToolTip="{DynamicResource FemAnalysisElementFormulationTip}"/>
                <ComboBox Grid.Column="1" x:Name="ElementFormulationBox" DisplayMemberPath="Label" Height="22" VerticalContentAlignment="Center"
                          ToolTip="{DynamicResource FemAnalysisElementFormulationTip}"/>
            </Grid>

            <GroupBox Header="{DynamicResource OpenSeesMaterialsGroup}" Margin="0,8,0,0">
                <StackPanel Margin="4">
                    <CheckBox x:Name="ConsiderPhysicalNonlinearityCb"
                              Content="{DynamicResource FemAnalysisConsiderPhysicalNonlinearity}"
                              ToolTip="{DynamicResource FemAnalysisConsiderPhysicalNonlinearityTip}"
                              IsChecked="True" Margin="0,0,0,6"/>
                    <StackPanel x:Name="MaterialNonlinearityPanel">
                        <CheckBox x:Name="ConsiderConcreteTensionCb"
                                  Content="{DynamicResource FemAnalysisConsiderConcreteTension}"
                                  ToolTip="{DynamicResource FemAnalysisConsiderConcreteTensionTip}"
                                  IsChecked="True" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisMaterialSourceLabel}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="MaterialSourceBox" DisplayMemberPath="Label" Height="22" VerticalContentAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="NativeMaterialPanel" Visibility="Collapsed">
                            <GroupBox Header="{DynamicResource FemAnalysisMainMaterialGroup}" Margin="0,0,0,6">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisMainMaterialModelLabel}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="MainMaterialModelBox" DisplayMemberPath="Label" Height="22" VerticalContentAlignment="Center"/>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="{DynamicResource FemAnalysisReinforcementGroup}">
                                <StackPanel Margin="4">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisSteelModelLabel}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="SteelModelBox" DisplayMemberPath="Label" Height="22" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource FemAnalysisSteelHardeningModulusLabel}"
                                       ToolTip="{DynamicResource FemAnalysisSteelHardeningModulusTip}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="SteelHardeningModulusBox" Text="0"
                                     Height="22" VerticalContentAlignment="Center"
                                     ToolTip="{DynamicResource FemAnalysisSteelHardeningModulusTip}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="{DynamicResource FemAnalysisSolverSettingsHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                       FontStyle="Italic" Opacity="0.7" FontSize="11"/>
        </StackPanel>

        <!-- Секущий расчёт CSfea: физика сечений, итерации Пикара, запись полей, контрольный узел -->
        <StackPanel x:Name="CsfeaPanel" Visibility="Collapsed" Margin="0,4,0,0">
            <Separator Margin="0,4"/>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition x:Name="CsfeaTensionRow" Height="28"/>
                    <RowDefinition x:Name="CsfeaCrackRuleRow" Height="28"/>
                    <RowDefinition x:Name="CsfeaPoissonRow" Height="28"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource FemAnalysisCalcTypeLabel}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CsfeaCalcTypeBox" Height="22" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="{DynamicResource FemCsfeaPlateRebarSourceLabel}" VerticalAlignment="Center"
                           ToolTip="{DynamicResource FemCsfeaPlateRebarSourceTip}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CsfeaPlateRebarSourceBox" DisplayMemberPath="Label" Height="22"
                          VerticalContentAlignment="Center" ToolTip="{DynamicResource FemCsfeaPlateRebarSourceTip}"/>
                <TextBlock Grid.Row="2" Text="{DynamicResource FemCsfeaTensionConcreteLabel}" VerticalAlignment="Center"
                           ToolTip="{DynamicResource FemCsfeaTensionConcreteTip}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CsfeaTensionConcreteBox" DisplayMemberPath="Label" Height="22"
                          VerticalContentAlignment="Center" ToolTip="{DynamicResource FemCsfeaTensionConcreteTip}"/>
                <TextBlock Grid.Row="3" Text="{DynamicResource FemCsfeaPlateCrackRuleLabel}" VerticalAlignment="Center"
                           ToolTip="{DynamicResource FemCsfeaPlateCrackRuleTip}"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CsfeaPlateCrackRuleBox" DisplayMemberPath="Label" Height="22"
                          VerticalContentAlignment="Center" ToolTip="{DynamicResource FemCsfeaPlateCrackRuleTip}"/>
                <TextBlock Grid.Row="4" Text="{DynamicResource FemCsfeaPoissonUncrackedLabel}" VerticalAlignment="Center"
                           ToolTip="{DynamicResource FemCsfeaPoissonUncrackedTip}"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="CsfeaPoissonBox" Height="22" VerticalContentAlignment="Center"
                         ToolTip="{DynamicResource FemCsfeaPoissonUncrackedTip}"/>
            </Grid>
            <!-- Линейный CSfea: жёсткости КЭ — начальные или из конечного состояния секущего расчёта (ИН) -->
            <GroupBox x:Name="CsfeaStiffnessGroup" Header="{DynamicResource FemCsfeaStiffnessGroup}" Margin="0,6,0,0"
                      Visibility="Collapsed" ToolTip="{DynamicResource FemCsfeaStiffnessTip}">
                <StackPanel Margin="4">
                    <RadioButton x:Name="CsfeaStiffnessInitialRadio" GroupName="CsfeaStiffness" IsChecked="True"
                                 Content="{DynamicResource FemCsfeaStiffnessInitial}" Margin="0,2"
                                 Checked="CsfeaStiffness_Changed"/>
                    <RadioButton x:Name="CsfeaStiffnessSecantRadio" GroupName="CsfeaStiffness"
                                 Content="{DynamicResource FemCsfeaStiffnessSecant}" Margin="0,2"
                                 Checked="CsfeaStiffness_Changed"/>
                    <Grid Margin="20,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CsfeaStiffnessAnalysisBox" Height="22" VerticalContentAlignment="Center"
                                  DisplayMemberPath="Label" SelectionChanged="CsfeaStiffnessAnalysis_Changed"
                                  ToolTip="{DynamicResource FemCsfeaStiffnessAnalysisTip}"/>
                        <ComboBox Grid.Column="2" x:Name="CsfeaStiffnessStateBox" Height="22" VerticalContentAlignment="Center"
                                  DisplayMemberPath="Label" SelectionChanged="CsfeaStiffnessState_Changed"
                                  ToolTip="{DynamicResource FemCsfeaStiffnessStateTip}"/>
                    </Grid>
                    <CheckBox x:Name="CsfeaSourcePDeltaCb" Content="{DynamicResource FemCsfeaSourcePDelta}" Margin="20,4,0,0"
                              ToolTip="{DynamicResource FemCsfeaSourcePDeltaTip}" ToolTipService.ShowOnDisabled="True"/>
                    <TextBlock x:Name="CsfeaStiffnessInfoText" Margin="20,4,0,0" TextWrapping="Wrap" FontSize="11"/>
                    <TextBlock x:Name="CsfeaStiffnessWarningText" Margin="20,2,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="DarkOrange" Visibility="Collapsed"/>
                </StackPanel>
            </GroupBox>
            <CheckBox x:Name="CsfeaImportedFactorsCb" Content="{DynamicResource FemCsfeaImportedFactorsLabel}"
                      ToolTip="{DynamicResource FemCsfeaImportedFactorsTip}" Margin="0,6,0,0"/>
            <WrapPanel x:Name="CsfeaFlagsPanel" Margin="0,6,0,2">
                <CheckBox x:Name="CsfeaPhysicalNonlinearityCb" Content="{DynamicResource FemCsfeaPhysicalNonlinearityLabel}"
                          ToolTip="{DynamicResource FemCsfeaPhysicalNonlinearityTip}" Margin="0,0,16,4"
                          Checked="CsfeaPhysicalNonlinearity_Changed" Unchecked="CsfeaPhysicalNonlinearity_Changed"/>
                <CheckBox x:Name="CsfeaPsiCb" Content="{DynamicResource FemCsfeaPsiLabel}"
                          ToolTip="{DynamicResource FemCsfeaPsiTip}" Margin="0,0,16,4"/>
                <CheckBox x:Name="CsfeaBeamShearCb" Content="{DynamicResource FemCsfeaBeamShearLabel}"
                          ToolTip="{DynamicResource FemCsfeaBeamShearTip}" Margin="0,0,16,4"/>
                <CheckBox x:Name="CsfeaGeomNonlinearCb" Content="{DynamicResource FemCsfeaGeomNonlinearLabel}"
                          ToolTip="{DynamicResource FemCsfeaGeomNonlinearTip}" Margin="0,0,16,4"/>
                <CheckBox x:Name="CsfeaShellInPlanePDeltaCb" Content="{DynamicResource FemCsfeaShellInPlanePDeltaLabel}"
                          ToolTip="{DynamicResource FemCsfeaShellInPlanePDeltaTip}" Margin="0,0,16,4"
                          IsEnabled="{Binding IsChecked, ElementName=CsfeaGeomNonlinearCb}"/>
                <CheckBox x:Name="CsfeaLargeDisplacementsCb" Content="{DynamicResource FemCsfeaLargeDisplacementsLabel}"
                          ToolTip="{DynamicResource FemCsfeaLargeDisplacementsTip}" Margin="0,0,0,4"
                          IsEnabled="{Binding IsChecked, ElementName=CsfeaGeomNonlinearCb}"/>
            </WrapPanel>

            <GroupBox x:Name="CsfeaIterationsGroup" Header="{DynamicResource FemCsfeaIterationsGroup}" Margin="0,6,0,0">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource FemCsfeaMaxIterationsLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="CsfeaMaxIterationsBox" Height="22" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource FemCsfeaMaxBisectionsLabel}" VerticalAlignment="Center"
                               ToolTip="{DynamicResource FemCsfeaMaxBisectionsTip}"/>
                    <TextBox Grid.Row="0" Grid.Column="4" x:Name="CsfeaMaxBisectionsBox" Height="22" VerticalContentAlignment="Center"
                             ToolTip="{DynamicResource FemCsfeaMaxBisectionsTip}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource FemCsfeaTolDisplacementLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="CsfeaTolDisplacementBox" Height="22" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{DynamicResource FemCsfeaTolStiffnessLabel}" VerticalAlignment="Center"
                               ToolTip="{DynamicResource FemCsfeaTolStiffnessTip}"/>
                    <TextBox Grid.Row="1" Grid.Column="4" x:Name="CsfeaTolStiffnessBox" Height="22" VerticalContentAlignment="Center"
                             ToolTip="{DynamicResource FemCsfeaTolStiffnessTip}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource FemCsfeaOmega0Label}" VerticalAlignment="Center"
                               ToolTip="{DynamicResource FemCsfeaOmega0Tip}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="CsfeaOmega0Box" Height="22" VerticalContentAlignment="Center"
                             ToolTip="{DynamicResource FemCsfeaOmega0Tip}"/>
                </Grid>
            </GroupBox>

            <GroupBox x:Name="CsfeaRecordingGroup" Header="{DynamicResource FemCsfeaRecordingGroup}" Margin="0,6,0,0">
                <StackPanel Margin="4">
                    <RadioButton x:Name="CsfeaRecordFinalRadio" GroupName="CsfeaRecording" Content="{DynamicResource FemCsfeaRecordFinal}"
                                 Checked="CsfeaRecording_Changed" Margin="0,0,0,4"/>
                    <StackPanel x:Name="CsfeaRecordSelectedRow" Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="CsfeaRecordSelectedRadio" GroupName="CsfeaRecording" Content="{DynamicResource FemCsfeaRecordSelected}"
                                     Checked="CsfeaRecording_Changed" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="CsfeaRecordStepsBox" Width="150" Height="22" VerticalContentAlignment="Center"
                                 ToolTip="{DynamicResource FemCsfeaRecordStepsTip}" Margin="0,0,12,0"/>
                        <CheckBox x:Name="CsfeaRecordStageEndsCb" Content="{DynamicResource FemCsfeaRecordStageEnds}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <RadioButton x:Name="CsfeaRecordAllRadio" GroupName="CsfeaRecording" Content="{DynamicResource FemCsfeaRecordAll}"
                                 ToolTip="{DynamicResource FemCsfeaRecordAllTip}" Checked="CsfeaRecording_Changed"/>
                    <CheckBox x:Name="CsfeaRecordStrainsCb" Content="{DynamicResource FemCsfeaRecordStrains}" Margin="0,6,0,0"
                              ToolTip="{DynamicResource FemCsfeaRecordStrainsTip}" Click="CsfeaRecordStrains_Click"/>
                </StackPanel>
            </GroupBox>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource FemCsfeaControlNodeLabel}" VerticalAlignment="Center"
                           ToolTip="{DynamicResource FemCsfeaControlNodeTip}"/>
                <TextBox Grid.Column="1" x:Name="CsfeaControlNodeBox" Height="22" VerticalContentAlignment="Center"
                         ToolTip="{DynamicResource FemCsfeaControlNodeTip}"/>
                <TextBlock Grid.Column="2" Text="{DynamicResource FemCsfeaControlDofLabel}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox Grid.Column="3" x:Name="CsfeaControlDofBox" Height="22" VerticalContentAlignment="Center"/>
            </Grid>

            <TextBlock Text="{DynamicResource FemCsfeaSettingsHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                       FontStyle="Italic" Opacity="0.7" FontSize="11"/>
        </StackPanel>

        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="CsfeaCheckInputButton" DockPanel.Dock="Left" Content="{DynamicResource FemCsfeaCheckInput}"
                    ToolTip="{DynamicResource FemCsfeaCheckInputTip}" Click="CsfeaCheckInput_Click"
                    Padding="12,4" Visibility="Collapsed"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource Cancel}" Click="Cancel_Click" Padding="16,4" MinWidth="80" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource OK}" Click="Ok_Click" Padding="16,4" MinWidth="80"/>
        </DockPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
