<Window x:Class="OpenCS.Views.FemAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FemAnalysisCreate}" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
    <StackPanel Margin="12">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisTagLabel}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="TagBox" Text="" Height="22" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisKindLabel}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="KindLinearRadio" Content="{DynamicResource FemAnalysisKindLinear}"
                             GroupName="Kind" IsChecked="True" Checked="KindRadio_Changed" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="KindNonlinearRadio" Content="{DynamicResource FemAnalysisKindNonlinear}"
                             GroupName="Kind" Checked="KindRadio_Changed" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisLoadLabel}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="LoadSourceBox" DisplayMemberPath="Label" Height="22" VerticalContentAlignment="Center"/>
        </Grid>

        <StackPanel x:Name="NonlinearPanel" Visibility="Collapsed" Margin="0,4,0,0">
            <Separator Margin="0,4"/>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisCalcTypeLabel}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="CalcTypeBox" Height="22" VerticalContentAlignment="Center"/>
            </Grid>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisLoadFactorStepLabel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBox Grid.Column="1" x:Name="LoadFactorStepBox" Text="0.1" Height="22" VerticalContentAlignment="Center"/>
            </Grid>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisMaxLoadFactorLabel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBox Grid.Column="1" x:Name="MaxLoadFactorBox" Text="10" Height="22" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisElementFormulationLabel}" VerticalAlignment="Center"
                           ToolTip="{DynamicResource FemAnalysisElementFormulationTip}"/>
                <ComboBox Grid.Column="1" x:Name="ElementFormulationBox" DisplayMemberPath="Label" Height="22" VerticalContentAlignment="Center"
                          ToolTip="{DynamicResource FemAnalysisElementFormulationTip}"/>
            </Grid>

            <GroupBox Header="{DynamicResource OpenSeesMaterialsGroup}" Margin="0,8,0,0">
                <StackPanel Margin="4">
                    <CheckBox x:Name="ConsiderConcreteTensionCb"
                              Content="{DynamicResource FemAnalysisConsiderConcreteTension}"
                              ToolTip="{DynamicResource FemAnalysisConsiderConcreteTensionTip}"
                              IsChecked="True" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisMaterialSourceLabel}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="MaterialSourceBox" DisplayMemberPath="Label" Height="22" VerticalContentAlignment="Center"/>
                    </Grid>
                    <StackPanel x:Name="NativeMaterialPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisConcreteModelLabel}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="ConcreteModelBox" DisplayMemberPath="Label" Height="22" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisSteelModelLabel}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="SteelModelBox" DisplayMemberPath="Label" Height="22" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource FemAnalysisSteelHardeningRatioLabel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBox Grid.Column="1" x:Name="SteelHardeningRatioBox" Text="" Height="22" VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="{DynamicResource FemAnalysisSolverSettingsHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                       FontStyle="Italic" Opacity="0.7" FontSize="11"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource OK}" Click="Ok_Click" Padding="16,4" MinWidth="80"/>
            <Button Content="{DynamicResource Cancel}" Click="Cancel_Click" Padding="16,4" MinWidth="80" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
