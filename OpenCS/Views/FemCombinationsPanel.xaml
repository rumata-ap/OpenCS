<UserControl x:Class="OpenCS.Views.FemCombinationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenCS.ViewModels">
    <!-- Вкладка «Комбинации» по мотивам RFEM: слева — комбинации с формулами, справа — свойства выбранной и перенос
         загружений стрелками. DataContext снаружи — FemSchemaEditorVM; внутри — FemCombinationsTabVM (создаётся в коде). -->
    <UserControl.Resources>
        <Style x:Key="CombGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style x:Key="LeftText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,3"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Sp20Icon" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Source" Value="{StaticResource FemIcon_LoadShort}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Sp20Type}" Value="permanent">
                    <Setter Property="Source" Value="{StaticResource FemIcon_LoadPermanent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Sp20Type}" Value="long_term">
                    <Setter Property="Source" Value="{StaticResource FemIcon_LoadLong}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Sp20Type}" Value="accidental">
                    <Setter Property="Source" Value="{StaticResource FemIcon_LoadAccidental}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Sp20Type}" Value="">
                    <Setter Property="Source" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Sp20IconCell">
            <Image Style="{StaticResource Sp20Icon}"/>
        </DataTemplate>
        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource IconButton25}">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="ArrowPath" TargetType="Path">
            <Setter Property="Stroke" Value="#B03030"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="root" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="280"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*" MinWidth="460"/>
        </Grid.ColumnDefinitions>

        <!-- Панель: отмена | сохранение -->
        <ToolBar Grid.Row="0" Grid.ColumnSpan="3" ToolBarTray.IsLocked="True">
            <Button Style="{StaticResource IconButton25}" Command="{Binding Editor.UndoCommand}" ToolTip="{DynamicResource FemUndo}">
                <Path Data="M13.5,7A6.5,6.5 0 0,1 20,13.5A6.5,6.5 0 0,1 13.5,20H10V18H13.5C16,18 18,16 18,13.5C18,11 16,9 13.5,9H7.83L10.91,12.09L9.5,13.5L4,8L9.5,2.5L10.92,3.91L7.83,7H13.5Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </Button>
            <Button Style="{StaticResource IconButton25}" Command="{Binding Editor.RedoCommand}" ToolTip="{DynamicResource FemRedo}">
                <Path Data="M10.5,7A6.5,6.5 0 0,0 4,13.5A6.5,6.5 0 0,0 10.5,20H14V18H10.5C8,18 6,16 6,13.5C6,11 8,9 10.5,9H16.17L13.09,12.09L14.5,13.5L20,8L14.5,2.5L13.08,3.91L16.17,7H10.5Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </Button>
            <Separator/>
            <Button Style="{StaticResource IconButton25}" Command="{Binding Editor.SaveCommand}" ToolTip="{DynamicResource FemSaveSchema}">
                <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" Fill="Black" Stretch="Uniform" Margin="2"/>
            </Button>
        </ToolBar>

        <!-- Комбинации -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{DynamicResource FemCombinationsListHeader}"/>
            <ToolBar DockPanel.Dock="Bottom" ToolBarTray.IsLocked="True" Margin="0,4,0,0">
                <Button Style="{StaticResource IconButton25}" Click="NewCombination_Click" ToolTip="{DynamicResource FemCombinationsNewTip}">
                    <Image Source="{StaticResource CmdIcon_Add}" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource IconButton25}" Click="CopyCombination_Click" ToolTip="{DynamicResource FemCombinationsCopyTip}"
                        IsEnabled="{Binding HasSelection}">
                    <Image Source="{StaticResource CmdIcon_Copy}" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource IconButton25}" Click="GenerateSp20_Click" ToolTip="{DynamicResource FemCombinationsSp20Tip}">
                    <Image Source="{StaticResource CmdIcon_GroupAuto}" Width="16" Height="16"/>
                </Button>
                <Separator/>
                <Button Style="{StaticResource IconButton25}" Click="DeleteCombinations_Click" ToolTip="{DynamicResource FemCombinationsDeleteTip}"
                        IsEnabled="{Binding HasSelection}">
                    <Image Source="{StaticResource CmdIcon_Delete}" Width="16" Height="16"/>
                </Button>
            </ToolBar>
            <!-- «Авто»-коэффициенты устарели (сменились γf или вид величин в настройках) — пересчитать одной отменой. -->
            <Border DockPanel.Dock="Top" Background="#FFF6D5" BorderBrush="#E0C060" BorderThickness="1" Padding="6,3" Margin="0,0,0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStale}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource FemCombinationsRecompute}" Padding="8,1" Margin="6,0,0,0"
                            Click="RecomputeAuto_Click" ToolTip="{DynamicResource FemCombinationsRecomputeTip}"/>
                    <TextBlock Text="{Binding StaleText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Grid>
                <DataGrid x:Name="combinationsGrid" Style="{StaticResource CombGrid}" ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource FemLoadsColNumber}" Binding="{Binding Number}" Width="32"/>
                        <DataGridTextColumn Header="{DynamicResource FemLoadsColName}" Binding="{Binding Tag}" Width="*" MinWidth="90"
                                            ElementStyle="{StaticResource LeftText}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCombinationsColType}" Binding="{Binding Type}" Width="40"/>
                        <DataGridTextColumn Header="{DynamicResource FemCombinationsColFormula}" Binding="{Binding Formula}" Width="1.5*"
                                            MinWidth="90" ElementStyle="{StaticResource LeftText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{DynamicResource FemCombinationsEmpty}" Foreground="Gray" TextWrapping="Wrap" Margin="10,34,10,0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Margin="2,6,2,0"/>

        <!-- Выбранная комбинация -->
        <Grid Grid.Row="1" Grid.Column="2" Margin="0,6,0,0" IsEnabled="{Binding HasSelection}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- №, имя, тип -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource FemLoadsColNumber}"/>
                <TextBox Grid.Row="1" Text="{Binding NumberText, Mode=OneWay}" IsReadOnly="True" Margin="0,0,6,0"
                         Background="#F3F3F3" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{DynamicResource FemCombinationsName}"/>
                <TextBox x:Name="tagBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,0" KeyDown="CommitOnEnter"
                         Text="{Binding TagText, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{DynamicResource FemCombinationsColType}"/>
                <ComboBox x:Name="typeCombo" Grid.Row="1" Grid.Column="2" IsEditable="True"
                          ItemsSource="{x:Static vm:FemCombinationsTabVM.CombinationTypes}"
                          Text="{Binding TypeText, UpdateSourceTrigger=LostFocus}"
                          ToolTip="{DynamicResource FemCombinationDialogTypeTip}"
                          DropDownClosed="TypeCombo_DropDownClosed" KeyDown="CommitOnEnter"/>
            </Grid>

            <!-- Загружения схемы | стрелки | загружения в комбинации -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{DynamicResource FemCombinationsAvailableHeader}"/>
                    <ComboBox DockPanel.Dock="Bottom" Margin="0,4,0,0" ItemsSource="{Binding CaseFilters}"
                              SelectedValuePath="Key" DisplayMemberPath="Label" SelectedValue="{Binding Filter}"
                              ToolTip="{DynamicResource FemCombinationsFilterTip}"/>
                    <DataGrid x:Name="availableGrid" Style="{StaticResource CombGrid}" ItemsSource="{Binding AvailableCases}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="MouseDoubleClick" Handler="AvailableRow_DoubleClick"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn CellTemplate="{StaticResource Sp20IconCell}" Width="24"/>
                            <DataGridTextColumn Header="{DynamicResource FemCombinationsColCode}" Binding="{Binding Code}" Width="46"/>
                            <DataGridTextColumn Header="{DynamicResource FemLoadsColName}" Binding="{Binding Tag}" Width="*"
                                                ElementStyle="{StaticResource LeftText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                    <Button Style="{StaticResource ArrowButton}" Click="AddTerms_Click" ToolTip="{DynamicResource FemCombinationsAddTip}">
                        <Path Style="{StaticResource ArrowPath}" Data="M6,3 L11,8 L6,13"/>
                    </Button>
                    <Button Style="{StaticResource ArrowButton}" Click="AddAllTerms_Click" ToolTip="{DynamicResource FemCombinationsAddAllTip}">
                        <Path Style="{StaticResource ArrowPath}" Data="M3,3 L8,8 L3,13 M9,3 L14,8 L9,13"/>
                    </Button>
                    <Border Height="16"/>
                    <Button Style="{StaticResource ArrowButton}" Click="RemoveTerms_Click" ToolTip="{DynamicResource FemCombinationsRemoveTip}">
                        <Path Style="{StaticResource ArrowPath}" Data="M10,3 L5,8 L10,13"/>
                    </Button>
                    <Button Style="{StaticResource ArrowButton}" Click="RemoveAllTerms_Click" ToolTip="{DynamicResource FemCombinationsRemoveAllTip}">
                        <Path Style="{StaticResource ArrowPath}" Data="M7,3 L2,8 L7,13 M13,3 L8,8 L13,13"/>
                    </Button>
                </StackPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{Binding TermsHeader}"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                        <ComboBox Width="70" IsEditable="True" ItemsSource="{x:Static vm:FemCombinationsTabVM.CommonCoefficients}"
                                  Text="{Binding CoefficientText, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{DynamicResource FemCombinationsCoefficientTip}"/>
                        <Button Style="{StaticResource IconButton25}" Margin="4,0,0,0" Click="ApplyCoefficient_Click"
                                ToolTip="{DynamicResource FemCombinationsApplyTip}">
                            <Path Data="M3,8 L7,12 L13,4" Stroke="#2060B0" StrokeThickness="2.2" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="resetButton" Margin="4,0,0,0" Padding="6,0" MinHeight="25" Click="ResetCoefficient_Click"
                                ToolTip="{DynamicResource FemCombinationsResetTip}"/>
                    </StackPanel>
                    <DataGrid x:Name="termsGrid" Style="{StaticResource CombGrid}" ItemsSource="{Binding Terms}" IsReadOnly="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="MouseDoubleClick" Handler="TermRow_DoubleClick"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- «Авто» — серая подстановка «1,4·0,9 = 1,26»; правка — число (режим «задано»). -->
                            <DataGridTemplateColumn Header="{DynamicResource FemCombinationsColCoefficient}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CoefficientDisplay}" Margin="3,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAuto}" Value="True">
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                            <Setter Property="ToolTip" Value="{DynamicResource FemCombinationsAutoCellTip}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Coefficient, UpdateSourceTrigger=LostFocus}" BorderThickness="0"
                                                 Loaded="CoefficientEditor_Loaded"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource FemCombinationsColRole}" Width="130" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RoleChoices}" SelectedValuePath="Key" DisplayMemberPath="Label"
                                                  SelectedValue="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{DynamicResource FemCombinationsRoleTip}" BorderThickness="0" Padding="3,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn CellTemplate="{StaticResource Sp20IconCell}" Width="24" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{DynamicResource FemCombinationsColCode}" Binding="{Binding Code}" Width="46" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{DynamicResource FemLoadsColName}" Binding="{Binding Tag}" Width="*" IsReadOnly="True"
                                                ElementStyle="{StaticResource LeftText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>

            <!-- Комментарий -->
            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{DynamicResource FemCombinationsComment}"/>
                <TextBox x:Name="commentBox" Text="{Binding CommentText, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"/>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Status}" Foreground="#B00020" TextWrapping="Wrap" Margin="2,6,2,0"/>
    </Grid>
</UserControl>
