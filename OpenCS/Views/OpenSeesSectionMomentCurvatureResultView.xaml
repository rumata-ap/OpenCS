<UserControl x:Class="OpenCS.Views.OpenSeesSectionMomentCurvatureResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:OpenCS.Views">
   <Grid Margin="14">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,12">
         <TextBlock Text="{DynamicResource OpenSeesMomentCurvatureReportTitle}" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock Text="{DynamicResource OpenSeesMomentCurvatureReportSubtitle}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,3,0,0"/>
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,0,0,12">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <Border Grid.Column="0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="1" Padding="10,8" Margin="0,0,6,0">
            <StackPanel>
               <TextBlock Text="{DynamicResource OpenSeesMomentCurvatureStatusLabel}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="11"/>
               <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0"/>
            </StackPanel>
         </Border>
         <Border Grid.Column="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="1" Padding="10,8" Margin="0,0,6,0">
            <StackPanel>
               <TextBlock Text="{DynamicResource OpenSeesMomentCurvatureLastMoment}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="11"/>
               <TextBlock Text="{Binding LastConvergedRow.MomentKnM, StringFormat={}{0:0.###}}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0"/>
            </StackPanel>
         </Border>
         <Border Grid.Column="2" BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="1" Padding="10,8" Margin="0,0,6,0">
            <StackPanel>
               <TextBlock Text="{DynamicResource OpenSeesMomentCurvatureLastCurvature}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="11"/>
               <TextBlock Text="{Binding LastConvergedRow.Curvature, StringFormat={}{0:0.#####}}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0"/>
            </StackPanel>
         </Border>
         <Border Grid.Column="3" BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="1" Padding="10,8">
            <StackPanel>
               <TextBlock Text="{DynamicResource OpenSeesMomentCurvatureHistoryCount}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="11"/>
               <TextBlock Text="{Binding HistoryCountText}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0"/>
            </StackPanel>
         </Border>
      </Grid>

      <TabControl Grid.Row="2">
          <TabItem Header="{DynamicResource OpenSeesMomentCurvatureTabChart}">
             <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="1" Padding="8">
                <Grid>
                   <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                   </Grid.RowDefinitions>
                   <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                   </Grid.ColumnDefinitions>
                   <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource OpenSeesMomentCurvatureMomentAxis}"
                              VerticalAlignment="Center" Margin="0,0,8,0">
                      <TextBlock.LayoutTransform>
                         <RotateTransform Angle="-90"/>
                      </TextBlock.LayoutTransform>
                   </TextBlock>
                   <h:PlotCanvas Grid.Row="0" Grid.Column="1" x:Name="MomentCurvaturePlot"/>
                   <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource OpenSeesMomentCurvatureCurvatureAxis}"
                              HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </Grid>
             </Border>
          </TabItem>
         <TabItem Header="{DynamicResource OpenSeesMomentCurvatureTabHistory}">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="28">
               <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource OpenSeesMomentCurvatureStepColumn}" Binding="{Binding Step}" Width="70"/>
                  <DataGridTextColumn Header="{DynamicResource OpenSeesMomentCurvatureLoadFactorColumn}" Binding="{Binding LoadFactor, StringFormat={}{0:G6}}" Width="110"/>
                  <DataGridTextColumn Header="{DynamicResource OpenSeesMomentCurvatureAxialForceColumn}" Binding="{Binding AxialForceKn, StringFormat={}{0:G6}}" Width="130"/>
                  <DataGridTextColumn Header="{DynamicResource OpenSeesMomentCurvatureMomentColumn}" Binding="{Binding MomentKnM, StringFormat={}{0:G6}}" Width="130"/>
                  <DataGridTextColumn Header="{DynamicResource OpenSeesMomentCurvatureAxialStrainColumn}" Binding="{Binding AxialStrain, StringFormat={}{0:G6}}" Width="130"/>
                  <DataGridTextColumn Header="{DynamicResource OpenSeesMomentCurvatureCurvatureColumn}" Binding="{Binding Curvature, StringFormat={}{0:G6}}" Width="130"/>
                  <DataGridTextColumn Header="{DynamicResource OpenSeesMomentCurvatureStatusColumn}" Binding="{Binding StatusText}" Width="*"/>
               </DataGrid.Columns>
            </DataGrid>
         </TabItem>
         <TabItem Header="{DynamicResource OpenSeesMomentCurvatureTabDiagnostics}">
            <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
               <StackPanel>
                  <TextBlock Text="{DynamicResource OpenSeesMomentCurvatureStatusLabel}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" Margin="0,3,0,12"/>
                  <TextBlock Text="{DynamicResource OpenSeesMomentCurvatureDiagnosticsLabel}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding DiagnosticsText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                  <TextBlock Text="{DynamicResource OpenSeesMomentCurvatureArtifactLabel}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding ArtifactDirectory}" TextWrapping="Wrap" Margin="0,4,0,0"/>
               </StackPanel>
            </ScrollViewer>
         </TabItem>
      </TabControl>
   </Grid>
</UserControl>
