<Window x:Class="OpenCS.Views.StoreyFragmentMasksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource StoreyFragmentMasksTitle}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="schemaText" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{DynamicResource StoreyFragmentMasksSource}" Margin="0,0,0,2"/>
        <ComboBox x:Name="sourceBox" DisplayMemberPath="Label" Margin="0,0,0,4"/>
        <TextBlock x:Name="reasonText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>
        <TextBlock x:Name="currentText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="{DynamicResource StoreyFragmentMasksHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="takeButton" Content="{DynamicResource StoreyFragmentMasksTake}" MinWidth="72" Padding="8,0"
                    IsDefault="True" Click="Take_Click" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Cancel}" Width="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
