<Window x:Class="OpenCS.Views.StoreyFragmentMasksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource StoreyFragmentMasksTitle}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="schemaText" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="currentText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock Text="{DynamicResource StoreyFragmentMasksHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- Блок 1: снять маски из готового результата — источник и «Снять» рядом. -->
        <GroupBox Header="{DynamicResource StoreyFragmentMasksFromResult}" Padding="6" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{DynamicResource StoreyFragmentMasksSource}" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="sourceBox" DisplayMemberPath="Label"/>
                    <Button x:Name="takeButton" Grid.Column="1" Content="{DynamicResource StoreyFragmentMasksTake}" MinWidth="72"
                            Padding="8,0" IsDefault="True" Click="Take_Click" Margin="6,0,0,0"/>
                </Grid>
                <TextBlock x:Name="reasonText" Foreground="Firebrick" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </GroupBox>

        <!-- Блок 2: служебные расчёты родителя — выбранный выше источник не используется. -->
        <GroupBox Header="{DynamicResource StoreyFragmentMasksRecompute}" Padding="6" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{DynamicResource StoreyFragmentMasksRecomputeHint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Text="{DynamicResource StoreyFragmentMasksAllHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <Button x:Name="allButton" Content="{DynamicResource StoreyFragmentMasksAll}" Padding="8,0" Click="All_Click"
                        HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource StoreyFragmentMasksSecantHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource StoreyFragmentMasksSecantBy}" Margin="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="secantBox" DisplayMemberPath="Label"/>
                    <Button x:Name="secantButton" Grid.Column="1" Content="{DynamicResource StoreyFragmentMasksSecant}" Padding="8,0"
                            Click="Secant_Click" Margin="6,0,0,0"/>
                </Grid>
                <TextBlock x:Name="secantNoneText" Text="{DynamicResource StoreyFragmentMasksSecantNone}" Foreground="Gray"
                           TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </GroupBox>

        <Button Content="{DynamicResource Cancel}" Width="72" IsCancel="True" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
