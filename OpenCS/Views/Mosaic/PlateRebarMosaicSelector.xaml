<UserControl x:Class="OpenCS.Views.Mosaic.PlateRebarMosaicSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:OpenCS.Utilites">
    <!-- DataContext — PlateRebarMosaicVM -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <u:AnyDoubleConverter x:Key="AnyDoubleConv"/>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" ToolTip="{DynamicResource PlateRebarMosaicTip}">
        <TextBlock Text="{DynamicResource PlateRebarMosaicLabel}" VerticalAlignment="Center" Margin="4,0,4,0"/>
        <ComboBox Width="170" ItemsSource="{Binding SourceOptions}" DisplayMemberPath="Label"
                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                  DropDownOpened="Source_DropDownOpened"/>
        <!-- Набор усилий или проверка -->
        <ComboBox Width="200" Margin="4,0,0,0" ItemsSource="{Binding SubjectOptions}" DisplayMemberPath="Label"
                  SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                  Visibility="{Binding HasSubject, Converter={StaticResource BoolToVis}}"
                  DropDownOpened="Source_DropDownOpened"/>
        <ComboBox Width="150" Margin="4,0,0,0" ItemsSource="{Binding ComponentOptions}" DisplayMemberPath="Label"
                  SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                  IsEnabled="{Binding IsActive}"/>
        <!-- Усилия стержней результата расчёта — своим списком: эпюры поверх величины пластин -->
        <StackPanel Orientation="Horizontal" Visibility="{Binding HasBarComponents, Converter={StaticResource BoolToVis}}"
                    ToolTip="{DynamicResource MosaicResultBarsTip}">
            <TextBlock Text="{DynamicResource MosaicResultBarsLabel}" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <ComboBox Width="110" ItemsSource="{Binding BarComponentOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedBarComponent, Mode=TwoWay}"/>
        </StackPanel>
        <!-- Жёсткости результата CSfea: начальная, секущая или их отношение (общий режим пластин и стержней) -->
        <ComboBox Width="64" Margin="4,0,0,0" ItemsSource="{Binding StiffnessModeOptions}" DisplayMemberPath="Label"
                  SelectedItem="{Binding SelectedStiffnessMode, Mode=TwoWay}"
                  Visibility="{Binding HasStiffnessMode, Converter={StaticResource BoolToVis}}"
                  ToolTip="{DynamicResource MosaicStiffnessModeTip}"/>
        <ComboBox Width="130" Margin="4,0,0,0" ItemsSource="{Binding AggregateOptions}" DisplayMemberPath="Label"
                  SelectedItem="{Binding SelectedAggregate, Mode=TwoWay}"
                  Visibility="{Binding HasAggregate, Converter={StaticResource BoolToVis}}"
                  ToolTip="{DynamicResource MosaicAggregateTip}"/>
        <StackPanel Orientation="Horizontal" Visibility="{Binding HasBarDiagrams, Converter={StaticResource BoolToVis}}">
            <CheckBox x:Name="BarDiagramsCheck" Margin="8,0,0,0" VerticalAlignment="Center" Content="{DynamicResource MosaicBarDiagrams}"
                      IsChecked="{Binding ShowBarDiagrams, Mode=TwoWay}"
                      ToolTip="{DynamicResource MosaicBarDiagramsTip}"/>
            <!-- Масштаб эпюр: множитель к автомасштабу по видимому фрагменту; подписи экстремумов -->
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=BarDiagramsCheck}">
                <TextBlock Text="×" VerticalAlignment="Center" Margin="6,0,2,0"/>
                <TextBox Width="42" TextAlignment="Center" VerticalAlignment="Center" ToolTip="{DynamicResource MosaicBarDiagramScaleTip}"
                         Text="{Binding BarDiagramScale, Converter={StaticResource AnyDoubleConv}, ConverterParameter=F2, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                <Button Content="⟲" Command="{Binding ResetBarDiagramScaleCommand}" ToolTip="{DynamicResource MosaicBarDiagramScaleResetTip}"
                        Padding="4,0" Margin="2,0,0,0" VerticalAlignment="Center"/>
                <CheckBox Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource MosaicBarDiagramLabels}"
                          IsChecked="{Binding ShowBarDiagramLabels, Mode=TwoWay}" ToolTip="{DynamicResource MosaicBarDiagramLabelsTip}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
