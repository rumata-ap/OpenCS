<Window x:Class="OpenCS.Views.ElementFragmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ElementFragmentTitle}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="NoteText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock Text="{Binding ParentTag}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{DynamicResource ElementFragmentMembers}" Margin="0,0,0,2"/>
        <TextBox Text="{Binding MemberTagsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="60"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" Background="WhiteSmoke"/>
        <TextBlock Text="{Binding Message}" Foreground="DarkOrange" Style="{StaticResource NoteText}"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource ElementFragmentOffset}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="offsetBox" Grid.Column="1" Width="80" VerticalContentAlignment="Center"
                     Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}"
                     LostFocus="Offset_LostFocus" KeyDown="Offset_KeyDown"/>
            <Button Grid.Column="2" Content="{DynamicResource ElementFragmentRecalc}" Padding="8,0" Margin="6,0,0,0"
                    Click="Recalc_Click"/>
        </Grid>

        <Grid Margin="0,0,0,6" IsEnabled="{Binding CanPickLevels}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource ElementFragmentFrom}" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <ComboBox Grid.Column="1" Margin="0,0,0,4" ItemsSource="{Binding Levels}" SelectedItem="{Binding FromLevel}"
                      DisplayMemberPath="Label"/>
            <TextBlock Grid.Row="1" Text="{DynamicResource ElementFragmentTo}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Levels}" SelectedItem="{Binding ToLevel}"
                      DisplayMemberPath="Label"/>
        </Grid>
        <CheckBox Content="{DynamicResource ElementFragmentFullHeight}" IsChecked="{Binding FullHeight}"
                  IsEnabled="{Binding CanToggleFullHeight}" Margin="0,2,0,8"/>

        <TextBlock Text="{Binding PrismText}" Foreground="Gray" Style="{StaticResource NoteText}"/>
        <TextBlock Text="{Binding RangeText}" Foreground="Gray" Style="{StaticResource NoteText}"/>

        <TextBlock Text="{DynamicResource StoreyFragmentName}" Margin="0,0,0,2"/>
        <TextBox Margin="0,0,0,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{DynamicResource ElementFragmentHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource StoreyFragmentBuild}" MinWidth="72" Padding="8,0" IsDefault="True"
                    IsEnabled="{Binding CanBuild}" Click="Apply_Click" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Cancel}" Width="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
