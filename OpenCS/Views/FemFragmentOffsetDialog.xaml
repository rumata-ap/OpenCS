<Window x:Class="OpenCS.Views.FemFragmentOffsetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FemPasteOffsetTitle}" Width="260" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock x:Name="summaryText" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock Text="{DynamicResource FemNodeOffsetDx}"/>
        <TextBox x:Name="dxBox" Text="0"/>
        <TextBlock Text="{DynamicResource FemNodeOffsetDy}" Margin="0,8,0,0"/>
        <TextBox x:Name="dyBox" Text="0"/>
        <TextBlock Text="{DynamicResource FemNodeOffsetDz}" Margin="0,8,0,0"/>
        <TextBox x:Name="dzBox" Text="0"/>
        <StackPanel x:Name="copiesPanel" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource FemFragmentCopies}" Margin="0,8,0,0"/>
            <TextBox x:Name="copiesBox" Text="1"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Click="Ok_Click" IsDefault="True" Padding="16,4" MinWidth="70"/>
            <Button Content="{DynamicResource Cancel}" IsCancel="True" Padding="16,4" MinWidth="70" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
