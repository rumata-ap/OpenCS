<Window x:Class="OpenCS.Views.PlanarRegionMemberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OpenCS.Views.Helpers"
        xmlns:conv="clr-namespace:OpenCS.Converters"
        Title="{DynamicResource PlanarRegionMemberDialogTitle}"
        Width="720" Height="560" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closing="Window_Closing">
   <Window.Resources>
      <conv:BoolToErrorBrushConverter x:Key="ErrorToBrush"/>
      <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
      <conv:NullToCollapsedVisibilityConverter x:Key="NullToCollapsedVisibilityConverter"/>
   </Window.Resources>
   <TabControl>
      <TabItem Header="{DynamicResource PlanarRegionTabGeometry}">
         <Grid>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
               </Grid.RowDefinitions>
               <ToolBar Grid.Row="0">
                  <Button Style="{StaticResource IconButton25}" Click="FitView_Click"
                          ToolTip="{DynamicResource PlanarRegionFitViewButton}">
                      <Path Data="M10,21V19H6.41L10.91,14.5L9.5,13.09L5,17.59V14H3V21H10M14.5,10.91L19,6.41V10H21V3H14V5H17.59L13.09,9.5L14.5,10.91M3,3V10H5V6.41L9.5,10.91L10.91,9.5L6.41,5H10V3H3M21,21V14H19V17.59L14.5,13.09L13.09,14.5L17.59,19H14V21H21Z"
                            Fill="Black" Stretch="Uniform" Margin="2"/>
                  </Button>
                  <Separator/>
                  <Button Style="{StaticResource IconButton25}" Click="MoveGeometry_Click"
                          ToolTip="{DynamicResource PlanarRegionPanTool}">
                      <Path Data="M13,6V11H18V7.75L22.25,12L18,16.25V13H13V18H16.25L12,22.25L7.75,18H11V13H6V16.25L1.75,12L6,7.75V11H11V6H7.75L12,1.75L16.25,6H13Z"
                            Fill="Black" Stretch="Uniform" Margin="2"/>
                  </Button>
                  <Button Style="{StaticResource IconButton25}" Click="ScaleGeometry_Click"
                          ToolTip="{DynamicResource PlanarRegionZoomTool}">
                      <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                            Fill="Black" Stretch="Uniform" Margin="2"/>
                  </Button>
                  <Button Style="{StaticResource IconButton25}" Click="RotateGeometry_Click"
                          ToolTip="{DynamicResource PlanarRegionRotateTool}">
                      <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                            Fill="Black" Stretch="Uniform" Margin="2"/>
                  </Button>
                  <Separator/>
                  <Button Style="{StaticResource IconButton25}" IsEnabled="False"
                          ToolTip="{DynamicResource PlanarRegionMeshToolStub}">
                      <Path Data="M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6Z"
                            Fill="Gray" Stretch="Uniform" Margin="2"/>
                  </Button>
               </ToolBar>
               <Border Grid.Row="1" BorderThickness="0,0,1,0"
                       BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                  <helpers:PlanarRegionPreviewCanvas x:Name="preview"/>
               </Border>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
               <StackPanel Margin="8">

                  <TextBlock Text="{DynamicResource Tag}" Margin="0,0,0,2"/>
                  <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                  <GroupBox Header="{DynamicResource Hull}" Margin="0,0,0,8">
                     <StackPanel Margin="4">
                        <ComboBox x:Name="hullCombo" ItemsSource="{Binding ProjectContours}"
                                  DisplayMemberPath="Tag" Margin="0,0,0,4"/>
                        <Button Content="{DynamicResource SelectFromPool}"
                                Command="{Binding SetHullFromPoolCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=hullCombo}"
                                Padding="6,3" HorizontalAlignment="Left"/>
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="Gray"
                                   Text="{Binding Hull.Tag, FallbackValue='-'}"/>
                     </StackPanel>
                  </GroupBox>

                  <GroupBox Header="{DynamicResource Holes}" Margin="0,0,0,8">
                     <StackPanel Margin="4">
                        <ComboBox x:Name="holeCombo" ItemsSource="{Binding ProjectContours}"
                                  DisplayMemberPath="Tag" Margin="0,0,0,4"/>
                        <Button Content="{DynamicResource AddHole}"
                                Command="{Binding AddHoleCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=holeCombo}"
                                Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <ListBox x:Name="holesList" ItemsSource="{Binding Holes}" DisplayMemberPath="Tag" Height="60"/>
                        <Button Content="{DynamicResource Delete}"
                                Command="{Binding RemoveHoleCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=holesList}"
                                Padding="6,3" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                     </StackPanel>
                  </GroupBox>

                  <TextBlock Text="{DynamicResource PlanarRegionKindLabel}" Margin="0,0,0,2"/>
                  <ComboBox SelectedValue="{Binding Kind}" SelectedValuePath="Tag" Margin="0,0,0,8">
                     <ComboBoxItem Tag="plate" Content="{DynamicResource PlanarRegionKindPlate}"/>
                     <ComboBoxItem Tag="wall" Content="{DynamicResource PlanarRegionKindWall}"/>
                  </ComboBox>

                  <TextBlock Text="{DynamicResource PlanarRegionPlateSectionLabel}" Margin="0,0,0,2"/>
                  <ComboBox ItemsSource="{Binding ProjectPlateSections}"
                            SelectedItem="{Binding PlateSection}"
                            DisplayMemberPath="Tag" Margin="0,0,0,8"
                            Visibility="{Binding HasZones, Converter={StaticResource InverseBoolToVisibility}}"/>

                  <StackPanel Visibility="{Binding HasZones, Converter={StaticResource BoolToVisibility}}">
                     <TextBlock Text="{Binding PlateSection.Tag}" FontWeight="Bold" Margin="0,0,0,2"/>
                     <TextBlock Text="{DynamicResource PlanarRegionPlateSectionGeneratedHint}"
                                FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

                     <GroupBox Header="{DynamicResource PlateSectionGeometry}" Margin="0,0,0,8"
                               DataContext="{Binding GeneratedSectionVM}">
                        <Grid Margin="6">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="140"/>
                              <ColumnDefinition Width="*"/>
                           </Grid.ColumnDefinitions>
                           <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                           </Grid.RowDefinitions>
                           <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource PlateThicknessMm}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                           <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding HMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G6}"/>
                           <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource PlateNLayers}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                           <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" IsEnabled="{Binding IsLayered}" Text="{Binding NLayers, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                     </GroupBox>

                     <GroupBox Header="{DynamicResource PlateSectionMaterials}" Margin="0,0,0,8"
                               DataContext="{Binding GeneratedSectionVM}">
                        <Grid Margin="6">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="140"/>
                              <ColumnDefinition Width="*"/>
                           </Grid.ColumnDefinitions>
                           <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                           </Grid.RowDefinitions>

                           <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Concrete}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                           <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                     ItemsSource="{Binding App.Concretes}" SelectedItem="{Binding ConcreteMaterial, Mode=TwoWay}" DisplayMemberPath="Tag"/>

                           <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Reinforcement}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                           <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                     ItemsSource="{Binding App.Armatures}" SelectedItem="{Binding RebarMaterial, Mode=TwoWay}" DisplayMemberPath="Tag"/>

                           <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource PlateConcreteDiagramType}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                           <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" SelectedValue="{Binding ConcreteDiagramType, Mode=TwoWay}" SelectedValuePath="Tag">
                              <ComboBoxItem Tag="L2"   Content="{DynamicResource DiagramTypeL2}"/>
                              <ComboBoxItem Tag="L3"   Content="{DynamicResource DiagramTypeL3}"/>
                              <ComboBoxItem Tag="SP63" Content="{DynamicResource DiagramTypeSP63}"/>
                              <ComboBoxItem Tag="EKB"  Content="{DynamicResource DiagramTypeEKB}"/>
                              <ComboBoxItem Tag="SP35" Content="{DynamicResource DiagramTypeSP35}"/>
                           </ComboBox>

                           <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource PlateTensionConcrete}" VerticalAlignment="Center" Margin="0,0,8,4" ToolTip="{DynamicResource PlateTensionConcreteTip}"/>
                           <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" IsChecked="{Binding TensionConcrete, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{DynamicResource PlateTensionConcreteTip}"/>

                           <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource PlateSofteningModel}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                           <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" ItemsSource="{Binding SofteningOptions}" SelectedIndex="{Binding SofteningIndex, Mode=TwoWay}"/>

                           <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource PlateModel}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                           <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,4" ItemsSource="{Binding PlateModelOptions}" SelectedValuePath="Key" DisplayMemberPath="Display" SelectedValue="{Binding PlateModel, Mode=TwoWay}"/>
                        </Grid>
                     </GroupBox>
                  </StackPanel>

                  <TextBlock Text="{DynamicResource PlanarRegionDiagnosticsLabel}" Margin="0,0,0,2"/>
                  <ListBox ItemsSource="{Binding Diagnostics}" Height="80" Margin="0,0,0,8">
                     <ListBox.ItemTemplate>
                        <DataTemplate>
                           <TextBlock Text="{Binding Message}"
                                      Foreground="{Binding IsError, Converter={StaticResource ErrorToBrush}}"
                                      TextWrapping="Wrap"/>
                        </DataTemplate>
                     </ListBox.ItemTemplate>
                  </ListBox>

                  <GroupBox Header="{DynamicResource PlanarRegionGeoPropsGroupHeader}" Margin="0,0,0,8">
                     <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                           <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource PlanarRegionGeoPropsAreaLabel}" Margin="0,0,8,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GeoArea, StringFormat=F4}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource PlanarRegionGeoPropsCentroidLabel}" Margin="0,0,8,2"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                           <TextBlock Text="{Binding GeoCentroidX, StringFormat=F4}"/>
                           <TextBlock Text="; "/>
                           <TextBlock Text="{Binding GeoCentroidY, StringFormat=F4}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource PlanarRegionGeoPropsIxLabel}" Margin="0,0,8,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GeoIx, StringFormat=F6}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource PlanarRegionGeoPropsIyLabel}" Margin="0,0,8,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GeoIy, StringFormat=F6}"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource PlanarRegionGeoPropsIxyLabel}" Margin="0,0,8,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GeoIxy, StringFormat=F6}"/>
                     </Grid>
                  </GroupBox>

                  <StackPanel Orientation="Horizontal">
                     <Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}"
                             Padding="12,4" Margin="0,0,8,0"/>
                     <Button Content="{DynamicResource Delete}" Command="{Binding DeleteCommand}"
                             Padding="12,4"/>
                  </StackPanel>
               </StackPanel>
            </ScrollViewer>
         </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource PlanarRegionTabRebar}">
         <Grid>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
               </Grid.RowDefinitions>
               <ToolBar Grid.Row="0">
                  <Button Style="{StaticResource IconButton25}" Click="FitRebarView_Click"
                          ToolTip="{DynamicResource PlanarRegionFitViewButton}">
                      <Path Data="M10,21V19H6.41L10.91,14.5L9.5,13.09L5,17.59V14H3V21H10M14.5,10.91L19,6.41V10H21V3H14V5H17.59L13.09,9.5L14.5,10.91M3,3V10H5V6.41L9.5,10.91L10.91,9.5L6.41,5H10V3H3M21,21V14H19V17.59L14.5,13.09L13.09,14.5L17.59,19H14V21H21Z"
                            Fill="Black" Stretch="Uniform" Margin="2"/>
                  </Button>
                  <Separator/>
                  <Button Style="{StaticResource IconButton25}" Click="MoveZoneGeometry_Click"
                          ToolTip="{DynamicResource PlanarRegionRebarZoneMoveTool}">
                      <Path Data="M13,6V11H18V7.75L22.25,12L18,16.25V13H13V18H16.25L12,22.25L7.75,18H11V13H6V16.25L1.75,12L6,7.75V11H11V6H7.75L12,1.75L16.25,6H13Z"
                            Fill="Black" Stretch="Uniform" Margin="2"/>
                  </Button>
                  <Button Style="{StaticResource IconButton25}" Click="ScaleZoneGeometry_Click"
                          ToolTip="{DynamicResource PlanarRegionRebarZoneZoomTool}">
                      <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                            Fill="Black" Stretch="Uniform" Margin="2"/>
                  </Button>
                  <Button Style="{StaticResource IconButton25}" Click="RotateZoneGeometry_Click"
                          ToolTip="{DynamicResource PlanarRegionRebarZoneRotateTool}">
                      <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                            Fill="Black" Stretch="Uniform" Margin="2"/>
                  </Button>
                  <Separator/>
                  <Button Style="{StaticResource IconButton25}" Command="{Binding ComputeSectionCountCommand}"
                          ToolTip="{DynamicResource PlanarRegionComputeSectionCountTool}">
                      <Path Data="M7,2H17A2,2 0 0,1 19,4V20A2,2 0 0,1 17,22H7A2,2 0 0,1 5,20V4A2,2 0 0,1 7,2M7,4V8H17V4H7M7,10V12H9V10H7M11,10V12H13V10H11M15,10V12H17V10H15M7,14V16H9V14H7M11,14V16H13V14H11M15,14V16H17V14H15M7,18V20H9V18H7M11,18V20H13V18H11M15,18V20H17V18H15Z"
                            Fill="Black" Stretch="Uniform" Margin="2"/>
                  </Button>
               </ToolBar>
               <Border Grid.Row="1" BorderThickness="0,0,1,0"
                       BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                  <helpers:PlanarRegionPreviewCanvas x:Name="rebarPreview"/>
               </Border>
               <Border Grid.Row="2" BorderThickness="0,1,1,0"
                       BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                  <StackPanel Margin="4">
                     <TextBlock Text="{DynamicResource PlanarRegionRebarBaseLayoutHeader}" FontWeight="Bold" Margin="2,0,0,2"/>
                     <DataGrid ItemsSource="{Binding ActiveFaceSectionRebarLayers}"
                               SelectedItem="{Binding SelectedSectionRebarLayer, Mode=TwoWay}"
                               AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                               SelectionMode="Single" SelectionUnit="FullRow"
                               GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                               Height="100" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                           <DataGridTextColumn Header="{DynamicResource PlateLayerName}"
                                               Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                           <DataGridComboBoxColumn Header="{DynamicResource PlateLayerMode}"
                                                    SelectedValueBinding="{Binding InputMode, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectedValuePath="Key" DisplayMemberPath="Display" Width="120">
                              <DataGridComboBoxColumn.EditingElementStyle>
                                 <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.InputModeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                 </Style>
                              </DataGridComboBoxColumn.EditingElementStyle>
                              <DataGridComboBoxColumn.ElementStyle>
                                 <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.InputModeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                 </Style>
                              </DataGridComboBoxColumn.ElementStyle>
                           </DataGridComboBoxColumn>
                           <DataGridTextColumn Header="{DynamicResource PlateLayerDiamX}"
                                               Binding="{Binding DiameterXMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Width="65"/>
                           <DataGridTextColumn Header="{DynamicResource PlateLayerSpacingX}"
                                               Binding="{Binding SpacingXMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Width="65"/>
                           <DataGridTextColumn Header="{DynamicResource PlateLayerZsx}"
                                               Binding="{Binding ZsxMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Width="65"/>
                           <DataGridTextColumn Header="{DynamicResource PlateLayerDiamY}"
                                               Binding="{Binding DiameterYMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Width="65"/>
                           <DataGridTextColumn Header="{DynamicResource PlateLayerSpacingY}"
                                               Binding="{Binding SpacingYMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Width="65"/>
                           <DataGridTextColumn Header="{DynamicResource PlateLayerZsy}"
                                               Binding="{Binding ZsyMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Width="65"/>
                           <DataGridComboBoxColumn Header="{DynamicResource PlateLayerMaterial}"
                                                    SelectedItemBinding="{Binding RebarMaterial, UpdateSourceTrigger=PropertyChanged}"
                                                    DisplayMemberPath="Tag" Width="110">
                              <DataGridComboBoxColumn.EditingElementStyle>
                                 <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.ProjectArmatures, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                 </Style>
                              </DataGridComboBoxColumn.EditingElementStyle>
                              <DataGridComboBoxColumn.ElementStyle>
                                 <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.ProjectArmatures, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                 </Style>
                              </DataGridComboBoxColumn.ElementStyle>
                           </DataGridComboBoxColumn>
                        </DataGrid.Columns>
                     </DataGrid>
                     <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{DynamicResource AddRebarLayer}" Command="{Binding AddSectionRebarLayerCommand}" Padding="6,3" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource DeleteRebarLayer}" Command="{Binding DeleteSectionRebarLayerCommand}" Padding="6,3"/>
                     </StackPanel>
                  </StackPanel>
               </Border>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
               <StackPanel Margin="8">

                  <TabControl x:Name="rebarFaceTabs" Margin="0,0,0,8" SelectionChanged="RebarFaceTab_SelectionChanged">
                     <TabItem Header="{DynamicResource PlanarRegionRebarFaceBottomTab}" Tag="MinusN"/>
                     <TabItem Header="{DynamicResource PlanarRegionRebarFaceTopTab}" Tag="PlusN"/>
                  </TabControl>

                  <GroupBox Header="{DynamicResource PlanarRegionRebarZonesHeader}" Margin="0,0,0,8">
                     <StackPanel Margin="4">
                        <TextBlock Text="{DynamicResource PlanarRegionRebarSectionGridStepLabel}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding RebarSectionGridStep, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Margin="0,0,0,8"/>
                        <ListBox x:Name="zonesList" ItemsSource="{Binding ActiveFaceRebarZones}"
                                 SelectedItem="{Binding SelectedRebarZone, Mode=TwoWay}"
                                 SelectionMode="Extended"
                                 DisplayMemberPath="Name" Height="80" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                           <Button Content="{DynamicResource AddRebarZone}" Command="{Binding AddRebarZoneCommand}" Padding="6,3" Margin="0,0,8,0"/>
                           <Button Content="{DynamicResource Delete}" Command="{Binding DeleteRebarZoneCommand}" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                           <ComboBox x:Name="zoneBatchMaterialCombo" Width="140"
                                     ItemsSource="{Binding ProjectArmatures}" DisplayMemberPath="Tag" Margin="0,0,8,0"/>
                           <Button Content="{DynamicResource PlanarRegionRebarZoneApplyMaterialToSelected}"
                                   Click="ApplyZoneMaterial_Click" Padding="6,3"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource PlanarRegionRebarZonePolygonPool}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="geometrySetCombo" ItemsSource="{Binding AvailableGeometrySets}" Margin="0,0,0,4"/>
                        <Button Content="{DynamicResource PlanarRegionRebarZoneBatchAddFromSet}"
                                Command="{Binding BatchAddZonesFromSetCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=geometrySetCombo}"
                                Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                        <StackPanel DataContext="{Binding SelectedRebarZone}">
                           <TextBlock Text="{DynamicResource PlanarRegionRebarZoneNoSelection}"
                                      Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}"
                                      Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                           <StackPanel Visibility="{Binding Converter={StaticResource NullToCollapsedVisibilityConverter}}">
                              <TextBlock Text="{DynamicResource PlateLayerName}" Margin="0,0,0,2"/>
                              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                              <TextBlock Text="{DynamicResource PlanarRegionRebarZoneFace}" Margin="0,0,0,2"/>
                              <ComboBox SelectedValue="{Binding FaceKey}" SelectedValuePath="Tag" Margin="0,0,0,6">
                                 <ComboBoxItem Tag="PlusN" Content="{DynamicResource PlanarRegionRebarZoneFacePlusN}"/>
                                 <ComboBoxItem Tag="MinusN" Content="{DynamicResource PlanarRegionRebarZoneFaceMinusN}"/>
                              </ComboBox>

                              <TextBlock Text="{DynamicResource PlanarRegionRebarZoneOperation}" Margin="0,0,0,2"/>
                              <ComboBox SelectedValue="{Binding OperationKey}" SelectedValuePath="Tag" Margin="0,0,0,6">
                                 <ComboBoxItem Tag="Add" Content="{DynamicResource PlanarRegionRebarZoneOperationAdd}"/>
                                 <ComboBoxItem Tag="Replace" Content="{DynamicResource PlanarRegionRebarZoneOperationReplace}"/>
                              </ComboBox>

                              <TextBlock Text="{DynamicResource PlanarRegionRebarZonePriority}" Margin="0,0,0,2"/>
                              <TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                              <TextBlock Text="{DynamicResource PlanarRegionRebarZonePolygonPool}" Margin="0,0,0,2"/>
                              <ComboBox x:Name="zonePolyCombo"
                                        ItemsSource="{Binding DataContext.ProjectContours, RelativeSource={RelativeSource AncestorType=Window}}"
                                        DisplayMemberPath="Tag" Margin="0,0,0,4"/>
                              <Button Content="{DynamicResource SelectFromPool}"
                                      Command="{Binding DataContext.SetZonePolygonFromPoolCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding SelectedItem, ElementName=zonePolyCombo}"
                                      Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                 <TextBlock Text="{DynamicResource PlanarRegionRebarZonePointCountLabel}" FontSize="11" Foreground="Gray" Margin="0,0,4,0"/>
                                 <TextBlock Text="{Binding PointCount}" FontSize="11" Foreground="Gray"/>
                              </StackPanel>

                              <GroupBox Header="{DynamicResource PlateRebarLayers}">
                                 <StackPanel Margin="4">
                                    <TextBlock Text="{DynamicResource PlateLayerMaterial}" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding DataContext.ProjectArmatures, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Layout.RebarMaterial, Mode=TwoWay}"
                                              DisplayMemberPath="Tag" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource PlateLayerDiamX}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Layout.DiameterXMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource PlateLayerSpacingX}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Layout.SpacingXMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource PlateLayerZsx}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Layout.ZsxMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource PlateLayerDiamY}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Layout.DiameterYMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource PlateLayerSpacingY}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Layout.SpacingYMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource PlateLayerZsy}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Layout.ZsyMm, UpdateSourceTrigger=PropertyChanged, StringFormat=G4}"/>
                                 </StackPanel>
                              </GroupBox>
                           </StackPanel>
                        </StackPanel>
                     </StackPanel>
                  </GroupBox>

               </StackPanel>
            </ScrollViewer>
         </Grid>
      </TabItem>
   </TabControl>
</Window>
