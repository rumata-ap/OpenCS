<UserControl x:Class="OpenCS.Views.ShellSimplBatchResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:OpenCS.Views">
   <Grid Margin="12">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Шапка: вердикт -->
      <Border Grid.Row="0" Padding="8,6" Margin="0,0,0,8" CornerRadius="4"
              Background="{Binding StatusBrush}">
         <TextBlock Text="{Binding Summary}" FontWeight="Bold"
                    HorizontalAlignment="Center"/>
      </Border>

      <!-- Таблица строк -->
      <DockPanel Grid.Row="1">
         <v:BatchVerdictFilterBar DockPanel.Dock="Top" Target="{Binding ElementName=RowsGrid}"/>
         <DataGrid x:Name="RowsGrid" RowStyle="{StaticResource BatchVerdictRowStyle}" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                   IsReadOnly="True" GridLinesVisibility="Horizontal"
                   CanUserSortColumns="True" RowHeaderWidth="0"
                   SelectionMode="Single" SelectionUnit="FullRow"
                   MouseDoubleClick="RowsGrid_MouseDoubleClick">
            <DataGrid.ContextMenu>
               <ContextMenu>
                  <MenuItem Header="{DynamicResource CalcTaskNew}"
                            Click="CreateTask_Click"/>
                  <Separator/>
                  <MenuItem Header="{DynamicResource ExportCsvBtn}"
                            Click="ExportCsv_Click"/>
               </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
               <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColNum}" Binding="{Binding Num}" Width="40"/>
               <DataGridTextColumn Header="{DynamicResource StrainStateBatch_ColLabel}" Binding="{Binding Label}" Width="*"/>
               <DataGridTextColumn Header="{DynamicResource ShellSimplColEtaMax}" Binding="{Binding EtaMaxDisplay}"/>
               <DataGridTextColumn x:Name="EtaQColumn" Header="{DynamicResource PlateShearColEtaQ}" Binding="{Binding EtaQDisplay}"
                                   Visibility="Collapsed"/>
               <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
               <DataGridTextColumn Header="{DynamicResource BatchVerdictColUtil}" Binding="{Binding Reason.UtilText}"
                                   SortMemberPath="Reason.SortUtil" Width="60"/>
               <DataGridTextColumn Header="{DynamicResource BatchVerdictColReason}" Binding="{Binding Reason.ReasonText}" Width="2*"/>
            </DataGrid.Columns>
         </DataGrid>
      </DockPanel>

      <!-- Кнопки внизу -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
         <Button Content="{DynamicResource CalcTaskNew}"
                 Click="CreateTask_Click"
                 Padding="12,4" Margin="0,0,8,0"
                 x:Name="CreateTaskBtn" IsEnabled="False"/>
         <Button Content="{DynamicResource ExportCsvBtn}"
                 Click="ExportCsv_Click"
                 Padding="12,4"/>
      </StackPanel>
   </Grid>
</UserControl>
