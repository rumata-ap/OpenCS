<UserControl x:Class="OpenCS.Views.BatchVerdictFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="{DynamicResource BatchVerdictShow}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="FilterBox" Width="170" SelectedIndex="0" SelectionChanged="FilterBox_SelectionChanged">
         <ComboBoxItem Content="{DynamicResource BatchVerdictFilterAll}"/>
         <ComboBoxItem Content="{DynamicResource BatchVerdictFilterFailed}"/>
         <ComboBoxItem Content="{DynamicResource BatchVerdictFilterNotConverged}"/>
      </ComboBox>
      <TextBlock x:Name="CountsText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
      <Button x:Name="TasksBtn" Content="{DynamicResource BatchRowTasksMenu}" Margin="12,0,0,0" Padding="8,2"
              Visibility="Collapsed" Click="TasksBtn_Click">
         <Button.ContextMenu>
            <ContextMenu>
               <MenuItem Header="{DynamicResource BatchRowTasksGoverning}" Click="TasksGoverning_Click"/>
               <MenuItem Header="{DynamicResource BatchRowTasksFailed}" Click="TasksFailed_Click"/>
            </ContextMenu>
         </Button.ContextMenu>
      </Button>
   </StackPanel>
</UserControl>
