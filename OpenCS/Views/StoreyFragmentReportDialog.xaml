<Window x:Class="OpenCS.Views.StoreyFragmentReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OpenCS.Views.Helpers"
        Title="{DynamicResource StoreyFragmentReportTitle}"
        Width="640" Height="420" MinWidth="360" MinHeight="200"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <helpers:DiagnosticColorConverter x:Key="DiagnosticColorConverter"/>
    </Window.Resources>
    <DockPanel Margin="12">
        <TextBlock x:Name="schemaText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="headerText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource StoreyFragmentReportCopy}" MinWidth="72" Padding="8,0" Click="Copy_Click" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Close}" Width="72" IsCancel="True" IsDefault="True"/>
        </StackPanel>
        <ListView x:Name="rowsList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Left" Width="110" Text="{Binding Level}" FontWeight="SemiBold"
                                   Foreground="{Binding IsError, Converter={StaticResource DiagnosticColorConverter}}"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                    </DockPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</Window>
