<Window x:Class="OpenCS.Views.FemMemberMeshStepDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FemMemberMeshStepTitle}"
        Width="320" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="targetText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <RadioButton x:Name="commonRadio" GroupName="step" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="localRadio" GroupName="step" Content="{DynamicResource FemMemberMeshStepLocal}"
                         VerticalAlignment="Center"/>
            <TextBox x:Name="stepBox" Width="72" Margin="6,0,0,0" VerticalContentAlignment="Center"
                     GotKeyboardFocus="StepBox_GotKeyboardFocus"/>
        </StackPanel>
        <TextBlock Text="{DynamicResource FemMemberMeshStepHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="72" IsDefault="True" Click="Apply_Click" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Cancel}" Width="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
