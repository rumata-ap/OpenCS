<UserControl x:Class="OpenCS.Views.FemCsfeaResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
             xmlns:u="clr-namespace:OpenCS.Utilites"
             xmlns:helpers="clr-namespace:OpenCS.Views.Helpers"
             xmlns:mosaic="clr-namespace:OpenCS.Views.Mosaic"
             Language="ru-RU">
    <UserControl.Resources>
        <u:AnyDoubleConverter x:Key="AnyDoubleConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="IconButton25" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" Margin="6,4"/>

        <TabControl Grid.Row="1">
            <!-- 3D -->
            <TabItem Header="{DynamicResource FemResultTab3D}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ToolBar Grid.Row="0">
                        <CheckBox Content="{DynamicResource Fem3DShowDeformedSchema}" IsChecked="{Binding ShowDeformed}"
                                  VerticalAlignment="Center" Margin="4,0"/>
                        <TextBlock Text="{DynamicResource Fem3DDisplacementScale}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                        <TextBox Width="65" Text="{Binding DeformScale, Converter={StaticResource AnyDoubleConv}, ConverterParameter=F2, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                 VerticalAlignment="Center" TextAlignment="Center" Margin="4,0"/>
                        <Button Style="{StaticResource IconButton25}" ToolTip="{DynamicResource FemResetScale}" Command="{Binding ResetDeformScaleCommand}">
                            <Path Data="M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12C4,14.21 4.9,16.21 6.34,17.65L7.76,16.24C6.67,15.15 6,13.66 6,12A6,6 0 0,1 12,6Z" Fill="Black" Stretch="Uniform" Margin="2"/>
                        </Button>
                        <Separator/>
                        <TextBlock Text="{DynamicResource FemCsfeaShells}" VerticalAlignment="Center" Margin="4,0,2,0"
                                   Visibility="{Binding HasShells, Converter={StaticResource BoolToVis}}"/>
                        <ComboBox Width="230" Margin="4,0" VerticalAlignment="Center" ItemsSource="{Binding ShellFields}"
                                  SelectedItem="{Binding SelectedShellField}" DisplayMemberPath="Label"
                                  Visibility="{Binding HasShells, Converter={StaticResource BoolToVis}}"/>
                        <Separator/>
                        <TextBlock Text="{DynamicResource FemCsfeaBars}" VerticalAlignment="Center" Margin="4,0,2,0"
                                   Visibility="{Binding HasBeams, Converter={StaticResource BoolToVis}}"/>
                        <ComboBox Width="70" Margin="4,0" VerticalAlignment="Center" ItemsSource="{Binding ForceComponents}"
                                  SelectedItem="{Binding SelectedForceComponent}" DisplayMemberPath="Label"
                                  Visibility="{Binding HasBeams, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{DynamicResource FemResultForceScale}" VerticalAlignment="Center" Margin="4,0,2,0"
                                   Visibility="{Binding HasBeams, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Width="65" Text="{Binding ForceScale, Converter={StaticResource AnyDoubleConv}, ConverterParameter=F2, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                 VerticalAlignment="Center" TextAlignment="Center" Margin="4,0"
                                 Visibility="{Binding HasBeams, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource IconButton25}" ToolTip="{DynamicResource FemResetScale}" Command="{Binding ResetForceScaleCommand}"
                                Visibility="{Binding HasBeams, Converter={StaticResource BoolToVis}}">
                            <Path Data="M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12C4,14.21 4.9,16.21 6.34,17.65L7.76,16.24C6.67,15.15 6,13.66 6,12A6,6 0 0,1 12,6Z" Fill="Black" Stretch="Uniform" Margin="2"/>
                        </Button>
                    </ToolBar>
                    <h:HelixViewport3D x:Name="viewport" Grid.Row="1" Background="White"
                                       ShowCoordinateSystem="True" ShowViewCube="True" ZoomAroundMouseDownPoint="True"/>
                    <mosaic:PlateRebarMosaicLegend Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"/>
                </Grid>
            </TabItem>

            <!-- Графики -->
            <TabItem Header="{DynamicResource FemCsfeaTabCharts}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <helpers:FemLoadFactorCanvas Grid.Row="0" x:Name="lambdaCanvas"
                        XAxisLabel="{DynamicResource FemCsfeaStepAxis}" YAxisLabel="{DynamicResource FemCsfeaLambdaAxis}"/>
                    <helpers:FemLoadFactorCanvas Grid.Row="1" x:Name="controlCanvas" Margin="0,4,0,0"
                        XAxisLabel="{Binding ControlAxisLabel}" YAxisLabel="{DynamicResource FemCsfeaLambdaAxis}"
                        Visibility="{Binding HasControlChart, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </TabItem>

            <!-- Журнал -->
            <TabItem Header="{DynamicResource FemCsfeaTabJournal}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" x:Name="stepsGrid" ItemsSource="{Binding StepRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                              SelectionChanged="StepsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColN}" Binding="{Binding N}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColStage}" Binding="{Binding Stage}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColLambda}" Binding="{Binding LoadFactor, StringFormat=0.####}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColPlanned}" Binding="{Binding Planned}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColConverged}" Binding="{Binding Converged}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColIterations}" Binding="{Binding Iterations}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColResidual}" Binding="{Binding Residual}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColControl}" Binding="{Binding Control}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColFields}" Binding="{Binding Fields}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="{DynamicResource FemCsfeaReport}" Margin="6,6,6,2" FontWeight="Bold"/>
                    <TextBox Grid.Row="2" x:Name="reportBox" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="6,0,6,6"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource FemResultStep}" VerticalAlignment="Center"/>
                <Slider Width="260" Margin="8,0" Minimum="0" Maximum="{Binding MaxStepIndex}"
                        Value="{Binding SelectedStepIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentStepLabel}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasFieldsNote, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding FieldsNote}" Foreground="DarkOrange" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Content="{DynamicResource FemCsfeaGoToFields}" Command="{Binding GoToFieldsStepCommand}"
                        Padding="8,2" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
