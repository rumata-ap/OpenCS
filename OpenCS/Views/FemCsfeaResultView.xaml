<UserControl x:Class="OpenCS.Views.FemCsfeaResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:OpenCS.Views.Helpers"
             xmlns:u="clr-namespace:OpenCS.Utilites"
             xmlns:conv="clr-namespace:OpenCS.Converters"
             xmlns:local="clr-namespace:OpenCS.Views"
             Language="ru-RU">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToCollapsedVisibilityConverter x:Key="NullToCollapsed"/>
        <u:NToKNConvert x:Key="NToKN"/>
        <!-- Таблицы полей шага: на больших схемах — десятки тысяч строк, только виртуализированно -->
        <Style x:Key="FieldGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="6,4">
            <Button DockPanel.Dock="Right" Content="{DynamicResource FemResultShowInSchema}"
                    ToolTip="{DynamicResource FemResultShowInSchemaTip}" Click="ShowInSchema_Click" Padding="8,2"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                <!-- Линейный на жёсткостях секущего: источник и его устаревание -->
                <TextBlock Text="{Binding StiffnessHeader}" TextWrapping="Wrap"
                           Visibility="{Binding StiffnessHeader, Converter={StaticResource NullToCollapsed}}"/>
                <TextBlock Text="{Binding StiffnessStaleNote}" Foreground="#B05A00" TextWrapping="Wrap"
                           Visibility="{Binding HasStiffnessStaleNote, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding BatchSummaryText}" TextWrapping="Wrap"
                           Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{DynamicResource FemCsfeaTablesHint}" Foreground="Gray" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource FemCsfeaEnvelopeRowsNote}" Foreground="#8A5A00" TextWrapping="Wrap"
                           Visibility="{Binding IsEnvelopeShown, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="tabs">
            <!-- Перемещения узлов показанного шага -->
            <TabItem Header="{DynamicResource FemResultTabDisp}">
                <DataGrid x:Name="nodeGrid" ItemsSource="{Binding NodeRows}" Style="{StaticResource FieldGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource FemColNode}" Binding="{Binding Node}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColUx}" Binding="{Binding Ux, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColUy}" Binding="{Binding Uy, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColUz}" Binding="{Binding Uz, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColRx}" Binding="{Binding Rx, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColRy}" Binding="{Binding Ry, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColRz}" Binding="{Binding Rz, StringFormat=G5}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Концевые силы стержней показанного шага -->
            <TabItem Header="{DynamicResource FemCsfeaTabBarForces}" Visibility="{Binding HasBeams, Converter={StaticResource BoolToVis}}">
                <DataGrid x:Name="beamGrid" ItemsSource="{Binding BeamRows}" Style="{StaticResource FieldGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColElem}" Binding="{Binding ElemTag}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceNi}" Binding="{Binding Ni, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceQyi}" Binding="{Binding Qyi, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceQzi}" Binding="{Binding Qzi, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceMxi}" Binding="{Binding Mxi, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceMyi}" Binding="{Binding Myi, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceMzi}" Binding="{Binding Mzi, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceNj}" Binding="{Binding Nj, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceQyj}" Binding="{Binding Qyj, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceQzj}" Binding="{Binding Qzj, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceMxj}" Binding="{Binding Mxj, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceMyj}" Binding="{Binding Myj, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemColForceMzj}" Binding="{Binding Mzj, Converter={StaticResource NToKN}, StringFormat=G5}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Усилия пластин показанного шага -->
            <TabItem Header="{DynamicResource FemCsfeaTabShellForces}" Visibility="{Binding HasShells, Converter={StaticResource BoolToVis}}">
                <DataGrid x:Name="shellGrid" ItemsSource="{Binding ShellRows}" Style="{StaticResource FieldGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColElem}" Binding="{Binding Elem}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColNx}" Binding="{Binding Nx, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColNy}" Binding="{Binding Ny, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColNxy}" Binding="{Binding Nxy, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColMx}" Binding="{Binding Mx, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColMy}" Binding="{Binding My, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColMxy}" Binding="{Binding Mxy, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColQx}" Binding="{Binding Qx, StringFormat=G5}"/>
                        <DataGridTextColumn Header="{DynamicResource FemCsfeaColQy}" Binding="{Binding Qy, StringFormat=G5}"/>
                        <DataGridTextColumn x:Name="shellStateColumn" Header="{DynamicResource FemCsfeaColState}" Binding="{Binding State}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Жёсткости КЭ показанного шага (секущие и отношения к начальным); у огибающих — нет -->
            <TabItem Header="{DynamicResource FemCsfeaTabStiffness}" Visibility="{Binding HasStiffness, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource FemCsfeaStiffnessShells}" FontWeight="SemiBold" Margin="6,2"
                               ToolTip="{DynamicResource FemCsfeaStiffnessShellsTip}"
                               Visibility="{Binding HasShells, Converter={StaticResource BoolToVis}}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ShellStiffnessRows}" Style="{StaticResource FieldGrid}"
                              Visibility="{Binding HasShells, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColElem}" Binding="{Binding Elem}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBendE1}" Binding="{Binding BendE1, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBendE2}" Binding="{Binding BendE2, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBendG}" Binding="{Binding BendG, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBendNu12}" Binding="{Binding BendNu12, StringFormat=G4}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBendNu21}" Binding="{Binding BendNu21, StringFormat=G4}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColMembE1}" Binding="{Binding MembE1, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColMembE2}" Binding="{Binding MembE2, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColMembG}" Binding="{Binding MembG, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColMembNu12}" Binding="{Binding MembNu12, StringFormat=G4}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColMembNu21}" Binding="{Binding MembNu21, StringFormat=G4}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBendE1Ratio}" Binding="{Binding BendE1Ratio, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBendE2Ratio}" Binding="{Binding BendE2Ratio, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColMembE1Ratio}" Binding="{Binding MembE1Ratio, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColMembE2Ratio}" Binding="{Binding MembE2Ratio, StringFormat=0.###}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{DynamicResource FemCsfeaStiffnessBars}" FontWeight="SemiBold" Margin="6,6,6,2"
                               Visibility="{Binding HasBeams, Converter={StaticResource BoolToVis}}"/>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding BarStiffnessRows}" Style="{StaticResource FieldGrid}"
                              Visibility="{Binding HasBeams, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColElem}" Binding="{Binding Elem}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColPoint}" Binding="{Binding Point}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColEA}" Binding="{Binding EA, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColEIy}" Binding="{Binding EIy, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColEIz}" Binding="{Binding EIz, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColGAy}" Binding="{Binding GAy, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColGAz}" Binding="{Binding GAz, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColEARatio}" Binding="{Binding EARatio, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColEIyRatio}" Binding="{Binding EIyRatio, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColEIzRatio}" Binding="{Binding EIzRatio, StringFormat=0.###}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Реакции опор показанного шага -->
            <TabItem Header="{DynamicResource FemCsfeaTabReactions}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ReactionSummaryText}" TextWrapping="Wrap" Margin="6,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource FemCsfeaNoReactions}" TextWrapping="Wrap" Margin="6,0,6,4"
                               Foreground="Gray" Visibility="{Binding ShowNoReactionsNote, Converter={StaticResource BoolToVis}}"/>
                    <!-- Линейные связи: реакция по граням (суммы и погонная Rz) -->
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasLineReactions, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource FemCsfeaLineReactions}" FontWeight="SemiBold" Margin="6,2"/>
                        <DataGrid ItemsSource="{Binding LineReactionRows}" Style="{StaticResource FieldGrid}" MaxHeight="180"
                                  ToolTip="{DynamicResource FemCsfeaLineReactionsHint}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource FemCsfeaColEdge}" Binding="{Binding Edge}"/>
                                <DataGridTextColumn Header="{DynamicResource FemCsfeaColEdgeLength}" Binding="{Binding Length, StringFormat=G5}"/>
                                <DataGridTextColumn Header="{DynamicResource FemCsfeaColRxF}" Binding="{Binding Rx, StringFormat=G5}"/>
                                <DataGridTextColumn Header="{DynamicResource FemCsfeaColRyF}" Binding="{Binding Ry, StringFormat=G5}"/>
                                <DataGridTextColumn Header="{DynamicResource FemCsfeaColRzF}" Binding="{Binding Rz, StringFormat=G5}"/>
                                <DataGridTextColumn Header="{DynamicResource FemCsfeaColQzMean}" Binding="{Binding QzMean, StringFormat=G5}"/>
                                <DataGridTextColumn Header="{DynamicResource FemCsfeaColQzMin}" Binding="{Binding QzMin, StringFormat=G5}"/>
                                <DataGridTextColumn Header="{DynamicResource FemCsfeaColQzMax}" Binding="{Binding QzMax, StringFormat=G5}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{DynamicResource FemCsfeaNodeReactions}" FontWeight="SemiBold" Margin="6,6,6,2"/>
                    </StackPanel>
                    <DataGrid x:Name="reactionGrid" ItemsSource="{Binding ReactionRows}" Style="{StaticResource FieldGrid}" ToolTip="{DynamicResource FemCsfeaReactionsHint}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource FemColNode}" Binding="{Binding Node}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColRxF}" Binding="{Binding Rx, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColRyF}" Binding="{Binding Ry, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColRzF}" Binding="{Binding Rz, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColMxR}" Binding="{Binding Mx, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColMyR}" Binding="{Binding My, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColMzR}" Binding="{Binding Mz, StringFormat=G5}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColSupportKind}" Binding="{Binding Kind}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Несовершенства EN 1993-1-1 5.3 варианта (спека 5.5): крен, погиби, max|u₀|, α_cr -->
            <TabItem Header="{DynamicResource FemCsfeaTabImperfections}" Visibility="{Binding HasImperfections, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ImperfectionSummaryText}" TextWrapping="Wrap" Margin="6,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource FemImperfectionShowHint}" TextWrapping="Wrap" Margin="6,0,6,4"
                               Foreground="Gray"/>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource FemImperfectionSwayTable}" FontWeight="SemiBold" Margin="6,2"/>
                    <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding ImperfectionSwayRows}" Style="{StaticResource FieldGrid}" MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColName}" Binding="{Binding Label}"/>
                            <DataGridTextColumn Header="φ" Binding="{Binding Phi}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColAngle}" Binding="{Binding Angle}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColH}" Binding="{Binding H}"/>
                            <DataGridTextColumn Header="α_h" Binding="{Binding AlphaH}"/>
                            <DataGridTextColumn Header="m" Binding="{Binding M}"/>
                            <DataGridTextColumn Header="α_m" Binding="{Binding AlphaM}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColMHint}" Binding="{Binding MHint}"/>
                            <DataGridTextColumn Header="H_Ed/V_Ed" Binding="{Binding HOverV}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColSource}" Binding="{Binding Source}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource FemImperfectionModeTable}" FontWeight="SemiBold" Margin="6,6,6,2"
                               Visibility="{Binding HasImperfectionModes, Converter={StaticResource BoolToVis}}"/>
                    <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding ImperfectionModeRows}" Style="{StaticResource FieldGrid}" MaxHeight="160"
                              Visibility="{Binding HasImperfectionModes, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColName}" Binding="{Binding Label}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColAnalysis}" Binding="{Binding Analysis}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColCase}" Binding="{Binding Case}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColMode}" Binding="{Binding Mode}"/>
                            <DataGridTextColumn Header="λ" Binding="{Binding Lambda}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColAmplitude}" Binding="{Binding AmplitudeMm}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaDetailColSource}" Binding="{Binding Source}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource FemImperfectionWallBowTable}" FontWeight="SemiBold" Margin="6,6,6,2"
                               Visibility="{Binding HasImperfectionWallBows, Converter={StaticResource BoolToVis}}"/>
                    <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding ImperfectionWallBowRows}" Style="{StaticResource FieldGrid}" MaxHeight="160"
                              Visibility="{Binding HasImperfectionWallBows, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColName}" Binding="{Binding Label}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColTier}" Binding="{Binding Tier}"/>
                            <DataGridTextColumn Header="h_яр, м" Binding="{Binding HeightM}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColThickness}" Binding="{Binding ThicknessMm}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColE0}" Binding="{Binding E0Mm}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColSign}" Binding="{Binding Sign}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColSource}" Binding="{Binding Source}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource FemImperfectionBowTable}" FontWeight="SemiBold" Margin="6,6,6,2"/>
                    <DataGrid ItemsSource="{Binding ImperfectionBowRows}" Style="{StaticResource FieldGrid}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding E0Mm}" Value="0">
                                        <Setter Property="Foreground" Value="Gray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColName}" Binding="{Binding Label}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColLength}" Binding="{Binding Length}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColPlane}" Binding="{Binding Plane}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColCurve}" Binding="{Binding Curve}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColE0}" Binding="{Binding E0Mm}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColNEd}" Binding="{Binding NEd}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColNcr}" Binding="{Binding Ncr}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColActive}" Binding="{Binding Active}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColActiveReason}" Binding="{Binding ActiveReason}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColSign}" Binding="{Binding Sign}"/>
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColSignSource}" Binding="{Binding SignSource}"/>
                            <!-- Длинный ход выбора кривой и e₀ — последним: не вытесняет «Учтена», «Почему» и знак за край -->
                            <DataGridTextColumn Header="{DynamicResource FemImperfectionColE0Source}" Binding="{Binding E0Source}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Графики -->
            <TabItem x:Name="chartsTab" Header="{DynamicResource FemCsfeaTabCharts}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <helpers:FemLoadFactorCanvas Grid.Row="0" x:Name="lambdaCanvas"
                        XAxisLabel="{DynamicResource FemCsfeaStepAxis}" YAxisLabel="{DynamicResource FemCsfeaLambdaAxis}"/>
                    <helpers:FemLoadFactorCanvas Grid.Row="1" x:Name="controlCanvas" Margin="0,4,0,0"
                        XAxisLabel="{Binding ControlAxisLabel}" YAxisLabel="{DynamicResource FemCsfeaLambdaAxis}"
                        Visibility="{Binding HasControlChart, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </TabItem>

            <!-- Сводка пакета: итог каждого варианта; двойной щелчок — показать вариант -->
            <TabItem x:Name="batchTab" Header="{DynamicResource FemCsfeaTabBatch}" Visibility="Collapsed">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Top" Margin="6,4" Content="{DynamicResource FemCsfeaBatchOnlyProblems}"
                              IsChecked="{Binding BatchOnlyProblems}"/>
                    <DataGrid x:Name="batchGrid" ItemsSource="{Binding VisibleBatchRows}" Style="{StaticResource FieldGrid}"
                              SelectionMode="Single" MouseDoubleClick="BatchGrid_MouseDoubleClick" ToolTip="{DynamicResource FemCsfeaBatchGridTip}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem helpers:CommandIcons.Header="FemCsfeaBatchShowVariant" Click="BatchShowVariant_Click"/>
                                <MenuItem helpers:CommandIcons.Header="FemCsfeaBatchNewFromProblems" Click="BatchNewFromProblems_Click"
                                          IsEnabled="{Binding CanNewBatchFromProblems}"/>
                                <MenuItem helpers:CommandIcons.Header="FemCsfeaLinearOnStiffness" Click="BatchLinearOnStiffness_Click"
                                          Visibility="{Binding CanLinearOnStiffness, Converter={StaticResource BoolToVis}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                        <Setter Property="Foreground" Value="#B05A00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColN}" Binding="{Binding N}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBatchType}" Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBatchName}" Binding="{Binding Tag}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColLambda}" Binding="{Binding LoadFactor, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBatchState}" Binding="{Binding State}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBatchSteps}" Binding="{Binding Steps}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColIterations}" Binding="{Binding Iterations}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBatchTime}" Binding="{Binding ElapsedSeconds, StringFormat=0.#}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColControl}" Binding="{Binding Control, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColReactionZ}" Binding="{Binding ReactionZ, StringFormat=0.###}"/>
                            <DataGridTextColumn x:Name="batchLongColumn" Header="{DynamicResource FemCsfeaColBatchLong}" Binding="{Binding LongPart}"/>
                            <DataGridTextColumn x:Name="batchLongNLColumn" Header="{DynamicResource FemCsfeaColBatchLongNL}" Binding="{Binding LongDeflection}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColBatchReason}" Binding="{Binding Reason}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Журнал -->
            <TabItem x:Name="journalTab" Header="{DynamicResource FemCsfeaTabJournal}">
                <Grid x:Name="journalGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" x:Name="stepsGrid" ItemsSource="{Binding StepRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                              SelectionChanged="StepsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColN}" Binding="{Binding N}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColStage}" Binding="{Binding Stage}"/>
                            <DataGridTextColumn x:Name="lambdaColumn" Header="{DynamicResource FemCsfeaColLambda}" Binding="{Binding LoadFactor, StringFormat=0.####}"/>
                            <DataGridTextColumn x:Name="plannedColumn" Header="{DynamicResource FemCsfeaColPlanned}" Binding="{Binding Planned}"/>
                            <DataGridTextColumn x:Name="convergedColumn" Header="{DynamicResource FemCsfeaColConverged}" Binding="{Binding Converged}"/>
                            <DataGridTextColumn x:Name="iterationsColumn" Header="{DynamicResource FemCsfeaColIterations}" Binding="{Binding Iterations}"/>
                            <DataGridTextColumn x:Name="residualColumn" Header="{DynamicResource FemCsfeaColResidual}" Binding="{Binding Residual}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColControl}" Binding="{Binding Control}"/>
                            <DataGridTextColumn x:Name="fieldsColumn" Header="{DynamicResource FemCsfeaColFields}" Binding="{Binding Fields}"/>
                            <DataGridTextColumn Header="{DynamicResource FemCsfeaColReactionZ}" Binding="{Binding ReactionZ}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="{DynamicResource FemCsfeaReport}" Margin="6,6,6,2" FontWeight="Bold"/>
                    <TextBox Grid.Row="2" x:Name="reportBox" IsReadOnly="True" TextWrapping="Wrap" Height="NaN"
                             VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                             VerticalScrollBarVisibility="Auto" Margin="6,0,6,6"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="4">
            <!-- Пакет: не дошедшие до предела λ и не посчитанные варианты -->
            <local:FemCsfeaBatchProblemBar Margin="0,0,0,4"/>
            <!-- Линейный расчёт — загружения и комбинации схемы (суперпозиция) одним списком -->
            <StackPanel x:Name="casePanel" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
                <local:FemCsfeaCaseSelector/>
                <TextBlock Text="{Binding CurrentStepLabel}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="stepCaption" Text="{DynamicResource FemResultStep}" VerticalAlignment="Center"/>
                <Slider x:Name="stepSlider" Width="260" Margin="8,0" Minimum="0" Maximum="{Binding MaxStepIndex}"
                        Value="{Binding SelectedStepIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                <TextBlock x:Name="stepLabel" Text="{Binding CurrentStepLabel}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Button Content="{DynamicResource FemCsfeaCreateForceSets}" Command="{Binding CreateForceSetsCommand}"
                        ToolTip="{DynamicResource FemCsfeaCreateForceSetsTip}" Padding="8,2" Margin="12,0,0,0"/>
                <Button Content="{DynamicResource FemCsfeaLoadCaseForceSets}" Command="{Binding CreateLoadCaseForceSetsCommand}"
                        ToolTip="{DynamicResource FemCsfeaLoadCaseForceSetsTip}" Padding="8,2" Margin="6,0,0,0"
                        Visibility="{Binding CanCreateLoadCaseForceSets, Converter={StaticResource BoolToVis}}"/>
                <Button Content="{DynamicResource FemCsfeaBatchForceSets}" Command="{Binding CreateBatchForceSetsCommand}"
                        ToolTip="{DynamicResource FemCsfeaBatchForceSetsTip}" Padding="8,2" Margin="6,0,0,0"
                        Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}"/>
                <Button Content="{DynamicResource FemCsfeaLinearOnStiffness}" Command="{Binding LinearOnStiffnessCommand}"
                        ToolTip="{Binding LinearOnStiffnessTip}" ToolTipService.ShowOnDisabled="True" Padding="8,2" Margin="6,0,0,0"
                        Visibility="{Binding CanLinearOnStiffness, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasFieldsNote, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding FieldsNote}" Foreground="DarkOrange" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Content="{DynamicResource FemCsfeaGoToFields}" Command="{Binding GoToFieldsStepCommand}"
                        Padding="8,2" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
