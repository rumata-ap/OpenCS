<UserControl x:Class="OpenCS.Views.RebarGroupEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenCS.Views"
             xmlns:vm="clr-namespace:OpenCS.ViewModels">

   <Grid>
      <Grid.ColumnDefinitions>
         <ColumnDefinition Width="240" MinWidth="160"/>
         <ColumnDefinition Width="4"/>
         <ColumnDefinition Width="*"   MinWidth="100"/>
         <ColumnDefinition Width="4"/>
         <ColumnDefinition Width="280" MinWidth="265"/>
      </Grid.ColumnDefinitions>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>

      <!-- Левая панель -->
         <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6">

            <!-- Тег и кнопки -->
            <TextBlock Text="{DynamicResource RgGroupTag}" Margin="0,0,0,2"/>
            <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,4"/>
            <Button Content="{DynamicResource Save}"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,6" Padding="8,3"/>

            <Separator Margin="0,0,0,6"/>

            <!-- Стратегия -->
            <GroupBox Header="{DynamicResource RgStrategyGroup}" Margin="0,0,0,6">
               <StackPanel Margin="4">
                  <RadioButton Content="{DynamicResource RgStrategyRegion}"
                               IsChecked="{Binding StrategyFromRegion}"
                               Margin="0,0,0,2"/>
                  <RadioButton Content="{DynamicResource RgStrategyContour}"
                               IsChecked="{Binding StrategyFromContour}"
                               Margin="0,0,0,2"/>
                  <RadioButton Content="{DynamicResource RgStrategyFree}"
                               IsChecked="{Binding StrategyBare}"
                               Margin="0,0,0,2"/>
                  <RadioButton Content="{DynamicResource RgStrategyFromSet}"
                               IsChecked="{Binding StrategyFromCircleSet}"/>
               </StackPanel>
            </GroupBox>

            <!-- Опора (скрыта при Bare) -->
            <StackPanel Visibility="{Binding HasReference, Converter={StaticResource BoolToVisibility}}">
               <TextBlock Text="{DynamicResource RgReference}" Margin="0,0,0,2"/>
               <ComboBox ItemsSource="{Binding AvailableRegions}"
                         SelectedItem="{Binding SelectedRegion}"
                         DisplayMemberPath="Tag"
                         Margin="0,0,0,4"
                         Visibility="{Binding StrategyFromRegion, Converter={StaticResource BoolToVisibility}}"/>
               <ComboBox ItemsSource="{Binding AvailableContours}"
                         SelectedItem="{Binding SelectedContour}"
                         DisplayMemberPath="Tag"
                         Margin="0,0,0,4"
                         Visibility="{Binding StrategyFromContour, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Импорт из набора окружностей (видим только при FromCircleSet) -->
            <StackPanel Visibility="{Binding StrategyFromCircleSet, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,6">
               <TextBlock Text="{DynamicResource RgCircleSetLabel}" Margin="0,0,0,2"/>
               <ComboBox ItemsSource="{Binding AvailableGeometrySets}"
                         SelectedItem="{Binding SelectedGeometrySet}"
                         Margin="0,0,0,4"/>
               <Button Content="{DynamicResource RgImportFromSet}"
                       Command="{Binding ImportFromCircleSetCommand}"
                       Padding="4,2"/>
            </StackPanel>

            <!-- Линия защитного слоя (скрыта при Bare) -->
            <StackPanel Visibility="{Binding HasReference, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,6">
               <StackPanel Margin="0,0,0,4">
                  <TextBlock Text="{DynamicResource RgCoverOffset}" Margin="0,0,0,2"/>
                  <TextBox Text="{Binding GlobalOffsetMm, StringFormat='{}{0:F1}',
                                          UpdateSourceTrigger=LostFocus}"/>
                  <TextBlock Text="{DynamicResource RgCoverOffsetHelp}"
                             TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>
               </StackPanel>
               <StackPanel Margin="0,0,0,4">
                  <TextBlock Text="{DynamicResource RgOffsetStep}" Margin="0,0,0,2"/>
                  <TextBox Text="{Binding OffsetStepMm, StringFormat='{}{0:F1}',
                                          UpdateSourceTrigger=LostFocus}"/>
                  <TextBlock Text="{DynamicResource RgOffsetStepHelp}"
                             TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>
               </StackPanel>
               <Button Content="{DynamicResource RgResetOffsets}"
                       Command="{Binding ResetAllOffsetsCommand}"
                       Padding="4,2"/>
            </StackPanel>

            <Separator Margin="0,0,0,6"/>

            <!-- Диаметр активного стержня -->
               <DockPanel Margin="0,0,0,6">
                  <TextBlock Text="{DynamicResource RgBarDiameter}"
                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <TextBlock Text="{DynamicResource RgBarDiameterUnit}"
                             DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                  <TextBox Text="{Binding ActiveDiameterMm, StringFormat='{}{0:F1}',
                               UpdateSourceTrigger=PropertyChanged}"/>
               </DockPanel>

            <Separator Margin="0,0,0,6"/>

            <!-- Заполнение -->
            <GroupBox Header="{DynamicResource RgFillMode}" Margin="0,0,0,6">
               <StackPanel Margin="4">
                  <DockPanel Margin="0,0,0,4">
                     <TextBlock Text="{DynamicResource RgFillN}"
                                VerticalAlignment="Center" Margin="0,0,6,0"/>
                     <TextBox Text="{Binding FillCount, UpdateSourceTrigger=PropertyChanged}"
                              Width="40"/>
                  </DockPanel>
                  <RadioButton Content="{DynamicResource RgFillStraight}"
                               IsChecked="{Binding FillUseArc, Converter={StaticResource InverseBool}}"
                               Margin="0,0,0,2"/>
                  <RadioButton Content="{DynamicResource RgFillArc}"
                               IsChecked="{Binding FillUseArc}"
                               Margin="0,0,0,2"/>
                  <StackPanel Visibility="{Binding FillUseArc, Converter={StaticResource BoolToVisibility}}"
                              Margin="0,0,0,4">
                     <TextBlock Text="{DynamicResource RgFillArcR}"
                                Margin="0,0,0,2"/>
                     <TextBox Text="{Binding FillArcRadiusMm, StringFormat='{}{0:F1}',
                                    UpdateSourceTrigger=PropertyChanged}"/>
                     <TextBlock Text="{DynamicResource RgFillArcRHelp}"
                                TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>
                  </StackPanel>
                  <ToggleButton Content="{DynamicResource RgFillMode}"
                                IsChecked="{Binding FillMode}"
                                Padding="4,2"/>
               </StackPanel>
            </GroupBox>

            <Separator Margin="0,0,0,6"/>

            <!-- Материал -->
            <TextBlock Text="{DynamicResource RgMaterial}" Margin="0,0,0,2"/>
            <ComboBox ItemsSource="{Binding AvailableMaterials}"
                      SelectedItem="{Binding SelectedMaterial}"
                      DisplayMemberPath="Tag"
                      Margin="0,0,0,6"/>

            <!-- Преднапряжение -->
            <GroupBox Header="{DynamicResource Prestress}" Margin="0,0,0,6">
               <StackPanel Margin="4">
                  <TextBlock Text="{DynamicResource SigSpLabel}" Margin="0,0,0,2"/>
                  <TextBox Text="{Binding SigSp, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                           Margin="0,0,0,6"/>
                  <TextBlock Text="{DynamicResource GammaSpLabel}" Margin="0,0,0,2"/>
                  <ComboBox SelectedIndex="{Binding GammaSpIndex}" Margin="0,0,0,6">
                     <ComboBoxItem Content="{DynamicResource GammaSp_1_0}"/>
                     <ComboBoxItem Content="{DynamicResource GammaSp_0_9}"/>
                     <ComboBoxItem Content="{DynamicResource GammaSp_1_1}"/>
                  </ComboBox>
                  <TextBlock>
                     <Run Text="{DynamicResource EpsSpLabel}"/>
                     <Run Text="{Binding EpsSp, Mode=OneWay}"/>
                  </TextBlock>
               </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal">
               <Button Content="{DynamicResource RgTranslate}"
                       Command="{Binding TranslateCommand}"
                       Padding="8,3" Margin="0,0,6,0"/>
               <Button Content="{DynamicResource RgProperties}"
                       Command="{Binding ShowPropertiesCommand}"
                       Padding="8,3"/>
            </StackPanel>

         </StackPanel>
      </ScrollViewer>

      <!-- Холст -->
      <local:RebarGroupCanvas x:Name="Canvas" Grid.Column="2" Margin="4"/>

      <!-- Правая панель -->
      <Grid Grid.Column="4">
         <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
         </Grid.RowDefinitions>

         <!-- Таблица рёбер (скрыта при стратегии Bare) -->
         <GroupBox Grid.Row="0"
                   Header="{DynamicResource RgEdgesTable}"
                   Margin="4,4,4,2"
                   Visibility="{Binding HasReference, Converter={StaticResource BoolToVisibility}}">
            <Grid>
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
               </Grid.RowDefinitions>
               <TextBlock Grid.Row="0" Text="{DynamicResource RgEdgesTableHelp}"
                          TextWrapping="Wrap" Margin="4,2,4,4"/>
               <Grid Grid.Row="1" Margin="2,0,2,2">
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="28"/>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="56"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{DynamicResource RgNumberHeader}"
                             TextAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{DynamicResource RgEdgeOffsetHeader}"
                             TextAlignment="Center"/>
               </Grid>
               <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Edges}">
                     <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EdgeItem}">
                           <Grid Margin="2">
                              <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="28"/>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="56"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="{Binding Index}"
                                         VerticalAlignment="Center" TextAlignment="Center"/>
                              <TextBox Grid.Column="1"
                                       Text="{Binding OffsetMm, StringFormat='{}{0:F1}',
                                                      UpdateSourceTrigger=LostFocus}"
                                       GotKeyboardFocus="EdgeOffset_GotKeyboardFocus"
                                       LostKeyboardFocus="EdgeOffset_LostKeyboardFocus"
                                       VerticalAlignment="Center" Margin="1,0"/>
                              <StackPanel Grid.Column="2" Orientation="Horizontal"
                                          HorizontalAlignment="Center">
                                 <Button Content="{DynamicResource RgIncreaseOffsetSymbol}"
                                         ToolTip="{DynamicResource RgIncreaseOffsetToolTip}"
                                         Width="24" Height="20" Padding="0"
                                         Click="EdgePlus_Click" Tag="{Binding}"/>
                                 <Button Content="{DynamicResource RgDecreaseOffsetSymbol}"
                                         ToolTip="{DynamicResource RgDecreaseOffsetToolTip}"
                                         Width="24" Height="20" Padding="0"
                                         Click="EdgeMinus_Click" Tag="{Binding}"/>
                              </StackPanel>
                           </Grid>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </ScrollViewer>
            </Grid>
         </GroupBox>

         <!-- Таблица стержней -->
         <GroupBox Grid.Row="1" Header="{DynamicResource RgBarsTable}" Margin="4,2,4,4">
            <Grid>
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
               </Grid.RowDefinitions>
               <TextBlock Grid.Row="0" Text="{DynamicResource RgBarsTableHelp}"
                          TextWrapping="Wrap" Margin="4,2,4,4"/>
               <Grid Grid.Row="1" Margin="1,0,1,2">
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="28"/>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="40"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{DynamicResource RgNumberHeader}"
                             TextAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{DynamicResource RgBarXHeader}"
                             TextAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{DynamicResource RgBarYHeader}"
                             TextAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{DynamicResource RgBarDiameterHeader}"
                             TextAlignment="Center"/>
               </Grid>
               <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Bars}">
                     <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BarItem}">
                           <Grid Margin="1">
                              <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="28"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="40"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="{Binding Index}"
                                         VerticalAlignment="Center" TextAlignment="Center"/>
                              <TextBox Grid.Column="1"
                                       Text="{Binding XMm, StringFormat='{}{0:F1}',
                                                      UpdateSourceTrigger=LostFocus}"
                                       GotKeyboardFocus="BarField_GotKeyboardFocus"
                                       LostKeyboardFocus="BarField_LostKeyboardFocus"
                                       Margin="1,0"/>
                              <TextBox Grid.Column="2"
                                       Text="{Binding YMm, StringFormat='{}{0:F1}',
                                                      UpdateSourceTrigger=LostFocus}"
                                       GotKeyboardFocus="BarField_GotKeyboardFocus"
                                       LostKeyboardFocus="BarField_LostKeyboardFocus"
                                       Margin="1,0"/>
                              <TextBox Grid.Column="3"
                                       Text="{Binding DiameterMm, StringFormat='{}{0:F1}',
                                                      UpdateSourceTrigger=LostFocus}"
                                       GotKeyboardFocus="BarField_GotKeyboardFocus"
                                       LostKeyboardFocus="BarField_LostKeyboardFocus"
                                       Margin="1,0"/>
                              <Button Grid.Column="4"
                                      Content="{DynamicResource RgDeleteBarSymbol}"
                                      ToolTip="{DynamicResource RgDeleteBarToolTip}"
                                      Width="24" Height="18" Padding="0"
                                      HorizontalAlignment="Center"
                                      Command="{Binding DataContext.DeleteBarCommand,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                           </Grid>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </ScrollViewer>
            </Grid>
         </GroupBox>

      </Grid>
   </Grid>
</UserControl>
