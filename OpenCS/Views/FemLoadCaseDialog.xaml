<Window x:Class="OpenCS.Views.FemLoadCaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenCS.ViewModels"
        Title="{DynamicResource FemLoadCaseDialogTitle}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Атрибуты СП 20 — Sp20LoadAttributesVM (DataContext); имя и собственный вес — в коде окна. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock x:Name="originText" Foreground="Gray" Margin="0,0,0,6" Visibility="Collapsed"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource FemLoadCaseDialogName}" VerticalAlignment="Center"/>
            <TextBox x:Name="tagBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2"/>
            <TextBlock Grid.Row="1" Text="{DynamicResource FemLoadCaseDialogSp20Type}" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2"
                      ItemsSource="{x:Static vm:FemLoadsTabVM.Sp20Types}" SelectedValuePath="Key" DisplayMemberPath="Label"
                      SelectedValue="{Binding Kind}"/>
            <TextBlock Grid.Row="2" Text="{DynamicResource FemLoadCaseDialogGroup}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" Text="{Binding Group}"
                     ToolTip="{DynamicResource FemLoadCaseDialogGroupTip}"/>

            <TextBlock Grid.Row="3" Text="{DynamicResource FemLoadCaseGammaUnfav}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding GammaText}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Hint}" Text="{Binding GammaHint}"/>

            <TextBlock Grid.Row="4" Text="{DynamicResource FemLoadCaseGammaFav}" VerticalAlignment="Center"
                       ToolTip="{DynamicResource Sp20AttrReducedGammaTip}"
                       Visibility="{Binding IsPermanent, Converter={StaticResource BoolToVis}}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" Text="{Binding ReducedGammaText}"
                     ToolTip="{DynamicResource Sp20AttrReducedGammaTip}"
                     Visibility="{Binding IsPermanent, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Hint}" Text="{Binding ReducedGammaHint}"
                       Visibility="{Binding IsPermanent, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Grid.Row="5" Text="{DynamicResource Sp20AttrShareKind}" VerticalAlignment="Center"
                       Visibility="{Binding IsShortTerm, Converter={StaticResource BoolToVis}}"/>
            <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2"
                      ItemsSource="{x:Static vm:Sp20LoadAttributesVM.ShareKinds}" SelectedValuePath="Key" DisplayMemberPath="Label"
                      SelectedValue="{Binding ShareKindKey}" ToolTip="{DynamicResource Sp20AttrShareKindTip}"
                      Visibility="{Binding IsShortTerm, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Grid.Row="6" Text="{DynamicResource Sp20AttrShare}" VerticalAlignment="Center"
                       Visibility="{Binding IsShortTerm, Converter={StaticResource BoolToVis}}"/>
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,2" Text="{Binding ShareText}" ToolTip="{DynamicResource Sp20AttrShareTip}"
                     Visibility="{Binding IsShortTerm, Converter={StaticResource BoolToVis}}"/>

            <CheckBox x:Name="selfWeightCheck" Grid.Row="7" Content="{DynamicResource FemSelfWeightFactor}"
                      VerticalAlignment="Center" Checked="SelfWeight_Changed" Unchecked="SelfWeight_Changed"/>
            <TextBox x:Name="selfWeightBox" Grid.Row="7" Grid.Column="1" Margin="0,2"/>
        </Grid>
        <TextBlock Text="{DynamicResource FemLoadCaseDialogDefaultsHint}" Foreground="Gray" FontSize="11"
                   TextWrapping="Wrap" Margin="1,4,1,0"/>
        <TextBlock x:Name="errorText" Foreground="Crimson" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource OK}" IsDefault="True" Click="Ok_Click" Padding="20,4" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Cancel}" IsCancel="True" Padding="16,4"/>
        </StackPanel>
    </StackPanel>
</Window>
