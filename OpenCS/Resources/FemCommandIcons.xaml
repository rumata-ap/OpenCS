<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <!-- Иконки команд МКЭ-схемы: пункты контекстных меню и кнопки панелей. Сетка 16×16, палитра FemIconPalette.xaml,
        стиль — как у иконок дерева (FemTreeIcons.xaml). Одно действие — одна иконка во всех местах.
        Значки-бейджи в правом нижнем углу (CmdBadge_*): «+» — создать, «−» — убрать, «↓» — загрузить из
        внешнего источника, «⟳» — обновить, «×» — снять. Ключи: CmdIcon_<Действие>. -->
   <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="FemIconPalette.xaml"/>
   </ResourceDictionary.MergedDictionaries>

   <!-- ============================== Бейджи ============================== -->

   <DrawingGroup x:Key="CmdBadge_Plus">
      <GeometryDrawing Brush="{StaticResource FemIconGreen}" Geometry="M8.1,12 a3.9,3.9 0 1,0 7.8,0 a3.9,3.9 0 1,0 -7.8,0 Z">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M12,9.9 V14.1 M9.9,12 H14.1">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.4" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
   </DrawingGroup>

   <DrawingGroup x:Key="CmdBadge_Minus">
      <GeometryDrawing Brush="{StaticResource FemIconRed}" Geometry="M8.1,12 a3.9,3.9 0 1,0 7.8,0 a3.9,3.9 0 1,0 -7.8,0 Z">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M9.9,12 H14.1">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.4" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
   </DrawingGroup>

   <DrawingGroup x:Key="CmdBadge_Cross">
      <GeometryDrawing Brush="{StaticResource FemIconRed}" Geometry="M8.1,12 a3.9,3.9 0 1,0 7.8,0 a3.9,3.9 0 1,0 -7.8,0 Z">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M10.5,10.5 L13.5,13.5 M13.5,10.5 L10.5,13.5">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.3" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
   </DrawingGroup>

   <DrawingGroup x:Key="CmdBadge_Import">
      <GeometryDrawing Brush="{StaticResource FemIconBlueDark}" Geometry="M8.1,12 a3.9,3.9 0 1,0 7.8,0 a3.9,3.9 0 1,0 -7.8,0 Z">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M12,9.6 V14 M10.2,12.3 L12,14.1 L13.8,12.3">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
   </DrawingGroup>

   <DrawingGroup x:Key="CmdBadge_Refresh">
      <GeometryDrawing Brush="{StaticResource FemIconGreen}" Geometry="M8.1,12 a3.9,3.9 0 1,0 7.8,0 a3.9,3.9 0 1,0 -7.8,0 Z">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M13.9,12.4 A1.95,1.95 0 1,1 13.3,10.6">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Brush="White" Geometry="M14.4,9.2 L14.2,11.6 L11.9,10.9 Z"/>
   </DrawingGroup>

   <DrawingGroup x:Key="CmdBadge_In">
      <GeometryDrawing Brush="{StaticResource FemIconGreen}" Geometry="M8.1,12 a3.9,3.9 0 1,0 7.8,0 a3.9,3.9 0 1,0 -7.8,0 Z">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M14,10 L10.6,13.4 M10.4,11 V13.6 H13">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
   </DrawingGroup>

   <DrawingGroup x:Key="CmdBadge_Auto">
      <GeometryDrawing Brush="{StaticResource FemIconIndigo}" Geometry="M8.1,12 a3.9,3.9 0 1,0 7.8,0 a3.9,3.9 0 1,0 -7.8,0 Z">
         <GeometryDrawing.Pen><Pen Brush="White" Thickness="1"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Brush="White" Geometry="M12.7,9.2 L10.5,12.5 H12 L11.3,14.8 L13.6,11.4 H12.1 Z"/>
   </DrawingGroup>

   <!-- Общие фигуры, из которых собираются иконки с бейджем. -->

   <!-- Группа: оранжевая пунктирная рамка выбора с тремя объектами. -->
   <DrawingGroup x:Key="CmdShape_Group">
      <GeometryDrawing Brush="{StaticResource FemIconOrangeLight}" Geometry="M1.5,2.5 H13.5 V12.5 H1.5 Z">
         <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconOrange}" Thickness="1.2" DashStyle="{x:Static DashStyles.Dash}" LineJoin="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M3.8,10 L6.5,5 M6.5,5 L10.8,5">
         <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Brush="White" Geometry="M2.6,10 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M5.3,5 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M9.6,5 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z">
         <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlueDark}" Thickness="1"/></GeometryDrawing.Pen>
      </GeometryDrawing>
   </DrawingGroup>

   <!-- Опора: узел на шарнирно-неподвижной опоре. -->
   <DrawingGroup x:Key="CmdShape_Support">
      <GeometryDrawing Brush="{StaticResource FemIconBlueLight}" Geometry="M7,5.5 L11.5,11.5 H2.5 Z">
         <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M1,13 H13 M2.5,15 L4,13 M5.5,15 L7,13 M8.5,15 L10,13 M11.5,15 L13,13">
         <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Brush="White" Geometry="M5,4 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z">
         <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlueDark}" Thickness="1.2"/></GeometryDrawing.Pen>
      </GeometryDrawing>
   </DrawingGroup>

   <!-- Распределённая нагрузка на балку (как «Усилия схемы» в дереве). -->
   <DrawingGroup x:Key="CmdShape_MemberLoad">
      <GeometryDrawing Geometry="M1,14 H15">
         <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M1.5,1.5 H14.5 M3,1.5 V8.5 M8,1.5 V8.5 M13,1.5 V8.5">
         <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconRed}" Thickness="1.3" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Brush="{StaticResource FemIconRed}" Geometry="M1,8 H5 L3,12 Z M6,8 H10 L8,12 Z M11,8 H15 L13,12 Z"/>
   </DrawingGroup>

   <!-- Двутавр. -->
   <GeometryDrawing x:Key="CmdShape_Section" Brush="{StaticResource FemIconBlue}"
                    Geometry="M2,1.5 H12 V4 H8.25 V11 H12 V13.5 H2 V11 H5.75 V4 H2 Z"/>

   <!-- Портальная рама КонЭ. -->
   <GeometryDrawing x:Key="CmdShape_Members" Brush="{StaticResource FemIconBlue}"
                    Geometry="M1,2 H13 V4.8 H1 Z M2,4.8 H4.4 V13.5 H2 Z M9.6,4.8 H12 V13.5 H9.6 Z"/>

   <!-- ============================== Общие действия ============================== -->

   <!-- Создать: зелёный круг с плюсом. -->
   <DrawingImage x:Key="CmdIcon_Add">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconGreen}" Geometry="M1.5,8 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0 Z"/>
            <GeometryDrawing Geometry="M8,4.5 V11.5 M4.5,8 H11.5">
               <GeometryDrawing.Pen><Pen Brush="White" Thickness="2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Изменить: карандаш. -->
   <DrawingImage x:Key="CmdIcon_Edit">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconOrange}" Geometry="M3.5,10.5 L10.5,3.5 L12.5,5.5 L5.5,12.5 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlueDark}" Geometry="M10.5,3.5 L12,2 L14,4 L12.5,5.5 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconOrangeLight}" Geometry="M3.5,10.5 L5.5,12.5 L2,14 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlueDark}" Geometry="M2,14 L2.6,12.6 L3.4,13.4 Z"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Свойства: лист со строками параметров. -->
   <DrawingImage x:Key="CmdIcon_Properties">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="White" Geometry="M2.5,1.5 H10.5 L13.5,4.5 V14.5 H2.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M10.5,1.5 V4.5 H13.5">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M4.5,6.5 H6 M7.5,6.5 H11.5 M4.5,9 H6 M7.5,9 H11.5 M4.5,11.5 H6 M7.5,11.5 H10">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.3" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Удалить: красный крест. -->
   <DrawingImage x:Key="CmdIcon_Delete">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Geometry="M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconRed}" Thickness="2.4" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Удалить все / выбранные: стопка листов и крест. -->
   <DrawingImage x:Key="CmdIcon_DeleteAll">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconGreyLight}" Geometry="M6.5,1.5 H14.5 V9.5 H6.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="White" Geometry="M4,4 H12 V12 H4 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M1.5,7.5 L8.5,14.5 M8.5,7.5 L1.5,14.5">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconRed}" Thickness="2.2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Переименовать: поле ввода с курсором. -->
   <DrawingImage x:Key="CmdIcon_Rename">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="White" Geometry="M1,4.5 H15 V11.5 H1 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M3,8 H8.5">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M11.5,2.5 V13.5 M10,2.5 H13 M10,13.5 H13">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlueDark}" Thickness="1.2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Дублировать: два листа. -->
   <DrawingImage x:Key="CmdIcon_Duplicate">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlueLight}" Geometry="M5.5,1.5 H14.5 V10.5 H5.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="White" Geometry="M1.5,5.5 H10.5 V14.5 H1.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M3.5,8.5 H8.5 M3.5,11 H7">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlueLight}" Thickness="1.2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Копировать со смещением: объект, его копия и зелёная стрелка. -->
   <DrawingImage x:Key="CmdIcon_Copy">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlueLight}" Geometry="M1,8.5 H7.5 V15 H1 Z M8.5,1 H15 V7.5 H8.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M5.2,10.8 L10.3,5.7">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGreen}" Thickness="1.5" StartLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconGreen}" Geometry="M11.6,4.4 L10.9,8.1 L7.9,5.1 Z"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Переместить: исходное положение пунктиром, новое — сплошное, синяя стрелка. -->
   <DrawingImage x:Key="CmdIcon_Move">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Geometry="M1,8.5 H7.5 V15 H1 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1.1" DashStyle="{x:Static DashStyles.Dash}"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconBlueLight}" Geometry="M8.5,1 H15 V7.5 H8.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M4.2,11.8 L10.3,5.7">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlueDark}" Thickness="1.5" StartLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconBlueDark}" Geometry="M11.6,4.4 L10.9,8.1 L7.9,5.1 Z"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Копировать в буфер (координаты): планшет с текстом. -->
   <DrawingImage x:Key="CmdIcon_Clipboard">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="White" Geometry="M2.5,2.5 H13.5 V15 H2.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1.1" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconGrey}" Geometry="M5.5,1 H10.5 V4 H5.5 Z"/>
            <GeometryDrawing Geometry="M5,7 H11 M5,9.5 H11 M5,12 H9">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Выделить: стрелка-курсор. -->
   <DrawingImage x:Key="CmdIcon_Select">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="White" Geometry="M3.5,1.5 V13 L6.4,10.2 L8.5,14.8 L10.4,13.9 L8.3,9.4 H12.3 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlueDark}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Снять выделение: пунктирная рамка выбора и крест. -->
   <DrawingImage x:Key="CmdIcon_ClearSelection">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlueLight}" Geometry="M1.5,1.5 H12.5 V11.5 H1.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.2" DashStyle="{x:Static DashStyles.Dash}"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <StaticResource ResourceKey="CmdBadge_Cross"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- ============================== Видимость ============================== -->

   <!-- Показать всё: глаз. -->
   <DrawingImage x:Key="CmdIcon_ShowAll">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="White" Geometry="M1,8 C3.5,3.2 12.5,3.2 15,8 C12.5,12.8 3.5,12.8 1,8 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlueDark}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconBlue}" Geometry="M5.5,8 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z"/>
            <GeometryDrawing Brush="White" Geometry="M7.6,7.2 a0.8,0.8 0 1,0 1.6,0 a0.8,0.8 0 1,0 -1.6,0 Z"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Скрыть: перечёркнутый глаз. -->
   <DrawingImage x:Key="CmdIcon_Hide">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="White" Geometry="M1,8 C3.5,3.2 12.5,3.2 15,8 C12.5,12.8 3.5,12.8 1,8 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconGrey}" Geometry="M5.5,8 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z"/>
            <GeometryDrawing Geometry="M2.5,13.5 L13.5,2.5">
               <GeometryDrawing.Pen><Pen Brush="White" Thickness="3.2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M2.5,13.5 L13.5,2.5">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconRed}" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Показать только: сплошной объект в пунктирной рамке пустого окружения. -->
   <DrawingImage x:Key="CmdIcon_ShowOnly">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Geometry="M1.5,1.5 H14.5 V14.5 H1.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1" DashStyle="{x:Static DashStyles.Dash}"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconBlue}" Geometry="M4.5,4.5 H11.5 V11.5 H4.5 Z"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Инвертировать видимость: квадрат, закрашенный по диагонали. -->
   <DrawingImage x:Key="CmdIcon_Invert">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlue}" Geometry="M1.5,1.5 H14.5 L1.5,14.5 Z"/>
            <GeometryDrawing Geometry="M1.5,1.5 H14.5 V14.5 H1.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Полупрозрачно: бледный объект в пунктирном контуре. -->
   <DrawingImage x:Key="CmdIcon_Ghost">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlueLight}" Geometry="M1.5,4.5 H11.5 V14.5 H1.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1" DashStyle="{x:Static DashStyles.Dash}"/></GeometryDrawing.Pen>
            </GeometryDrawing>
