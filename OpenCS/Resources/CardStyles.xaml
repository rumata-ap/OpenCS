<!--
   Группы длинных окон параметров — «карточки», как в окнах продавливания: тонкая рамка, светлый фон, полужирный
   заголовок, отступ между группами. Вложенная группа внутри карточки — без рамки и фона.
   Словарь подключается самим окном (MergedDictionaries), а не App.xaml: неявные стили действуют только там, где
   словарь подключён, а окна создаются и в тестах без Application.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <!-- Вложенная группа: только полужирный заголовок и небольшой отступ содержимого. -->
   <Style x:Key="CardSubGroupBox" TargetType="GroupBox">
      <Setter Property="Padding" Value="4,2,0,2"/>
      <Setter Property="Template">
         <Setter.Value>
            <ControlTemplate TargetType="GroupBox">
               <DockPanel>
                  <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" RecognizesAccessKey="True" Margin="0,4,0,2"
                                    TextElement.FontWeight="SemiBold" TextElement.Foreground="#374151"/>
                  <ContentPresenter Margin="{TemplateBinding Padding}"/>
               </DockPanel>
            </ControlTemplate>
         </Setter.Value>
      </Setter>
   </Style>

   <!-- Группа-карточка. Вложенные GroupBox внутри неё получают CardSubGroupBox. -->
   <Style x:Key="CardGroupBox" TargetType="GroupBox">
      <Style.Resources>
         <Style TargetType="GroupBox" BasedOn="{StaticResource CardSubGroupBox}"/>
      </Style.Resources>
      <Setter Property="Background" Value="#FAFBFC"/>
      <Setter Property="BorderBrush" Value="#D5DCE4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,2,8,8"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
         <Setter.Value>
            <ControlTemplate TargetType="GroupBox">
               <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                  <DockPanel>
                     <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" RecognizesAccessKey="True" Margin="8,5,8,3"
                                       TextElement.FontWeight="SemiBold" TextElement.Foreground="#1F2937"/>
                     <ContentPresenter Margin="{TemplateBinding Padding}"/>
                  </DockPanel>
               </Border>
            </ControlTemplate>
         </Setter.Value>
      </Setter>
   </Style>

   <!-- Вложенный экспандер внутри карточки — без рамки и фона. -->
   <Style x:Key="CardSubExpander" TargetType="Expander">
      <Setter Property="Padding" Value="4,2,2,2"/>
   </Style>

   <!-- Экспандер-карточка (как в окнах продавливания). Вложенные экспандеры получают CardSubExpander. -->
   <Style x:Key="CardExpander" TargetType="Expander">
      <Style.Resources>
         <Style TargetType="Expander" BasedOn="{StaticResource CardSubExpander}"/>
      </Style.Resources>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Padding" Value="8,4,6,6"/>
      <Setter Property="Background" Value="#FAFBFC"/>
      <Setter Property="BorderBrush" Value="#D5DCE4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HeaderTemplate">
         <Setter.Value>
            <DataTemplate>
               <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="#1F2937" Margin="2,1,0,1"/>
            </DataTemplate>
         </Setter.Value>
      </Setter>
   </Style>

   <!-- Неявные стили — действуют в окне, подключившем словарь. -->
   <Style TargetType="GroupBox" BasedOn="{StaticResource CardGroupBox}">
      <Style.Resources>
         <Style TargetType="GroupBox" BasedOn="{StaticResource CardSubGroupBox}"/>
      </Style.Resources>
   </Style>
   <Style TargetType="Expander" BasedOn="{StaticResource CardExpander}">
      <Style.Resources>
         <Style TargetType="Expander" BasedOn="{StaticResource CardSubExpander}"/>
      </Style.Resources>
   </Style>
</ResourceDictionary>
