      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconTealLight}" Geometry="M1.5,1.5 H14.5 V14.5 H1.5 Z"/>
            <GeometryDrawing Geometry="M1.5,1.5 H14.5 V14.5 H1.5 Z M5.83,1.5 V14.5 M10.17,1.5 V14.5 M1.5,5.83 H14.5 M1.5,10.17 H14.5">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconTeal}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Узлы сетки: узлы на линиях сетки. -->
