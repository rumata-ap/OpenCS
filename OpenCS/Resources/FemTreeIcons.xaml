               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Корень «Проверки»: планшет с отметкой. -->
   <DrawingImage x:Key="FemIcon_Checks">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="White" Geometry="M2.5,2.5 H13.5 V15 H2.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconIndigo}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconIndigo}" Geometry="M5.5,1 H10.5 V4 H5.5 Z"/>
