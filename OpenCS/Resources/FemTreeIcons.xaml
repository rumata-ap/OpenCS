<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <!-- Иконки дерева МКЭ. Все в сетке 16×16 (прозрачная подложка и обрезка задают одинаковый масштаб).
        Палитра: синий — конструктивная модель (схема, КонЭ), бирюзовый — расчётная сетка КЭ,
        оранжевый — группы (как подсветка групп и кБ в 3D), красный — нагрузки и усилия,
        индиго — проверки, зелёный — расчёты. -->

   <!-- Иконка перед подписью узла дерева. -->
   <Style x:Key="FemTreeIcon" TargetType="Image">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
   </Style>

   <SolidColorBrush x:Key="FemIconBlue"       Color="#2F6DB5"/>
   <SolidColorBrush x:Key="FemIconBlueLight"  Color="#B9D3F0"/>
   <SolidColorBrush x:Key="FemIconBlueDark"   Color="#1F4E85"/>
   <SolidColorBrush x:Key="FemIconTeal"       Color="#0F8B8D"/>
   <SolidColorBrush x:Key="FemIconTealLight"  Color="#CDEDEC"/>
   <SolidColorBrush x:Key="FemIconOrange"     Color="#E8870E"/>
   <SolidColorBrush x:Key="FemIconOrangeLight" Color="#FBD9A8"/>
   <SolidColorBrush x:Key="FemIconRed"        Color="#D9480F"/>
   <SolidColorBrush x:Key="FemIconIndigo"     Color="#4F46E5"/>
   <SolidColorBrush x:Key="FemIconGreen"      Color="#0E9F6E"/>
   <SolidColorBrush x:Key="FemIconGrey"       Color="#8A97A3"/>

   <!-- Схема: рама из стержней с узлами на опорной линии. -->
   <DrawingImage x:Key="FemIcon_Schema">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Geometry="M1,14.5 H15">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1.2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M2.5,14.5 V3 H13.5 V14.5 M2.5,8.75 H13.5 M8,3 V14.5">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.5" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="White"
                             Geometry="M1.3,3 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M6.8,3 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M12.3,3 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M1.3,8.75 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M6.8,8.75 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M12.3,8.75 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlueDark}" Thickness="1"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Корень «Расчётные схемы»: две рамы, одна за другой. -->
   <DrawingImage x:Key="FemIcon_Schemas">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Geometry="M5.5,10 V1.5 H15 V10 M10.75,5.75 H15">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlueLight}" Thickness="1.5" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="White" Geometry="M1.75,5.5 H10.75 V14.5 H1.75 Z"/>
            <GeometryDrawing Geometry="M1,14.5 H11.5">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1.2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M1.75,14.5 V5.5 H10.75 V14.5 M1.75,10 H10.75">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1.5" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="White"
                             Geometry="M0.65,5.5 a1.1,1.1 0 1,0 2.2,0 a1.1,1.1 0 1,0 -2.2,0 Z M9.65,5.5 a1.1,1.1 0 1,0 2.2,0 a1.1,1.1 0 1,0 -2.2,0 Z M0.65,10 a1.1,1.1 0 1,0 2.2,0 a1.1,1.1 0 1,0 -2.2,0 Z M9.65,10 a1.1,1.1 0 1,0 2.2,0 a1.1,1.1 0 1,0 -2.2,0 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlueDark}" Thickness="1"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Узлы конструктивной модели: три узла, связанные тонкими линиями. -->
