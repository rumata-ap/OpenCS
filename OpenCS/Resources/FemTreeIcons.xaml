   <!-- Проверки по эксплуатационной пригодности: балка с трещинами. -->
   <DrawingImage x:Key="FemIcon_ChecksSls">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconIndigo}" Geometry="M0.5,4 H15.5 V12.5 H0.5 Z"/>
