      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Geometry="M3,12.5 L8,3.5 L13,12.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconBlue}"
                             Geometry="M1,12.5 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z M6,3.5 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z M11,12.5 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Конструктивные элементы: портальная рама из «толстых» стержней. -->
   <DrawingImage x:Key="FemIcon_Members">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlue}"
                             Geometry="M1.5,2.5 H14.5 V5.5 H1.5 Z M2.5,5.5 H5 V14.5 H2.5 Z M11,5.5 H13.5 V14.5 H11 Z"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Стержни (КонЭ): наклонный стержень. -->
   <DrawingImage x:Key="FemIcon_Bars">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlue}" Geometry="M1.5,12.5 L12.5,1.5 L14.5,3.5 L3.5,14.5 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlueDark}" Geometry="M12.5,1.5 L14.5,3.5 L13.5,4.5 L11.5,2.5 Z"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Пластины (КонЭ): плита в аксонометрии. -->
   <DrawingImage x:Key="FemIcon_Shells">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlueLight}" Geometry="M0.5,8 L5.5,3.5 H15.5 L10.5,8 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconBlue}" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconBlue}" Geometry="M0.5,8 H10.5 V11 H0.5 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconBlueDark}" Geometry="M10.5,8 L15.5,3.5 V6.5 L10.5,11 Z"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

