               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconRed}" Thickness="1.3" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconRed}"
                             Geometry="M1,8 H5 L3,12 Z M6,8 H10 L8,12 Z M11,8 H15 L13,12 Z"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Набор усилий: таблица с красной шапкой. -->
