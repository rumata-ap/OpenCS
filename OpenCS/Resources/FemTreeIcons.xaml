      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Geometry="M3,3 H13 V13 H3 Z M8,3 V13 M3,8 H13">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconGrey}" Thickness="0.8"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource FemIconTeal}"
                             Geometry="M1.4,3 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 Z M6.4,3 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 Z M11.4,3 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 Z M1.4,8 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 Z M6.4,8 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 Z M11.4,8 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 Z M1.4,13 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 Z M6.4,13 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 Z M11.4,13 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 Z"/>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Элементы сетки: пластинчатый КЭ и примыкающий стержневой КЭ. -->
   <DrawingImage x:Key="FemIcon_MeshElements">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconTealLight}" Geometry="M1.5,6 H10 V14.5 H1.5 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconTeal}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M10,6 L14.5,1.5">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconTeal}" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="White"
                             Geometry="M0.3,6 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M8.8,6 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M0.3,14.5 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M8.8,14.5 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M13.3,1.5 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconTeal}" Thickness="1"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Стержневые КЭ сетки: отрезок между двумя узлами. -->
   <DrawingImage x:Key="FemIcon_MeshBars">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Geometry="M3,13 L13,3">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconTeal}" Thickness="1.8" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="White"
                             Geometry="M1,13 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z M11,3 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconTeal}" Thickness="1.3"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Пластинчатые КЭ сетки: четырёхугольник с узлами в углах. -->
   <DrawingImage x:Key="FemIcon_MeshShells">
      <DrawingImage.Drawing>
         <DrawingGroup ClipGeometry="M0,0 H16 V16 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
            <GeometryDrawing Brush="{StaticResource FemIconTealLight}" Geometry="M3,3 H13 V13 H3 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconTeal}" Thickness="1.4" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="White"
                             Geometry="M1.3,3 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0 Z M11.3,3 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0 Z M1.3,13 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0 Z M11.3,13 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0 Z">
               <GeometryDrawing.Pen><Pen Brush="{StaticResource FemIconTeal}" Thickness="1.2"/></GeometryDrawing.Pen>
            </GeometryDrawing>
         </DrawingGroup>
      </DrawingImage.Drawing>
   </DrawingImage>

   <!-- Группа КЭ: часть ячеек сетки выделена оранжевым. -->
